#
# lunac: a Luna compiler written in Luna. It reads one .lu file and writes C or LLVM IR
# that is built against compiler/runtime/luna_rt.c.
#
#   luna compiler/lunac.lu input.lu output.c      C
#   luna compiler/lunac.lu input.lu output.ll     LLVM IR (chosen by the .ll extension)
#
# The compiler is split into the modules next to this file. This one is the driver.
# Note for readers: these files must themselves be written in the subset lunac
# compiles, so identifiers such as data, from, in, input and print are never used
# as names, and a literal { inside a string is written \{.

use { read_file, split_lines } from "util.lu"
use { lex } from "lexer.lu"
use { parse_program } from "parser.lu"
use { compile_program } from "emit_c.lu"
use { compile_program_ll } from "emit_llvm.lu"
use { ST } from "state.lu"

# Name of a file without its directory and extension: "dir/prog.lu" is "prog".
func base_name(path) {
    let slash = last_index_of(path, "/")
    let name = slice(path, slash + 1, len(path))
    if (ends_with(name, ".lu")) {
        name = slice(name, 0, len(name) - 3)
    }
    return name
}

# The shell command that turns generated code into a binary. LUNA_HOME names the
# repository (default: the current directory); CC overrides the compiler.
func build_command(emit, code_path, out_path) {
    let home = "$\{LUNA_HOME:-.}"
    let rt = "{home}/compiler/runtime"
    let libs = "-L{home}/lib -lluna_data_rt -lluna_memory_rt -lm -lpthread -ldl"
    let srcs = "{rt}/luna_rt.c {rt}/luna_rt_data.c {rt}/luna_gc.c"
    if (emit == "llvm") {
        return "$\{CC:-clang} -O1 -w -I{rt} {code_path} {srcs} {rt}/luna_rt_ir.c {libs} -o {out_path}"
    }
    return "$\{CC:-gcc} -std=gnu11 -O1 -w -I{rt} {code_path} {srcs} {libs} -o {out_path}"
}

func usage() {
    print("usage: lunac input.lu -o program [--emit=llvm|c] [-S]")
    print("       lunac input.lu output.ll|output.c [cwd]")
    print("")
    print("  -o path        write the program here")
    print("  --emit=llvm|c  generated language, LLVM IR by default")
    print("  -S             stop after writing C/<name>.ll (or .c) and do not build")
    exit(1)
}

# lunac input.lu -o program [--emit=llvm|c] [-S]
func build_main(a) {
    let out_path = ""
    let emit = "llvm"
    let stop = false
    let i = 1
    while (i < len(a)) {
        if (a[i] == "-o" and i + 1 < len(a)) {
            out_path = a[i + 1]
            i += 2
        } else if (a[i] == "--emit=llvm") {
            emit = "llvm"
            i += 1
        } else if (a[i] == "--emit=c") {
            emit = "c"
            i += 1
        } else if (a[i] == "-S") {
            stop = true
            i += 1
        } else {
            usage()
        }
    }
    let name = base_name(a[0])
    if (out_path == "") {
        out_path = name
    }
    ST.src_file = a[0]
    let text = read_file(a[0])
    ST.src_lines = split_lines(text)
    let prog = parse_program(lex(text, 1))
    let code = ""
    let ext = ".c"
    if (emit == "llvm") {
        code = compile_program_ll(prog)
        ext = ".ll"
    } else {
        code = compile_program(prog)
    }
    system("mkdir -p C")
    let code_path = "C/{name}{ext}"
    let f = open(code_path, "w")
    write(f, code)
    close(f)
    if (stop) {
        print("[OK] wrote {code_path}")
        return null
    }
    let rc = system(build_command(emit, code_path, out_path))
    if (rc != 0) {
        print("[ERROR] build failed (exit {rc}); the generated code is in {code_path}")
        exit(1)
    }
    print("[OK] built {out_path} from {code_path}")
}

func main() {
    let a = args()
    if (len(a) < 1) {
        usage()
    }
    if (len(a) >= 2 and starts_with(a[1], "-")) {
        build_main(a)
        return null
    }
    ST.src_file = a[0]
    let text = read_file(a[0])
    ST.src_lines = split_lines(text)
    if (len(a) >= 3) {
        ST.cwd = a[2]
    }
    let prog = parse_program(lex(text, 1))
    let want_ll = len(a) >= 2 and ends_with(a[1], ".ll")
    let c_text = ""
    if (want_ll) {
        c_text = compile_program_ll(prog)
    } else {
        c_text = compile_program(prog)
    }
    if (len(a) >= 2) {
        let f = open(a[1], "w")
        write(f, c_text)
        close(f)
    } else {
        print(c_text)
    }
}
