#
# lunac: a Luna compiler written in Luna. It reads one .lu file and writes C
# that is built against compiler/runtime/luna_rt.c.
#
#   luna compiler/lunac.lu input.lu output.c
#
# Supports the whole language except the VM-only builtins (rand, vec_*,
# dense_list, shuffle, ssort, GUI), which the C runtime does not provide.
# Note for readers: this file must itself be written in the supported subset,
# so identifiers such as data, from, in, input and print are never used as names.

let SRC_FILE = ""
let SRC_LINES = []

func die(kind, line, msg) {
    print("{kind} in {SRC_FILE} at line {line}:\n  {msg}")
    exit(1)
}

# ---------------------------------------------------------------------------
# Lexer
# ---------------------------------------------------------------------------

let KEYWORDS = {
    "and": "and", "or": "or", "not": "not",
    "let": "let", "balls": "let", "big_balls": "let", "shared_balls": "let",
    "const": "const",
    "func": "func", "grab_balls": "func",
    "if": "if", "if_balls": "if", "else": "else", "else_balls": "else",
    "while": "while", "spin_balls": "while",
    "for": "for", "loop_your_balls": "for", "in": "in",
    "return": "return", "break": "break", "drop_balls": "break",
    "continue": "continue", "jiggle_balls": "continue",
    "switch": "switch", "switch_balls": "switch", "case": "case", "default": "default",
    "print": "print", "input": "input", "true": "true", "false": "false",
    "use": "use", "from": "from", "export": "export", "import": "import",
    "data": "data", "template": "template", "bloc": "bloc", "box": "box", "unsafe": "unsafe"
}

let TWO_CHAR = {
    "==": "==", "!=": "!=", "<=": "<=", ">=": ">=", "++": "++", "+=": "+=",
    "--": "--", "-=": "-=", "*=": "*=", "/=": "/=", "&&": "and", "||": "or"
}

let ONE_CHAR = {
    "=": "=", "+": "+", "-": "-", "*": "*", "/": "/", "%": "%", "<": "<", ">": ">",
    "(": "(", ")": ")", "{": "{", "}": "}", "[": "[", "]": "]", ",": ",", ".": ".",
    ":": ":", ";": ";", "!": "not"
}

func is_dig(c) {
    return c >= '0' and c <= '9'
}

func is_ident_start(c) {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'
}

func is_ident_char(c) {
    return is_ident_start(c) or is_dig(c)
}

func make_tok(t, v, line) {
    return {"t": t, "v": v, "line": line}
}

# Reads the string whose opening quote is at index i. Returns [parts, next_i,
# next_line]. A part is either a string or {"expr": source, "line": n}.
func lex_string(src, i, line) {
    let n = len(src)
    let pcs = []
    let start_line = line
    i += 1
    while (i < n and src[i] != '"') {
        let c = src[i]
        if (c == '\\') {
            i += 1
            if (i >= n) {
                break
            }
            let e = src[i]
            if (e == 'n') {
                append(pcs, "\n")
            } else if (e == 't') {
                append(pcs, "\t")
            } else if (e == 'r') {
                append(pcs, "\r")
            } else if (e == '{') {
                append(pcs, "<LB>")
            } else if (e == '}') {
                append(pcs, "<RB>")
            } else {
                append(pcs, "{e}")
            }
        } else {
            if (c == '\n') {
                line += 1
            }
            append(pcs, "{c}")
        }
        i += 1
    }
    if (i < n) {
        i += 1
    }

    let parts = []
    let cur = []
    let j = 0
    let m = len(pcs)
    while (j < m) {
        let p = pcs[j]
        if (p == "<LB>") {
            append(cur, "\{")
        } else if (p == "<RB>") {
            append(cur, "\}")
        } else if (p == "\{" and j + 1 < m and pcs[j + 1] != "\}") {
            let depth = 1
            let k = j + 1
            let ex = []
            while (k < m) {
                let q = pcs[k]
                if (q == "\{") {
                    depth += 1
                } else if (q == "\}") {
                    depth -= 1
                    if (depth == 0) {
                        break
                    }
                }
                if (q == "<LB>") {
                    append(ex, "\{")
                } else if (q == "<RB>") {
                    append(ex, "\}")
                } else {
                    append(ex, q)
                }
                k += 1
            }
            if (k >= m) {
                die("Syntax Error", start_line, "Unclosed string interpolation expression")
            }
            if (len(cur) > 0) {
                append(parts, join(cur, ""))
                cur = []
            }
            append(parts, {"expr": join(ex, ""), "line": start_line})
            j = k
        } else {
            append(cur, p)
        }
        j += 1
    }
    if (len(cur) > 0 or len(parts) == 0) {
        append(parts, join(cur, ""))
    }
    return [parts, i, line]
}

func lex(src, first_line) {
    let toks = []
    let n = len(src)
    let i = 0
    let line = first_line
    while (i < n) {
        let c = src[i]
        if (c == '\n') {
            append(toks, make_tok("nl", null, line))
            line += 1
            i += 1
        } else if (c == ' ' or c == '\t' or int(c) == 13) {
            i += 1
        } else if (c == '#' or (c == '/' and i + 1 < n and src[i + 1] == '/')) {
            while (i < n and src[i] != '\n') {
                i += 1
            }
        } else if (c == '"') {
            let start_line = line
            let r = lex_string(src, i, line)
            append(toks, make_tok("str", r[0], start_line))
            i = r[1]
            line = r[2]
        } else if (c == '\'') {
            i += 1
            let code = 0
            if (i < n) {
                code = int(src[i])
            }
            if (i < n and src[i] == '\\') {
                i += 1
                let e = src[i]
                if (e == 'n') {
                    code = 10
                } else if (e == 't') {
                    code = 9
                } else if (e == '0') {
                    code = 0
                } else {
                    code = int(e)
                }
            }
            i += 1
            if (i < n and src[i] == '\'') {
                i += 1
            }
            append(toks, make_tok("char", code, line))
        } else if (is_dig(c)) {
            let s = i
            while (i < n and is_dig(src[i])) {
                i += 1
            }
            let is_float = false
            if (i + 1 < n and src[i] == '.' and is_dig(src[i + 1])) {
                is_float = true
                i += 1
                while (i < n and is_dig(src[i])) {
                    i += 1
                }
            }
            if (is_float) {
                append(toks, make_tok("float", slice(src, s, i), line))
            } else {
                append(toks, make_tok("num", slice(src, s, i), line))
            }
        } else if (is_ident_start(c)) {
            let s = i
            while (i < n and is_ident_char(src[i])) {
                i += 1
            }
            let word = slice(src, s, i)
            let kw = KEYWORDS[word]
            if (kw != null) {
                append(toks, make_tok(kw, word, line))
            } else {
                append(toks, make_tok("id", word, line))
            }
        } else {
            let two = ""
            if (i + 1 < n) {
                two = slice(src, i, i + 2)
            }
            let one = "{c}"
            if (TWO_CHAR[two] != null) {
                append(toks, make_tok(TWO_CHAR[two], two, line))
                i += 2
            } else if (ONE_CHAR[one] != null) {
                append(toks, make_tok(ONE_CHAR[one], one, line))
                i += 1
            } else {
                append(toks, make_tok("id", one, line))
                i += 1
            }
        }
    }
    append(toks, make_tok("eof", null, line))
    return toks
}

# ---------------------------------------------------------------------------
# Parser
# ---------------------------------------------------------------------------

let P_toks = []
let P_pos = 0

func p_tok() {
    return P_toks[P_pos]
}

func p_at(t) {
    return P_toks[P_pos].t == t
}

func p_next() {
    let tk = P_toks[P_pos]
    if (P_pos < len(P_toks) - 1) {
        P_pos += 1
    }
    return tk
}

func p_eat(t) {
    if (P_toks[P_pos].t == t) {
        p_next()
        return true
    }
    return false
}

func p_skip_nl() {
    while (P_toks[P_pos].t == "nl") {
        p_next()
    }
}

func p_fail(msg) {
    die("Syntax Error", P_toks[P_pos].line, msg)
}

func p_expect(t, msg) {
    if (P_toks[P_pos].t != t) {
        p_fail(msg)
    }
    return p_next()
}

func node(k, line) {
    return {"k": k, "line": line}
}

# Parses source text with its own token stream, then restores the parser.
func parse_inline(text, line) {
    let saved_toks = P_toks
    let saved_pos = P_pos
    P_toks = lex(text, line)
    P_pos = 0
    let e = p_expr()
    p_skip_nl()
    if (not p_at("eof")) {
        p_fail("Invalid expression inside string interpolation")
    }
    P_toks = saved_toks
    P_pos = saved_pos
    return e
}

func p_string(tk) {
    let parts = tk.v
    let has_expr = false
    for (let part in parts) {
        if (type(part) == "map") {
            has_expr = true
        }
    }
    if (not has_expr) {
        let s = node("str", tk.line)
        s.v = parts[0]
        return s
    }
    let t = node("tmpl", tk.line)
    let items = []
    for (let part in parts) {
        if (type(part) == "map") {
            append(items, parse_inline(part.expr, part.line))
        } else {
            append(items, part)
        }
    }
    t.parts = items
    return t
}

func p_list_literal(line) {
    let items = []
    p_skip_nl()
    if (not p_at("]")) {
        let more = true
        while (more) {
            p_skip_nl()
            append(items, p_expr())
            p_skip_nl()
            more = p_eat(",")
        }
    }
    p_skip_nl()
    p_expect("]", "Expected ']' at end of list")
    let n = node("list", line)
    n.items = items
    return n
}

func p_map_literal(line) {
    let keys = []
    let vals = []
    p_skip_nl()
    if (not p_at("}")) {
        let more = true
        while (more) {
            p_skip_nl()
            if (not p_at("str")) {
                p_fail("Map literal keys must be strings")
            }
            let kt = p_next()
            if (len(kt.v) != 1 or type(kt.v[0]) != "string") {
                p_fail("Map literal keys must be plain strings")
            }
            append(keys, kt.v[0])
            p_expect(":", "Expected ':' after map key")
            append(vals, p_expr())
            p_skip_nl()
            more = p_eat(",")
        }
    }
    p_skip_nl()
    p_expect("}", "Expected '}' at end of map literal")
    let n = node("map", line)
    n.keys = keys
    n.vals = vals
    return n
}

func p_func_rest(name, line, is_export) {
    p_expect("(", "Expected '('")
    let params = []
    let defaults = []
    if (not p_at(")")) {
        let more = true
        while (more) {
            if (not p_at("id")) {
                p_fail("Expected parameter name")
            }
            append(params, p_next().v)
            if (p_eat("=")) {
                append(defaults, p_expr())
            } else {
                append(defaults, null)
            }
            more = p_eat(",")
        }
    }
    p_expect(")", "Expected ')'")
    p_expect("{", "Expected '\{'")
    let n = node("func", line)
    n.name = name
    n.params = params
    n.defaults = defaults
    n.body = p_block()
    n.exported = is_export
    return n
}

func p_primary() {
    let tk = p_tok()
    let line = tk.line
    let t = tk.t
    if (t == "num") {
        p_next()
        let n = node("num", line)
        n.v = tk.v
        return n
    }
    if (t == "float") {
        p_next()
        let n = node("float", line)
        n.v = tk.v
        return n
    }
    if (t == "str") {
        p_next()
        return p_string(tk)
    }
    if (t == "char") {
        p_next()
        let n = node("char", line)
        n.v = tk.v
        return n
    }
    if (t == "true" or t == "false") {
        p_next()
        let n = node("bool", line)
        n.v = t == "true"
        return n
    }
    if (t == "id") {
        p_next()
        let n = node("id", line)
        n.name = tk.v
        return n
    }
    if (t == "(") {
        p_next()
        let e = p_expr()
        p_expect(")", "Expected ')' after expression")
        return e
    }
    if (t == "[") {
        p_next()
        return p_list_literal(line)
    }
    if (t == "{") {
        p_next()
        return p_map_literal(line)
    }
    if (t == "func") {
        p_next()
        return p_func_rest(null, line, false)
    }
    if (t == "input") {
        p_next()
        p_expect("(", "Expected '(' after input")
        let n = node("input", line)
        n.prompt = null
        if (not p_at(")")) {
            if (not p_at("str")) {
                p_fail("Expected string prompt for input")
            }
            n.prompt = p_next().v
        }
        p_expect(")", "Expected ')' after input")
        return n
    }
    if (t == "box") {
        p_next()
        p_expect("[", "Expected '[' after 'box'")
        let n = node("box", line)
        n.size = p_expr()
        p_expect("]", "Expected ']' after box size")
        return n
    }
    if (t == ";") {
        p_fail("Unexpected semicolon ';'")
    }
    p_fail("Unexpected token '{t}': expected an expression")
}

func p_postfix() {
    let line = p_tok().line
    let e = p_primary()
    while (true) {
        if (p_at("(")) {
            p_next()
            let args = []
            if (not p_at(")")) {
                let more = true
                while (more) {
                    append(args, p_expr())
                    more = p_eat(",")
                }
            }
            p_expect(")", "Expected ')' after arguments")
            let c = node("call", line)
            c.callee = e
            c.args = args
            e = c
        } else if (p_at("\{") and e.k == "id") {
            p_next()
            let args = []
            p_skip_nl()
            if (not p_at("}")) {
                let more = true
                while (more) {
                    p_skip_nl()
                    append(args, p_expr())
                    p_skip_nl()
                    more = p_eat(",")
                }
            }
            p_expect("}", "Expected '}' after typed constructor arguments")
            let c = node("call", line)
            c.callee = e
            c.args = args
            e = c
        } else if (p_at("[")) {
            p_next()
            let idx = p_expr()
            p_expect("]", "Expected ']' after index")
            let n = node("index", line)
            n.target = e
            n.index = idx
            e = n
        } else if (p_at(".")) {
            p_next()
            if (not p_at("id")) {
                p_fail("Expected field name after '.'")
            }
            let n = node("field", line)
            n.target = e
            n.field = p_next().v
            e = n
        } else if (p_at("++") or p_at("--")) {
            let op = p_next().t
            if (e.k != "id") {
                p_fail("'{op}' can only be applied to variables")
            }
            let n = node("incdec", line)
            n.name = e.name
            n.op = op
            e = n
        } else {
            break
        }
    }
    return e
}

func p_unary() {
    let line = p_tok().line
    if (p_eat("not")) {
        let n = node("not", line)
        n.e = p_unary()
        return n
    }
    if (p_eat("-")) {
        let r = p_unary()
        if (r.k == "num") {
            r.v = "-{r.v}"
            return r
        }
        if (r.k == "float") {
            r.v = "-{r.v}"
            return r
        }
        let n = node("bin", line)
        n.op = "-"
        n.l = node("num", line)
        n.l.v = "0"
        n.r = r
        return n
    }
    if (p_eat("+")) {
        return p_unary()
    }
    return p_postfix()
}

func p_binary_level(sub, ops) {
    let line = p_tok().line
    let e = sub()
    while (has_op(ops, p_tok().t)) {
        let op = p_next().t
        let r = sub()
        let n = node("bin", line)
        n.op = op
        n.l = e
        n.r = r
        e = n
    }
    return e
}

func has_op(ops, t) {
    for (let o in ops) {
        if (o == t) {
            return true
        }
    }
    return false
}

func p_mul() {
    return p_binary_level(p_unary, ["*", "/", "%"])
}

func p_add() {
    return p_binary_level(p_mul, ["+", "-"])
}

func p_cmp() {
    return p_binary_level(p_add, ["<", ">", "<=", ">="])
}

func p_eq() {
    return p_binary_level(p_cmp, ["==", "!="])
}

func p_and() {
    return p_binary_level(p_eq, ["and"])
}

func p_expr() {
    return p_binary_level(p_and, ["or"])
}

# Statements ---------------------------------------------------------------

func p_block() {
    let stmts = []
    while (not p_at("}") and not p_at("eof")) {
        if (p_eat("nl")) {
            continue
        }
        append(stmts, p_statement())
    }
    p_expect("}", "Expected '}'")
    return stmts
}

func p_declaration(is_const, is_export) {
    let line = p_tok().line
    let names = []
    let more = true
    while (more) {
        if (not p_at("id")) {
            p_fail("Expected variable name after 'let' or ','")
        }
        append(names, p_next().v)
        more = p_eat(",")
    }
    let vals = []
    if (p_eat("=")) {
        more = true
        while (more) {
            append(vals, p_expr())
            more = p_eat(",")
        }
    }
    if (is_const and len(vals) != len(names)) {
        p_fail("const declarations require an initializer for every name")
    }
    if (len(vals) > 0 and len(vals) != len(names)) {
        p_fail("Variable count ({len(names)}) does not match value count ({len(vals)})")
    }
    let lets = []
    for (let i = 0; i < len(names); i++) {
        let n = node("let", line)
        n.name = names[i]
        n.init = null
        if (len(vals) > 0) {
            n.init = vals[i]
        }
        n.exported = is_export
        append(lets, n)
    }
    if (len(lets) == 1) {
        return lets[0]
    }
    let g = node("group", line)
    g.items = lets
    return g
}

func p_cond_paren(what) {
    p_expect("(", "Expected '(' after {what}")
    let c = p_expr()
    p_expect(")", "Expected ')' after condition")
    return c
}

func p_if(line) {
    let cond = p_cond_paren("if")
    p_eat("nl")
    p_expect("{", "Expected '\{'")
    let n = node("if", line)
    n.cond = cond
    n.then = p_block()
    n.els = []
    p_eat("nl")
    if (p_eat("else")) {
        p_eat("nl")
        if (p_at("if")) {
            n.els = [p_statement()]
        } else {
            p_expect("{", "Expected '\{'")
            n.els = p_block()
        }
    }
    return n
}

func p_for(line) {
    p_expect("(", "Expected '(' after for")
    if (p_at("let")) {
        p_next()
        if (not p_at("id")) {
            p_fail("Expected loop variable name in for loop")
        }
        let name = p_next().v
        if (p_eat("in")) {
            let iter = p_expr()
            p_expect(")", "Expected ')' after for-in iterable")
            p_eat("nl")
            p_expect("{", "Expected '\{' for loop body")
            let n = node("forin", line)
            n.name = name
            n.iter = iter
            n.body = p_block()
            return n
        }
        let init = node("let", line)
        init.name = name
        init.init = null
        init.exported = false
        if (p_eat("=")) {
            init.init = p_expr()
        }
        return p_for_rest(line, init)
    }
    return p_for_rest(line, p_statement())
}

func p_for_rest(line, init) {
    p_expect(";", "Expected ';' after loop initializer")
    let cond = p_expr()
    p_expect(";", "Expected ';' after loop condition")
    let incr = p_statement()
    p_expect(")", "Expected ')' after loop increment")
    p_eat("nl")
    p_expect("{", "Expected '\{' for loop body")
    let n = node("for", line)
    n.init = init
    n.cond = cond
    n.incr = incr
    n.body = p_block()
    return n
}

func p_switch(line) {
    p_expect("(", "Expected '(' after switch")
    let e = p_expr()
    p_expect(")", "Expected ')'")
    p_expect("{", "Expected '\{' starting switch block")
    let cases = []
    let dflt = []
    while (not p_at("}") and not p_at("eof")) {
        let cline = p_tok().line
        if (p_eat("case")) {
            let v = p_expr()
            p_expect(":", "Expected ':' after case value")
            let body = p_case_body()
            append(cases, {"value": v, "body": body, "line": cline})
        } else if (p_eat("default")) {
            p_expect(":", "Expected ':' after default")
            dflt = p_case_body()
        } else if (p_eat("nl")) {
            continue
        } else {
            p_fail("Expected 'case' or 'default' inside switch")
        }
    }
    p_expect("}", "Expected '}' ending switch")
    let n = node("switch", line)
    n.e = e
    n.cases = cases
    n.dflt = dflt
    return n
}

func p_case_body() {
    let body = []
    while (not p_at("case") and not p_at("default") and not p_at("}")) {
        if (p_eat("nl")) {
            continue
        }
        append(body, p_statement())
    }
    return body
}

func compound_op(t) {
    if (t == "+=") {
        return "+"
    }
    if (t == "-=") {
        return "-"
    }
    if (t == "*=") {
        return "*"
    }
    if (t == "/=") {
        return "/"
    }
    return null
}

func p_simple(line) {
    let e = p_expr()
    if (p_eat("=")) {
        let v = p_expr()
        if (e.k == "id") {
            let n = node("assign", line)
            n.name = e.name
            n.e = v
            return n
        }
        return make_setidx(e, v, null, line)
    }
    let op = compound_op(p_tok().t)
    if (op != null) {
        p_next()
        let rhs = p_expr()
        if (e.k == "id") {
            let b = node("bin", line)
            b.op = op
            b.l = e
            b.r = rhs
            let n = node("assign", line)
            n.name = e.name
            n.e = b
            return n
        }
        return make_setidx(e, rhs, op, line)
    }
    return e
}

# target[index] = value  /  target.field = value, with an optional compound op.
func make_setidx(e, v, op, line) {
    let n = node("setidx", line)
    if (e.k == "index") {
        n.target = e.target
        n.index = e.index
    } else if (e.k == "field") {
        n.target = e.target
        n.index = node("str", line)
        n.index.v = e.field
    } else {
        p_fail("Invalid assignment target")
    }
    n.e = v
    n.op = op
    return n
}

func p_typedef(line, word) {
    if (not p_at("id")) {
        p_fail("Expected a name after '{word}'")
    }
    let n = node("typedef", line)
    n.name = p_next().v
    n.is_template = word == "template"
    n.is_bloc = word == "bloc"
    n.fields = []
    p_expect("\{", "Expected '\{' after type name")
    while (not p_at("}") and not p_at("eof")) {
        p_skip_nl()
        if (not p_at("id")) {
            p_fail("Expected field name in {word} declaration")
        }
        append(n.fields, p_next().v)
        p_skip_nl()
        if (not p_eat(",")) {
            break
        }
    }
    p_expect("}", "Expected '}' after {word} fields")
    return n
}

func p_use(line, word) {
    let n = node("use", line)
    n.names = []
    if (word == "use" and p_at("\{")) {
        p_next()
        while (not p_at("}") and not p_at("eof")) {
            if (not p_at("id")) {
                p_fail("Expected exported name inside use list")
            }
            append(n.names, p_next().v)
            if (not p_eat(",")) {
                break
            }
        }
        p_expect("}", "Expected '}' after use list")
        p_expect("from", "Expected 'from' after use list")
    }
    if (not p_at("str")) {
        p_fail("Expected string path after {word}")
    }
    n.path = p_next().v[0]
    return n
}

func p_statement() {
    let tk = p_tok()
    let line = tk.line
    let t = tk.t
    if (t == "func") {
        p_next()
        if (not p_at("id")) {
            p_fail("Expected function name after 'func'")
        }
        let name = p_next().v
        return p_func_rest(name, line, false)
    }
    if (t == "let" or t == "const") {
        p_next()
        return p_declaration(t == "const", false)
    }
    if (t == "export") {
        p_next()
        if (p_at("let") or p_at("const")) {
            let is_const = p_at("const")
            p_next()
            return p_declaration(is_const, true)
        }
        if (p_at("func")) {
            p_next()
            let name = p_next().v
            return p_func_rest(name, line, true)
        }
        if (p_at("data") or p_at("template") or p_at("bloc")) {
            let word = p_next().t
            return p_typedef(line, word)
        }
        p_fail("export can only be used with let, const, func, data or bloc declarations")
    }
    if (t == "use" or t == "import") {
        p_next()
        return p_use(line, t)
    }
    if (t == "data" or t == "template" or t == "bloc") {
        p_next()
        return p_typedef(line, t)
    }
    if (t == "unsafe") {
        p_next()
        p_eat("nl")
        p_expect("\{", "Expected '\{' after unsafe")
        let n = node("unsafe", line)
        n.body = p_block()
        return n
    }
    if (t == "print") {
        p_next()
        p_expect("(", "Expected '(' after print")
        let args = []
        if (not p_at(")")) {
            let more = true
            while (more) {
                append(args, p_expr())
                more = p_eat(",")
            }
        }
        p_expect(")", "Expected ')' after print args")
        let n = node("print", line)
        n.args = args
        return n
    }
    if (t == "return") {
        p_next()
        let n = node("return", line)
        n.e = null
        if (not p_at("}") and not p_at("nl") and not p_at("eof")) {
            n.e = p_expr()
        }
        return n
    }
    if (t == "break") {
        p_next()
        return node("break", line)
    }
    if (t == "continue") {
        p_next()
        return node("continue", line)
    }
    if (t == "if") {
        p_next()
        return p_if(line)
    }
    if (t == "while") {
        p_next()
        let cond = p_cond_paren("while")
        p_eat("nl")
        p_expect("{", "Expected '\{'")
        let n = node("while", line)
        n.cond = cond
        n.body = p_block()
        return n
    }
    if (t == "for") {
        p_next()
        return p_for(line)
    }
    if (t == "switch") {
        p_next()
        return p_switch(line)
    }
    return p_simple(line)
}

func parse_program(toks) {
    P_toks = toks
    P_pos = 0
    let stmts = []
    while (not p_at("eof")) {
        if (p_eat("nl")) {
            continue
        }
        append(stmts, p_statement())
    }
    return stmts
}

# ---------------------------------------------------------------------------
# Code generator
#
# Every Luna expression becomes a C expression over LV values. Sub-expressions
# are hoisted into temporaries so the order of evaluation is exactly the
# order of the source (C leaves argument order unspecified).
# ---------------------------------------------------------------------------

let BUILTINS = {}
for (let nm in split("len str_len append list_append type int float to_string to_int to_float assert input debug range args exit system clock map_set map_get map_has map_delete map_keys map_values map_items remove find slice sort map filter reduce is_empty concat substring char_at index_of last_index_of contains starts_with ends_with to_upper to_lower trim trim_left trim_right replace reverse repeat pad_left pad_right format split join is_digit is_alpha is_alnum is_space abs min max clamp sign pow sqrt cbrt exp ln log10 sin cos tan asin acos atan atan2 sinh cosh tanh floor ceil round trunc fract mod lerp deg_to_rad rad_to_deg open close read read_line write file_exists remove_file flush alloc free load deref store ptr_offset ptr_add defer dense_list vec_add vec_sub vec_mul vec_div vec_mul_inline mat_mul rand srand trand shuffle ssort shape", " ")) {
    BUILTINS[nm] = true
}

let BINOPS = {
    "+": "lv_add_fast", "-": "lv_sub_fast", "*": "lv_mul_fast", "/": "lv_div", "%": "lv_mod",
    "==": "lv_eq_fast", "!=": "lv_ne_fast", "<": "lv_lt_fast", "<=": "lv_le_fast",
    ">": "lv_gt_fast", ">=": "lv_ge_fast"
}

let CTX = null
let MOD = null
let MODULES = {}
let MOD_LIST = []
let CWD = ""
let GLOBAL_DECLS = []
let MOD_DECLS = []
let MOD_BODIES = []
let FN_BODIES = []
let FN_DECLS = []
let CONSTS = []
let CONST_IDS = {}
let USED_BUILTINS = {}
let USED_ORDER = []
let UID = 0

func uid() {
    UID += 1
    return UID
}

func new_ctx(is_main) {
    return {"out": [], "scopes": [{}], "defers": [[]], "nested": {}, "capmap": {},
            "is_main": is_main, "line": -1, "loops": []}
}

func gname(name) {
    return "{MOD.prefix}{name}"
}

func emit(text) {
    append(CTX.out, text)
}

func emit_tmp(expr) {
    let t = "t{uid()}"
    emit("LV {t} = {expr};")
    return t
}

func mark(line) {
    if (CTX.line != line) {
        emit("lv_pos_line = {line};")
        CTX.line = line
    }
}

func c_escape(text) {
    let parts = []
    for (let ch in text) {
        let code = int(ch)
        if (code < 0) {
            code += 256
        }
        if (ch == '"') {
            append(parts, "\\\"")
        } else if (ch == '\\') {
            append(parts, "\\\\")
        } else if (ch == '\n') {
            append(parts, "\\n")
        } else if (ch == '\t') {
            append(parts, "\\t")
        } else if (ch == '?') {
            append(parts, "\\?")
        } else if (code < 32 or code > 126) {
            let a = (code / 64) % 8
            let b = (code / 8) % 8
            let c = code % 8
            append(parts, "\\{a}{b}{c}")
        } else {
            append(parts, "{ch}")
        }
    }
    return join(parts, "")
}

func kstr(text) {
    let key = "s{text}"
    let idx = CONST_IDS[key]
    if (idx == null) {
        idx = len(CONSTS)
        append(CONSTS, "K[{idx}] = lv_str_n(\"{c_escape(text)}\", {len(text)});")
        CONST_IDS[key] = idx
    }
    return "K[{idx}]"
}

func use_builtin(name) {
    if (USED_BUILTINS[name] == null) {
        USED_BUILTINS[name] = true
        append(USED_ORDER, name)
    }
}

func reg_global(name) {
    if (MOD.globals[name] == null) {
        MOD.globals[name] = true
        append(GLOBAL_DECLS, "static LV {gname(name)} = \{.tag = LV_UNDEF};")
    }
}

# Names -----------------------------------------------------------------

# Every name read or written anywhere inside x (in order of first use).
func walk_names(x, seen, order) {
    if (type(x) == "list") {
        for (let y in x) {
            walk_names(y, seen, order)
        }
        return null
    }
    if (type(x) != "map") {
        return null
    }
    let k = x.k
    if (k == "id" or k == "assign" or k == "incdec") {
        if (seen[x.name] == null) {
            seen[x.name] = true
            append(order, x.name)
        }
    }
    for (let y in map_values(x)) {
        if (type(y) == "list" or type(y) == "map") {
            walk_names(y, seen, order)
        }
    }
    return null
}

func used_names(fn_node) {
    let order = []
    walk_names(fn_node, {}, order)
    return order
}

# Names used inside any function literal nested within x.
func walk_nested(x, out) {
    if (type(x) == "list") {
        for (let y in x) {
            walk_nested(y, out)
        }
        return null
    }
    if (type(x) != "map") {
        return null
    }
    if (x.k == "func") {
        let order = []
        walk_names(x, out, order)
        return null
    }
    for (let y in map_values(x)) {
        if (type(y) == "list" or type(y) == "map") {
            walk_nested(y, out)
        }
    }
    return null
}

# Scopes ----------------------------------------------------------------

func push_scope() {
    append(CTX.scopes, {})
    append(CTX.defers, [])
}

# Emits the deferred calls of every scope from index `from_depth` inward, innermost first.
func run_defers(from_depth) {
    let i = len(CTX.defers) - 1
    while (i >= from_depth) {
        let list = CTX.defers[i]
        let j = len(list) - 1
        while (j >= 0) {
            let d = list[j]
            if (d.kind == "boxes") {
                emit("lv_box_release_scope({d.id});")
            } else if (d.kind == "unsafe") {
                emit("lv_unsafe_end();")
            } else {
                emit("lv_call({d.f}, {len(d.args)}, {args_array(d.args)});")
            }
            j -= 1
        }
        i -= 1
    }
}

func pop_scope() {
    run_defers(len(CTX.defers) - 1)
    remove(CTX.scopes, len(CTX.scopes) - 1)
    remove(CTX.defers, len(CTX.defers) - 1)
}

func at_top() {
    return CTX.is_main and len(CTX.scopes) == 1
}

func declare(name, init_expr) {
    let id = uid()
    let is_cell = CTX.nested[name] != null
    let v = {"name": name, "cell": is_cell, "c": ""}
    if (is_cell) {
        v.c = "c_{name}_{id}"
        emit("LV *{v.c} = lv_cell({init_expr});")
    } else {
        v.c = "v_{name}_{id}"
        emit("LV {v.c} = {init_expr};")
    }
    CTX.scopes[len(CTX.scopes) - 1][name] = v
    return v
}

func var_get(v) {
    if (v.cell) {
        return emit_tmp("*{v.c}")
    }
    return v.c
}

func var_set(v, expr) {
    if (v.cell) {
        emit("*{v.c} = {expr};")
    } else {
        emit("{v.c} = {expr};")
    }
}

func find_local(name) {
    let i = len(CTX.scopes) - 1
    while (i >= 0) {
        let v = CTX.scopes[i][name]
        if (v != null) {
            return v
        }
        i -= 1
    }
    return null
}

func resolve(name) {
    let v = find_local(name)
    if (v != null) {
        return {"kind": "local", "v": v}
    }
    let ci = CTX.capmap[name]
    if (ci != null) {
        return {"kind": "cap", "i": ci}
    }
    if (MOD.globals[name] != null) {
        return {"kind": "global"}
    }
    if (name == "null") {
        return {"kind": "null"}
    }
    if (BUILTINS[name] != null) {
        return {"kind": "builtin"}
    }
    return {"kind": "global"}
}

# Expressions -----------------------------------------------------------

func args_array(items) {
    if (len(items) == 0) {
        return "NULL"
    }
    let body = join(items, ", ")
    return "(LV[])\{{body}\}"
}

func ex_list(nodes) {
    let res = []
    for (let n in nodes) {
        append(res, ex(n))
    }
    return res
}

func ex_id(n) {
    let r = resolve(n.name)
    if (r.kind == "local") {
        return var_get(r.v)
    }
    if (r.kind == "cap") {
        return emit_tmp("*self->cells[{r.i}]")
    }
    if (r.kind == "null") {
        return "lv_null()"
    }
    if (r.kind == "builtin") {
        return emit_tmp("lv_native(lb_{n.name}, \"{n.name}\")")
    }
    reg_global(n.name)
    mark(n.line)
    return emit_tmp("lv_gget({gname(n.name)}, \"{n.name}\")")
}

func ex_call(n) {
    mark(n.line)
    let callee = n.callee
    if (callee.k == "id") {
        if (callee.name == "defer" and len(n.args) == 1 and n.args[0].k == "call") {
            return ex_defer(n)
        }
        if ((callee.name == "address_of" or callee.name == "addr") and resolve(callee.name).kind != "local") {
            return ex_address_of(n)
        }
        if (callee.name == "append" and len(n.args) == 2 and resolve("append").kind == "builtin") {
            let argv = ex_list(n.args)
            emit("lv_container_check({argv[1]});")
            use_builtin("append")
            mark(n.line)
            return emit_tmp("lb_append(&nf_append, 2, {args_array(argv)})")
        }
        let r = resolve(callee.name)
        if (r.kind == "builtin") {
            let argv = ex_list(n.args)
            use_builtin(callee.name)
            mark(n.line)
            return emit_tmp("lb_{callee.name}(&nf_{callee.name}, {len(argv)}, {args_array(argv)})")
        }
    }
    let f = ex(callee)
    let argv = ex_list(n.args)
    mark(n.line)
    return emit_tmp("lv_call({f}, {len(argv)}, {args_array(argv)})")
}

# address_of(name): a pointer to the variable's own storage.
func ex_address_of(n) {
    if (len(n.args) == 1 and n.args[0].k == "id") {
        let name = n.args[0].name
        let r = resolve(name)
        mark(n.line)
        if (r.kind == "local") {
            if (r.v.cell) {
                return emit_tmp("lv_addr({r.v.c})")
            }
            return emit_tmp("lv_addr(&{r.v.c})")
        }
        if (r.kind == "cap") {
            return emit_tmp("lv_addr(self->cells[{r.i}])")
        }
        if (r.kind == "global") {
            reg_global(name)
            return emit_tmp("lv_addr(&{gname(name)})")
        }
    }
    mark(n.line)
    return emit_tmp("lv_addr_invalid({len(n.args)})")
}

# defer(f(args)): the callee and arguments are captured now and called when the scope exits.
func ex_defer(n) {
    if (len(n.args) != 1 or n.args[0].k != "call") {
        die("Compile Error", n.line, "defer expects a call, like defer(close(f))")
    }
    let inner = n.args[0]
    let f = emit_tmp(ex(inner.callee))
    let saved = []
    for (let a in ex_list(inner.args)) {
        append(saved, emit_tmp(a))
    }
    append(CTX.defers[len(CTX.defers) - 1], {"kind": "call", "f": f, "args": saved})
    return "lv_null()"
}

func ex_bin(n) {
    if (n.op == "and" or n.op == "or") {
        let a = ex(n.l)
        mark(n.line)
        let t = emit_tmp(a)
        if (n.op == "and") {
            emit("if (lv_truth({t})) \{")
        } else {
            emit("if (!lv_truth({t})) \{")
        }
        CTX.line = -1
        let b = ex(n.r)
        emit("{t} = {b};")
        emit("}")
        CTX.line = -1
        return t
    }
    let a = ex(n.l)
    let b = ex(n.r)
    mark(n.line)
    return emit_tmp("{BINOPS[n.op]}({a}, {b})")
}

func ex_incdec(n) {
    mark(n.line)
    let fn_name = "lv_add_fast"
    if (n.op == "--") {
        fn_name = "lv_sub_fast"
    }
    let cur = ex_id(n)
    let t = emit_tmp("{fn_name}({cur}, lv_int(1))")
    store_name(n.name, t)
    return t
}

func ex_tmpl(n) {
    let items = []
    for (let part in n.parts) {
        if (type(part) == "string") {
            if (len(part) > 0) {
                append(items, kstr(part))
            }
        } else {
            append(items, ex(part))
        }
    }
    mark(n.line)
    return emit_tmp("lv_interp({len(items)}, {args_array(items)})")
}

func ex(n) {
    let k = n.k
    if (k == "num") {
        return "lv_int(INT64_C({n.v}))"
    }
    if (k == "float") {
        return "lv_float({n.v})"
    }
    if (k == "str") {
        return kstr(n.v)
    }
    if (k == "char") {
        return "lv_char((char){n.v})"
    }
    if (k == "bool") {
        if (n.v) {
            return "lv_bool(1)"
        }
        return "lv_bool(0)"
    }
    if (k == "id") {
        return ex_id(n)
    }
    if (k == "tmpl") {
        return ex_tmpl(n)
    }
    if (k == "bin") {
        return ex_bin(n)
    }
    if (k == "not") {
        let a = ex(n.e)
        mark(n.line)
        return emit_tmp("lv_not({a})")
    }
    if (k == "call") {
        return ex_call(n)
    }
    if (k == "index") {
        let t = ex(n.target)
        let i = ex(n.index)
        mark(n.line)
        return emit_tmp("lv_index({t}, {i})")
    }
    if (k == "field") {
        let t = ex(n.target)
        mark(n.line)
        return emit_tmp("lv_field({t}, {kstr(n.field)})")
    }
    if (k == "list") {
        let items = ex_list(n.items)
        if (len(items) == 0) {
            return emit_tmp("lv_list_new(0)")
        }
        for (let it in items) {
            emit("lv_container_check({it});")
        }
        return emit_tmp("lv_list_of({len(items)}, {args_array(items)})")
    }
    if (k == "map") {
        let t = emit_tmp("lv_map_new()")
        for (let i = 0; i < len(n.keys); i++) {
            let v = ex(n.vals[i])
            emit("lv_container_check({v});")
            emit("lv_map_put({t}, {kstr(n.keys[i])}.s, {v});")
        }
        return t
    }
    if (k == "func") {
        return compile_function(n)
    }
    if (k == "incdec") {
        return ex_incdec(n)
    }
    if (k == "box") {
        let size = ex(n.size)
        mark(n.line)
        return emit_tmp("lv_box_new({size}, {box_scope_id()})")
    }
    if (k == "input") {
        mark(n.line)
        use_builtin("input")
        if (n.prompt == null) {
            return emit_tmp("lb_input(&nf_input, 0, NULL)")
        }
        let prompt = p_prompt_text(n.prompt)
        return emit_tmp("lb_input(&nf_input, 1, {args_array([kstr(prompt)])})")
    }
    die("Compile Error", n.line, "cannot compile expression of kind '{k}'")
}

func p_prompt_text(parts) {
    let pieces = []
    for (let part in parts) {
        if (type(part) == "string") {
            append(pieces, part)
        }
    }
    return join(pieces, "")
}

# The id that ties a box to the scope it was created in; 0 at the top level,
# where boxes live until freed.
func box_scope_id() {
    if (CTX.is_main and len(CTX.scopes) == 1) {
        return "0"
    }
    let top = len(CTX.defers) - 1
    for (let d in CTX.defers[top]) {
        if (d.kind == "boxes") {
            return d.id
        }
    }
    let id = "bs{uid()}"
    emit("uint64_t {id} = lv_scope_new();")
    append(CTX.defers[top], {"kind": "boxes", "id": id})
    return id
}

# Functions -------------------------------------------------------------

func compile_function(n) {
    let fid = uid()
    let fname = "fn_{fid}"
    let parent = CTX

    let caps = []
    let capmap = {}
    for (let nm in used_names(n)) {
        let r = resolve(nm)
        if (r.kind == "local") {
            capmap[nm] = len(caps)
            append(caps, r.v.c)
        } else if (r.kind == "cap") {
            capmap[nm] = len(caps)
            append(caps, "self->cells[{r.i}]")
        }
    }

    let child = new_ctx(false)
    let nested = {}
    walk_nested(n.body, nested)
    walk_nested(n.defaults, nested)
    child.nested = nested
    child.capmap = capmap
    CTX = child

    let min_args = 0
    for (let i = 0; i < len(n.params); i++) {
        if (n.defaults[i] == null) {
            min_args = i + 1
        }
    }
    emit("static LV {fname}(LvFunc *self, int argc, LV *argv) \{")
    emit("lv_pos_mod = &mod_{MOD.id};")
    emit("lv_arity(self, argc, {min_args}, {len(n.params)});")
    for (let i = 0; i < len(n.params); i++) {
        if (n.defaults[i] == null) {
            declare(n.params[i], "argv[{i}]")
        } else {
            let v = declare(n.params[i], "lv_null()")
            emit("if (argc > {i}) \{")
            var_set(v, "argv[{i}]")
            emit("} else {")
            CTX.line = -1
            let d = ex(n.defaults[i])
            var_set(v, d)
            emit("}")
            CTX.line = -1
        }
    }
    for (let s in n.body) {
        st(s)
    }
    run_defers(0)
    emit("return lv_null();")
    emit("}")
    append(FN_BODIES, join(child.out, "\n"))
    append(FN_DECLS, "static LV {fname}(LvFunc *self, int argc, LV *argv);")
    CTX = parent

    let name = "<anonymous>"
    if (n.name != null) {
        name = n.name
    }
    if (len(caps) == 0) {
        return emit_tmp("lv_closure({fname}, \"{name}\", 0, NULL)")
    }
    let arr = "cl{fid}"
    let capstr = join(caps, ", ")
    emit("LV *{arr}[] = \{{capstr}\};")
    return emit_tmp("lv_closure({fname}, \"{name}\", {len(caps)}, {arr})")
}

# Statements ------------------------------------------------------------

func store_name(name, value) {
    let r = resolve(name)
    if (r.kind == "local") {
        var_set(r.v, value)
    } else if (r.kind == "cap") {
        emit("*self->cells[{r.i}] = {value};")
    } else {
        reg_global(name)
        emit("lv_global_store_check({value}, {global_in_function()});")
        emit("{gname(name)} = {value};")
    }
}

func global_in_function() {
    if (CTX.is_main) {
        return "0"
    }
    return "1"
}

func st_block(stmts) {
    emit("{")
    push_scope()
    CTX.line = -1
    for (let s in stmts) {
        st(s)
    }
    pop_scope()
    emit("}")
    CTX.line = -1
}

func st_let(n) {
    mark(n.line)
    let init_expr = "lv_null()"
    if (n.init != null) {
        init_expr = ex(n.init)
    }
    if (at_top()) {
        reg_global(n.name)
        emit("lv_global_store_check({init_expr}, 0);")
        emit("{gname(n.name)} = {init_expr};")
    } else {
        declare(n.name, init_expr)
    }
}

func st_funcdef(n) {
    mark(n.line)
    if (n.name == null) {
        ex(n)
        return null
    }
    if (at_top()) {
        reg_global(n.name)
        let f = compile_function(n)
        emit("{gname(n.name)} = {f};")
    } else {
        let v = declare(n.name, "lv_null()")
        let f = compile_function(n)
        var_set(v, f)
    }
}

func st_setidx(n) {
    let t = ex(n.target)
    let i = ex(n.index)
    let v = ex(n.e)
    mark(n.line)
    if (n.op != null) {
        let cur = emit_tmp("lv_index({t}, {i})")
        v = emit_tmp("{BINOPS[n.op]}({cur}, {v})")
    }
    emit("lv_index_set({t}, {i}, {v});")
}

func st_if(n) {
    let c = ex(n.cond)
    mark(n.line)
    emit("if (lv_truth({c})) \{")
    push_scope()
    CTX.line = -1
    for (let s in n.then) {
        st(s)
    }
    pop_scope()
    if (len(n.els) > 0) {
        emit("} else {")
        push_scope()
        CTX.line = -1
        for (let s in n.els) {
            st(s)
        }
        pop_scope()
    }
    emit("}")
    CTX.line = -1
}

func loop_push(kind) {
    let l = {"kind": kind, "id": uid(), "used_cont": false, "used_brk": false,
             "depth": len(CTX.scopes)}
    append(CTX.loops, l)
    return l
}

func loop_pop() {
    remove(CTX.loops, len(CTX.loops) - 1)
}

func st_while(n) {
    let lp = loop_push("loop")
    emit("for (;;) \{")
    CTX.line = -1
    let c = ex(n.cond)
    mark(n.line)
    emit("if (!lv_truth({c})) break;")
    st_block(n.body)
    emit("}")
    loop_pop()
    CTX.line = -1
}

func st_for(n) {
    emit("{")
    push_scope()
    CTX.line = -1
    st(n.init)
    let lp = loop_push("for")
    emit("for (;;) \{")
    CTX.line = -1
    let c = ex(n.cond)
    mark(n.line)
    emit("if (!lv_truth({c})) break;")
    st_block(n.body)
    if (lp.used_cont) {
        emit("cnt_{lp.id}:;")
    }
    CTX.line = -1
    st(n.incr)
    emit("}")
    loop_pop()
    pop_scope()
    emit("}")
    CTX.line = -1
}

func st_forin(n) {
    emit("{")
    push_scope()
    let it = ex(n.iter)
    mark(n.line)
    let id = uid()
    emit("LV it{id} = lv_iter_prepare({it});")
    emit("int64_t n{id} = lv_iter_len(it{id});")
    let lp = loop_push("loop")
    emit("for (int64_t i{id} = 0; i{id} < n{id}; i{id}++) \{")
    push_scope()
    CTX.line = -1
    mark(n.line)
    declare(n.name, "lv_iter_at(it{id}, i{id})")
    for (let s in n.body) {
        st(s)
    }
    pop_scope()
    emit("}")
    loop_pop()
    pop_scope()
    emit("}")
    CTX.line = -1
}

func st_switch(n) {
    emit("{")
    push_scope()
    let sv = emit_tmp(ex(n.e))
    let lp = loop_push("switch")
    let depth = 0
    for (let c in n.cases) {
        CTX.line = -1
        let cv = ex(c.value)
        mark(c.line)
        emit("if (lv_eq({sv}, {cv}).b) \{")
        st_scoped(c.body)
        emit("} else {")
        depth += 1
    }
    st_scoped(n.dflt)
    for (let i = 0; i < depth; i++) {
        emit("}")
    }
    if (lp.used_brk) {
        emit("sw_{lp.id}:;")
    }
    loop_pop()
    pop_scope()
    emit("}")
    CTX.line = -1
}

func st_scoped(stmts) {
    push_scope()
    CTX.line = -1
    for (let s in stmts) {
        st(s)
    }
    pop_scope()
}

func st_unsafe(n) {
    mark(n.line)
    emit("lv_unsafe_begin();")
    emit("{")
    push_scope()
    append(CTX.defers[len(CTX.defers) - 1], {"kind": "unsafe"})
    CTX.line = -1
    for (let s in n.body) {
        st(s)
    }
    pop_scope()
    emit("}")
    CTX.line = -1
}

func st_break(n) {
    if (len(CTX.loops) == 0) {
        die("Compile Error", n.line, "break statement outside loop")
    }
    let lp = CTX.loops[len(CTX.loops) - 1]
    run_defers(lp.depth)
    if (lp.kind == "switch") {
        lp.used_brk = true
        emit("goto sw_{lp.id};")
    } else {
        emit("break;")
    }
}

func st_continue(n) {
    let i = len(CTX.loops) - 1
    while (i >= 0 and CTX.loops[i].kind == "switch") {
        i -= 1
    }
    if (i < 0) {
        die("Compile Error", n.line, "continue statement outside loop")
    }
    let lp = CTX.loops[i]
    run_defers(lp.depth)
    if (lp.kind == "for") {
        lp.used_cont = true
        emit("goto cnt_{lp.id};")
    } else {
        emit("continue;")
    }
}

func st(n) {
    let k = n.k
    if (k == "let") {
        st_let(n)
    } else if (k == "group") {
        for (let s in n.items) {
            st(s)
        }
    } else if (k == "func") {
        st_funcdef(n)
    } else if (k == "assign") {
        mark(n.line)
        let v = ex(n.e)
        store_name(n.name, v)
    } else if (k == "setidx") {
        st_setidx(n)
    } else if (k == "print") {
        for (let arg in n.args) {
            let v = ex(arg)
            mark(n.line)
            emit("lv_print({v});")
        }
    } else if (k == "return") {
        mark(n.line)
        let v = "lv_null()"
        if (n.e != null) {
            v = ex(n.e)
        }
        if (CTX.is_main) {
            run_defers(0)
            emit("return;")
        } else {
            v = emit_tmp(v)
            emit("lv_box_escape_check({v}, \"returned from a function\");")
            run_defers(0)
            emit("return {v};")
        }
    } else if (k == "break") {
        st_break(n)
    } else if (k == "continue") {
        st_continue(n)
    } else if (k == "if") {
        st_if(n)
    } else if (k == "while") {
        st_while(n)
    } else if (k == "for") {
        st_for(n)
    } else if (k == "forin") {
        st_forin(n)
    } else if (k == "switch") {
        st_switch(n)
    } else if (k == "use") {
        st_use(n)
    } else if (k == "unsafe") {
        st_unsafe(n)
    } else if (k == "typedef") {
        mark(n.line)
    } else {
        mark(n.line)
        ex(n)
    }
}

# Modules ---------------------------------------------------------------

func path_dir(p) {
    let i = last_index_of(p, "/")
    if (i < 0) {
        return ""
    }
    if (i == 0) {
        return "/"
    }
    return slice(p, 0, i)
}

func path_join(dir, rel) {
    if (starts_with(rel, "/") or dir == "") {
        return rel
    }
    if (dir == "/") {
        return "/{rel}"
    }
    return "{dir}/{rel}"
}

# Resolves "." and ".." segments, like realpath does for files without symlinks.
func path_norm(p) {
    let absolute = starts_with(p, "/")
    let out = []
    for (let seg in split(p, "/")) {
        if (seg == "." or seg == "") {
            continue
        }
        if (seg == ".." and len(out) > 0 and out[len(out) - 1] != "..") {
            remove(out, len(out) - 1)
        } else if (seg == ".." and absolute) {
            continue
        } else {
            append(out, seg)
        }
    }
    let joined = join(out, "/")
    if (absolute) {
        return "/{joined}"
    }
    return joined
}

func new_module(display, canon) {
    let id = len(MOD_LIST)
    let m = {"id": id, "path": display, "canon": canon, "prefix": "g_", "globals": {},
             "exports": [], "state": "compiling"}
    if (id > 0) {
        m.prefix = "m{id}_"
    }
    append(MOD_LIST, m)
    MODULES[canon] = m
    append(MOD_DECLS, "static int mod_{id}_state;")
    return m
}

func collect_exports(stmts, out) {
    for (let s in stmts) {
        if (s.k == "group") {
            collect_exports(s.items, out)
        } else if ((s.k == "let" or s.k == "func") and s.exported and s.name != null) {
            append(out, s.name)
        }
    }
}

func decl_module_source(m, lines) {
    append(MOD_DECLS, "static const char *const srcl_{m.id}[] = \{")
    for (let line_text in lines) {
        append(MOD_DECLS, "\"{c_escape(line_text)}\",")
    }
    append(MOD_DECLS, "NULL};")
    append(MOD_DECLS, "static const LvModule mod_{m.id} = \{\"{c_escape(m.path)}\", srcl_{m.id}, {len(lines)}};")
}

# Compiles the statements of module m into a C function named `fname`.
func compile_module_body(m, stmts, fname) {
    CTX = new_ctx(true)
    walk_nested(stmts, CTX.nested)
    prescan_globals(stmts)
    emit("static void {fname}(void) \{")
    emit("lv_pos_mod = &mod_{m.id};")
    if (m.id == 0) {
        define_types(stmts)
    }
    for (let s in stmts) {
        st(s)
    }
    if (m.id == 0 and has_zero_arg_main(stmts)) {
        let main_var = gname("main")
        emit("lv_call({main_var}, 0, NULL);")
    }
    run_defers(0)
    emit("}")
    append(MOD_BODIES, join(CTX.out, "\n"))
    append(FN_DECLS, "static void {fname}(void);")
}

# Loads, parses and compiles an imported file. Returns null if it cannot be read.
func compile_module(canon) {
    let f = open(canon, "r")
    if (f == null) {
        return null
    }
    let text = read(f)
    close(f)
    let saved_mod = MOD
    let saved_ctx = CTX
    let saved_file = SRC_FILE
    let saved_lines = SRC_LINES
    let m = new_module(canon, canon)
    MOD = m
    SRC_FILE = canon
    SRC_LINES = split_lines(text)
    decl_module_source(m, SRC_LINES)
    let stmts = parse_program(lex(text, 1))
    collect_exports(stmts, m.exports)
    compile_module_body(m, stmts, "mod_{m.id}_run")
    m.state = "done"
    MOD = saved_mod
    CTX = saved_ctx
    SRC_FILE = saved_file
    SRC_LINES = saved_lines
    return m
}

func emit_name_error(hint, fmt_text, arg_a, arg_b) {
    let args_text = ""
    if (arg_a != null) {
        args_text = ", \"{c_escape(arg_a)}\""
    }
    if (arg_b != null) {
        let prefix = args_text
        args_text = "{prefix}, \"{c_escape(arg_b)}\""
    }
    emit("lv_errorf(LV_ERR_NAME, \"{hint}\", \"{fmt_text}\"{args_text});")
}

func st_use(n) {
    mark(n.line)
    let canon = path_norm(path_join(path_dir(MOD.canon), n.path))
    let m2 = MODULES[canon]
    if (m2 == null) {
        m2 = compile_module(canon)
    }
    if (m2 == null) {
        let hint = "Check that the import path exists and ends with .lu"
        emit_name_error(hint, "Could not import file '%s'", n.path, null)
        return null
    }
    if (m2.state == "compiling") {
        let hint = "Modules must not import each other in a cycle; move shared code to a third module"
        emit_name_error(hint, "Circular import detected: '%s' is already loading", n.path, null)
        return null
    }
    let id = m2.id
    emit("if (mod_{id}_state == 0) \{ mod_{id}_state = 1; mod_{id}_run(); mod_{id}_state = 2; }")
    emit("lv_pos_mod = &mod_{MOD.id};")
    CTX.line = -1
    mark(n.line)
    let names = n.names
    if (len(names) == 0) {
        names = m2.exports
    }
    for (let name in names) {
        if (find(m2.exports, name) < 0) {
            let hint = "Export names explicitly in the module before using them"
            emit_name_error(hint, "Module '%s' does not export '%s'", n.path, name)
            return null
        }
        reg_global(name)
        emit("{gname(name)} = {m2.prefix}{name};")
    }
}

# Static lint (rule R12): free() may not sit inside conditional control flow in an
# unsafe block. The first violation is kept; the program then reports it at start-up.
let STATIC_ERR = null

func lint_children(x, in_unsafe, in_cond) {
    if (type(x) == "list") {
        for (let y in x) {
            lint(y, in_unsafe, in_cond)
        }
    } else if (type(x) == "map") {
        for (let y in map_values(x)) {
            if (type(y) == "list" or type(y) == "map") {
                lint(y, in_unsafe, in_cond)
            }
        }
    }
}

func lint(x, in_unsafe, in_cond) {
    if (type(x) == "list") {
        lint_children(x, in_unsafe, in_cond)
        return null
    }
    if (type(x) != "map") {
        return null
    }
    let k = x.k
    let inner = in_cond
    if (in_unsafe) {
        inner = true
    }
    if (k == "call" and x.callee.k == "id" and x.callee.name == "free" and in_unsafe and in_cond) {
        if (STATIC_ERR == null) {
            STATIC_ERR = {"line": x.line, "msg": "free() may not appear inside conditional control flow", "hint": "Move free(ptr) out of the branch/loop, or use defer(ptr) instead"}
        }
    } else if (k == "unsafe") {
        lint(x.body, true, in_cond)
    } else if (k == "if") {
        lint(x.cond, in_unsafe, inner)
        lint(x.then, in_unsafe, inner)
        lint(x.els, in_unsafe, inner)
    } else if (k == "while") {
        lint(x.cond, in_unsafe, inner)
        lint(x.body, in_unsafe, inner)
    } else if (k == "for") {
        lint(x.init, in_unsafe, in_cond)
        lint(x.cond, in_unsafe, inner)
        lint(x.incr, in_unsafe, inner)
        lint(x.body, in_unsafe, inner)
    } else if (k == "forin") {
        lint(x.iter, in_unsafe, in_cond)
        lint(x.body, in_unsafe, inner)
    } else if (k == "switch") {
        lint(x.e, in_unsafe, in_cond)
        for (let c in x.cases) {
            lint(c.value, in_unsafe, in_cond)
            lint(c.body, in_unsafe, inner)
        }
        lint(x.dflt, in_unsafe, inner)
    } else {
        lint_children(x, in_unsafe, in_cond)
    }
    return null
}

# Program ---------------------------------------------------------------

func prescan_globals(stmts) {
    for (let s in stmts) {
        if (s.k == "let") {
            reg_global(s.name)
        } else if (s.k == "func" and s.name != null) {
            reg_global(s.name)
        } else if (s.k == "group") {
            prescan_globals(s.items)
        }
    }
}

# data, template and bloc names exist before the program starts (main file only).
func define_types(stmts) {
    for (let s in stmts) {
        if (s.k == "typedef") {
            reg_global(s.name)
            let field_names = []
            for (let f in s.fields) {
                append(field_names, "\"{c_escape(f)}\"")
            }
            let fields_text = join(field_names, ", ")
            let arr = "NULL"
            if (len(field_names) > 0) {
                arr = "(const char *const[])\{{fields_text}}"
            }
            mark(s.line)
            let target = gname(s.name)
            let template_flag = 0
            if (s.is_template) {
                template_flag = 1
            }
            if (s.is_bloc) {
                emit("{target} = lv_define_bloc(\"{s.name}\", {len(field_names)}, {arr});")
            } else {
                emit("{target} = lv_define_data(\"{s.name}\", {len(field_names)}, {arr}, {template_flag});")
            }
        }
    }
}

func has_zero_arg_main(stmts) {
    for (let s in stmts) {
        if (s.k == "func" and s.name == "main" and len(s.params) == 0) {
            return true
        }
    }
    return false
}

func compile_program(stmts) {
    let m = new_module(SRC_FILE, path_norm(path_join(CWD, SRC_FILE)))
    MOD = m
    decl_module_source(m, SRC_LINES)
    lint(stmts, false, false)
    if (STATIC_ERR != null) {
        CTX = new_ctx(true)
        emit("static void entry(void) \{")
        emit("lv_pos_mod = &mod_0;")
        emit("lv_static_error({STATIC_ERR.line}, \"{c_escape(STATIC_ERR.msg)}\", \"{c_escape(STATIC_ERR.hint)}\");")
        emit("}")
        append(MOD_BODIES, join(CTX.out, "\n"))
        append(FN_DECLS, "static void entry(void);")
    } else {
        collect_exports(stmts, m.exports)
        compile_module_body(m, stmts, "entry")
    }

    let out = []
    append(out, "/* generated by lunac from {SRC_FILE} */")
    append(out, "#include \"luna_rt.h\"")
    for (let d in MOD_DECLS) {
        append(out, d)
    }
    append(out, "static LV K[{len(CONSTS) + 1}];")
    for (let d in GLOBAL_DECLS) {
        append(out, d)
    }
    for (let b in USED_ORDER) {
        append(out, "static LvFunc nf_{b} = \{lb_{b}, \"{b}\", 1, 0, NULL};")
    }
    for (let d in FN_DECLS) {
        append(out, d)
    }
    append(out, "static void lv_init_consts(void) \{")
    for (let c in CONSTS) {
        append(out, c)
    }
    append(out, "}")
    for (let b in FN_BODIES) {
        append(out, b)
    }
    for (let b in MOD_BODIES) {
        append(out, b)
    }
    append(out, "int main(int argc, char **argv) \{ lv_init_consts(); return lv_main(argc, argv, entry); }")
    return join(out, "\n") + "\n"
}

# ---------------------------------------------------------------------------
# Driver
# ---------------------------------------------------------------------------

func read_file(path) {
    let f = open(path, "r")
    if (f == null) {
        print("[ERROR] cannot open {path}")
        exit(1)
    }
    let text = read(f)
    close(f)
    return text
}

# split() drops empty lines, which would shift every later line number.
func split_lines(text) {
    let lines = []
    let start = 0
    let n = len(text)
    for (let i = 0; i < n; i++) {
        if (text[i] == '\n') {
            append(lines, slice(text, start, i))
            start = i + 1
        }
    }
    if (start < n) {
        append(lines, slice(text, start, n))
    }
    return lines
}

func main() {
    let a = args()
    if (len(a) < 1) {
        print("usage: luna compiler/lunac.lu input.lu [output.c [cwd]]")
        exit(1)
    }
    SRC_FILE = a[0]
    let text = read_file(a[0])
    SRC_LINES = split_lines(text)
    if (len(a) >= 3) {
        CWD = a[2]
    }
    let prog = parse_program(lex(text, 1))
    let c_text = compile_program(prog)
    if (len(a) >= 2) {
        let f = open(a[1], "w")
        write(f, c_text)
        close(f)
    } else {
        print(c_text)
    }
}
