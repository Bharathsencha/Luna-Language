# luna_rt_lib.lu: the builtin functions of the core library: conversions, maps, lists and
# strings. Every builtin is lb_<name>(self, argc, argv) and returns its result as an LV.
# Math, files, random numbers and vectors are in luna_rt_math.lu.

extern("getline", "i64", "ptr,ptr,ptr")
extern("system", "i32", "ptr")
extern("clock_gettime", "i32", "i32,ptr")
extern("strtoll", "i64", "ptr,ptr,i32")
extern("atof", "double", "ptr")
extern("strtok_r", "ptr", "ptr,ptr,ptr")
extern("isspace", "i32", "i32")
extern("isdigit", "i32", "i32")
extern("isalpha", "i32", "i32")
extern("isalnum", "i32", "i32")
extern("toupper", "i32", "i32")
extern("tolower", "i32", "i32")

# ---- argument helpers ------------------------------------------------------------------

func _fname(self_p) {
    if (self_p != 0 and ld64(self_p + F_NAME) != 0) {
        return ld64(self_p + F_NAME)
    }
    return cstr("builtin")
}

func _arg_fail(self_p, argv, i, what) {
    _errf4(E_TYPE, 0, cstr("%s() argument %d must be a %s, got %s"), _fname(self_p), i + 1, what, _type_name(argv + 16 * i))
}

# The LvStr of argument i.
func _arg_str(self_p, argv, i) {
    if (_tag(argv + 16 * i) != T_STR) {
        _arg_fail(self_p, argv, i, cstr("string"))
    }
    return _val(argv + 16 * i)
}

func _arg_int(self_p, argv, i) {
    if (_tag(argv + 16 * i) != T_INT) {
        _arg_fail(self_p, argv, i, cstr("int"))
    }
    return _val(argv + 16 * i)
}

# A number argument as a double.
func _arg_num(self_p, argv, i) {
    if (_is_num(argv + 16 * i) == 0) {
        _arg_fail(self_p, argv, i, cstr("number"))
    }
    return _num(argv + 16 * i)
}

# The LvList of argument i.
func _arg_list(self_p, argv, i) {
    if (_tag(argv + 16 * i) != T_LIST) {
        _arg_fail(self_p, argv, i, cstr("list"))
    }
    return _val(argv + 16 * i)
}

# The LV of argument i, which must be a map.
func _arg_map(self_p, argv, i) {
    if (_tag(argv + 16 * i) != T_MAP) {
        _arg_fail(self_p, argv, i, cstr("map"))
    }
    return argv + 16 * i
}

# A char counts as a one-character string: the LvStr of v, using tmp for the char case.
# i is the argument number that errors name.
func _text_str(self_p, v, i, tmp) {
    if (_tag(v) == T_CHAR) {
        _str_n(tmp, v + 8, 1)
        return _val(tmp)
    }
    if (_tag(v) != T_STR) {
        _errf4(E_TYPE, 0, cstr("%s() argument %d must be a %s, got %s"), _fname(self_p), i + 1, cstr("string"), _type_name(v))
    }
    return _val(v)
}

# ---- core builtins ---------------------------------------------------------------------------

func lb_len(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    let t = _tag(argv_p)
    if (t == T_STR) {
        _int(o, ld64(_val(argv_p)))
    } else if (t == T_LIST) {
        _int(o, ld64(_val(argv_p) + L_COUNT))
    } else if (t == T_DENSE) {
        _int(o, ld64(_val(argv_p) + D_COUNT))
    } else if (t == T_MAP) {
        _int(o, ld64(_val(argv_p) + M_COUNT))
    } else if (t == T_BOX or t == T_TEMPLATE) {
        let n = stack_buf(8)
        _data_len(argv_p, n)
        _int(o, ld64(n))
    } else {
        _errf(E_TYPE, 0, cstr("len() needs a string, list or map, got %s"), _type_name(argv_p), 0, 0)
    }
    retp(o)
}

func lb_str_len(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    callv(o, lb_len, self_p, argc_i, argv_p)
    retp(o)
}

func lb_append(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    _arg_list(self_p, argv_p, 0)
    _list_push(argv_p, argv_p + 16)
    let o = stack_buf(16)
    _null(o)
    retp(o)
}

func lb_list_append(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    callv(o, lb_append, self_p, argc_i, argv_p)
    retp(o)
}

func lb_type(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    if (_tag(argv_p) == T_INT and (_val(argv_p) > 2147483647 or _val(argv_p) < -2147483648)) {
        _str(o, cstr("long"))
    } else {
        _str(o, _type_name(argv_p))
    }
    retp(o)
}

func _parse_int(s) {
    let p = s
    while (isspace(ld8(p)) != 0) {
        p += 1
    }
    return strtoll(p, 0, 10)
}

func lb_int(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    let t = _tag(argv_p)
    if (t == T_PTR and _is_pointer(argv_p) != 0) {
        _int(o, _val(argv_p))
    } else if (t == T_INT) {
        _cp(o, argv_p)
    } else if (t == T_FLOAT) {
        let f = _val(argv_p)
        if (fgt(f, -9300000000000000000.0) == 0 or flt(f, 9300000000000000000.0) == 0) {
            lv_error(E_RUNTIME, cstr("int() of a float that does not fit in 64 bits"), 0)
        }
        _int(o, f2i(f))
    } else if (t == T_CHAR) {
        _int(o, ld8(argv_p + 8))
    } else if (t == T_BOOL) {
        _int(o, ld32(argv_p + 8))
    } else if (t == T_STR) {
        _int(o, _parse_int(_val(argv_p) + S_DATA))
    } else {
        _errf(E_TYPE, 0, cstr("int() cannot convert %s"), _type_name(argv_p), 0, 0)
    }
    retp(o)
}

func lb_float(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    let t = _tag(argv_p)
    _ptr_cast_check(argv_p, 1)
    if (t == T_INT) {
        _flt(o, i2f(_val(argv_p)))
    } else if (t == T_FLOAT) {
        _cp(o, argv_p)
    } else if (t == T_CHAR) {
        _flt(o, i2f(ld8(argv_p + 8)))
    } else if (t == T_BOOL) {
        _flt(o, i2f(ld32(argv_p + 8)))
    } else if (t == T_STR) {
        _flt(o, atof(_val(argv_p) + S_DATA))
    } else {
        _errf(E_TYPE, 0, cstr("float() cannot convert %s"), _type_name(argv_p), 0, 0)
    }
    retp(o)
}

func lb_to_string(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    _to_string(o, argv_p)
    retp(o)
}

func lb_to_int(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    if (_tag(argv_p) != T_STR) {
        callv(o, lb_int, self_p, argc_i, argv_p)
        retp(o)
    }
    _int(o, _parse_int(_val(argv_p) + S_DATA))
    retp(o)
}

func lb_to_float(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    callv(o, lb_float, self_p, argc_i, argv_p)
    retp(o)
}

# assert() follows the VM: it accepts any value, using its truthiness.
func _assert_truthy(v) {
    let t = _tag(v)
    if (t == T_BOOL) {
        return ld32(v + 8) != 0
    }
    if (t == T_INT) {
        return _val(v) != 0
    }
    if (t == T_FLOAT) {
        return fne(_val(v), 0.0)
    }
    if (t == T_CHAR) {
        return ld8(v + 8) != 0
    }
    if (t == T_STR) {
        return ld64(_val(v)) > 0
    }
    if (t == T_FILE) {
        return _val(v) != 0 and ld32(_val(v) + FI_CLOSED) == 0
    }
    if (t == T_LIST or t == T_DENSE or t == T_MAP or t == T_FUNC) {
        return 1
    }
    if (t >= T_BLOC_TYPE and t <= T_BOX) {
        return 1
    }
    if (t == T_PTR) {
        return _val(v) != 0
    }
    return 0
}

func lb_assert(self_p, argc_i, argv_p) {
    if (argc_i != 1) {
        lv_error(E_ARGUMENT, cstr("assert() takes exactly 1 argument"), cstr("Use assert(condition) to verify logic."))
    }
    if (_assert_truthy(argv_p) == 0) {
        lv_error(E_ASSERTION, cstr("Assertion failed"), cstr("The condition evaluated to false."))
    }
    let o = stack_buf(16)
    _bool(o, 1)
    retp(o)
}

func lb_input(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 0, 1)
    let o = stack_buf(16)
    if (argc_i == 1) {
        let p = stack_buf(16)
        _to_string(p, argv_p)
        fwrite(_val(p) + S_DATA, 1, ld64(_val(p)), _stdout())
        fflush(_stdout())
    }
    let cell = stack_buf(16)
    st64(cell, 0)
    st64(cell + 8, 0)
    let n = getline(cell, cell + 8, _stdin())
    let line = ld64(cell)
    if (n < 0) {
        free(line)
        _str(o, cstr(""))
        retp(o)
    }
    while (n > 0 and (ld8(line + n - 1) == 10 or ld8(line + n - 1) == 13)) {
        n -= 1
    }
    _str_n(o, line, n)
    free(line)
    retp(o)
}

func lb_debug(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let s = stack_buf(16)
    _to_string(s, argv_p)
    printf(cstr("value = %s\n"), _val(s) + S_DATA)
    let o = stack_buf(16)
    _cp(o, argv_p)
    retp(o)
}

func lb_range(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 3)
    let start = 0
    let end = 0
    let step = 1
    if (argc_i == 1) {
        end = _arg_int(self_p, argv_p, 0)
    } else {
        start = _arg_int(self_p, argv_p, 0)
        end = _arg_int(self_p, argv_p, 1)
        if (argc_i == 3) {
            step = _arg_int(self_p, argv_p, 2)
        }
    }
    if (step == 0) {
        lv_error(E_ARGUMENT, cstr("range() step must not be 0"), 0)
    }
    let n = 0
    if (step > 0 and end > start) {
        n = (end - start + step - 1) / step
    }
    if (step < 0 and end < start) {
        n = (start - end + (0 - step) - 1) / (0 - step)
    }
    let o = stack_buf(16)
    _list_new(o, n)
    let items = ld64(_val(o) + L_ITEMS)
    let v = start
    for (let i = 0; i < n; i++) {
        _set(items + 16 * i, T_INT, v)
        v += step
    }
    st64(_val(o) + L_COUNT, n)
    retp(o)
}

func lb_args(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 0, 0)
    let argc = ld64(addr_of("_argc"))
    let argv = ld64(addr_of("_argv"))
    let o = stack_buf(16)
    let s = stack_buf(16)
    _list_new(o, argc)
    for (let i = 1; i < argc; i++) {
        _str(s, ld64(argv + i * 8))
        _list_push(o, s)
    }
    retp(o)
}

func lb_exit(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 0, 1)
    let code = 0
    if (argc_i == 1) {
        code = _arg_int(self_p, argv_p, 0)
    }
    fflush(_stdout())
    exit(code)
    let o = stack_buf(16)
    _null(o)
    retp(o)
}

func lb_system(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let cmd = _arg_str(self_p, argv_p, 0)
    let o = stack_buf(16)
    fflush(_stdout())
    let rc = system(cmd + S_DATA)
    if (rc == -1) {
        _int(o, -1)
    } else if (band(rc, 127) == 0) {
        _int(o, band(shr(rc, 8), 255))
    } else {
        let sig = band(rc, 127)
        if (sar(shl(sig + 1, 56), 57) > 0) {
            _int(o, 128 + sig)
        } else {
            _int(o, 128)
        }
    }
    retp(o)
}

func lb_clock(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 0, 0)
    let ts = stack_buf(16)
    clock_gettime(1, ts)
    let o = stack_buf(16)
    _flt(o, fadd(i2f(ld64(ts)), fdiv(i2f(ld64(ts + 8)), 1000000000.0)))
    retp(o)
}

# ---- maps ---------------------------------------------------------------------------------------

func lb_map_set(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 3, 3)
    let m = _arg_map(self_p, argv_p, 0)
    _map_put(m, _arg_str(self_p, argv_p, 1), argv_p + 32)
    let o = stack_buf(16)
    _null(o)
    retp(o)
}

func lb_map_get(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let m = _arg_map(self_p, argv_p, 0)
    let o = stack_buf(16)
    _map_get(o, m, _arg_str(self_p, argv_p, 1))
    retp(o)
}

func lb_map_has(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let m = _arg_map(self_p, argv_p, 0)
    let o = stack_buf(16)
    _map_get(o, m, _arg_str(self_p, argv_p, 1))
    _bool(o, g_found)
    retp(o)
}

func lb_map_delete(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let m = _arg_map(self_p, argv_p, 0)
    let o = stack_buf(16)
    _bool(o, _map_del(m, _arg_str(self_p, argv_p, 1)))
    retp(o)
}

func lb_map_keys(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let m = _val(_arg_map(self_p, argv_p, 0))
    let o = stack_buf(16)
    let k = stack_buf(16)
    _list_new(o, ld64(m + M_COUNT))
    for (let i = 0; i < ld64(m + M_USED); i++) {
        let e = ld64(m + M_ENTRIES) + i * E_SIZE
        if (ld32(e + E_LIVE) != 0) {
            _set(k, T_STR, ld64(e + E_KEY))
            _list_push(o, k)
        }
    }
    retp(o)
}

func lb_map_values(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let m = _val(_arg_map(self_p, argv_p, 0))
    let o = stack_buf(16)
    _list_new(o, ld64(m + M_COUNT))
    for (let i = 0; i < ld64(m + M_USED); i++) {
        let e = ld64(m + M_ENTRIES) + i * E_SIZE
        if (ld32(e + E_LIVE) != 0) {
            _list_push(o, e + E_VAL)
        }
    }
    retp(o)
}

func lb_map_items(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let m = _val(_arg_map(self_p, argv_p, 0))
    let o = stack_buf(16)
    let pair = stack_buf(32)
    let item = stack_buf(16)
    _list_new(o, ld64(m + M_COUNT))
    for (let i = 0; i < ld64(m + M_USED); i++) {
        let e = ld64(m + M_ENTRIES) + i * E_SIZE
        if (ld32(e + E_LIVE) == 0) {
            continue
        }
        _set(pair, T_STR, ld64(e + E_KEY))
        _cp(pair + 16, e + E_VAL)
        _list_of(item, 2, pair)
        _list_push(o, item)
    }
    retp(o)
}

# ---- lists --------------------------------------------------------------------------------------

func lb_remove(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let l = _arg_list(self_p, argv_p, 0)
    let i = _arg_int(self_p, argv_p, 1)
    let orig = i
    let count = ld64(l + L_COUNT)
    if (i < 0) {
        i += count
    }
    if (i < 0 or i >= count) {
        _oob(orig, count, cstr("list"))
    }
    let items = ld64(l + L_ITEMS)
    let o = stack_buf(16)
    _cp(o, items + 16 * i)
    memmove(items + 16 * i, items + 16 * (i + 1), 16 * (count - i - 1))
    st64(l + L_COUNT, count - 1)
    retp(o)
}

func lb_find(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let l = _arg_list(self_p, argv_p, 0)
    let o = stack_buf(16)
    for (let i = 0; i < ld64(l + L_COUNT); i++) {
        if (lvp_equal(ld64(l + L_ITEMS) + 16 * i, argv_p + 16) != 0) {
            _int(o, i)
            retp(o)
        }
    }
    _int(o, -1)
    retp(o)
}

func lb_slice(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 3, 3)
    let a = _arg_int(self_p, argv_p, 1)
    let b = _arg_int(self_p, argv_p, 2)
    let o = stack_buf(16)
    let len = 0
    if (_tag(argv_p) == T_LIST) {
        len = ld64(_val(argv_p) + L_COUNT)
    } else {
        len = ld64(_arg_str(self_p, argv_p, 0))
    }
    if (a < 0) {
        a += len
    }
    if (b < 0) {
        b += len
    }
    if (a < 0) {
        a = 0
    }
    if (b > len) {
        b = len
    }
    if (_tag(argv_p) == T_LIST) {
        if (a >= b) {
            _list_new(o, 0)
        } else {
            _list_of(o, b - a, ld64(_val(argv_p) + L_ITEMS) + 16 * a)
        }
        retp(o)
    }
    if (a >= b) {
        _str(o, cstr(""))
    } else {
        _str_n(o, _val(argv_p) + S_DATA + a, b - a)
    }
    retp(o)
}

func _sort_cmp(a, b) {
    if (_tag(a) == T_INT and _tag(b) == T_INT) {
        return (_val(a) > _val(b)) - (_val(a) < _val(b))
    }
    if (_is_num(a) and _is_num(b)) {
        let x = _num(a)
        let y = _num(b)
        return fgt(x, y) - flt(x, y)
    }
    return _order(a, b)
}

func _merge_sort(items, tmp, n) {
    if (n < 2) {
        return 0
    }
    if (n <= 16) {
        let x = stack_buf(16)
        for (let i = 1; i < n; i++) {
            _cp(x, items + 16 * i)
            let j = i - 1
            while (j >= 0 and _sort_cmp(items + 16 * j, x) > 0) {
                _cp(items + 16 * (j + 1), items + 16 * j)
                j -= 1
            }
            _cp(items + 16 * (j + 1), x)
        }
        return 0
    }
    let h = n / 2
    _merge_sort(items, tmp, h)
    _merge_sort(items + 16 * h, tmp, n - h)
    let i = 0
    let j = h
    let k = 0
    while (i < h and j < n) {
        if (_sort_cmp(items + 16 * j, items + 16 * i) < 0) {
            _cp(tmp + 16 * k, items + 16 * j)
            j++
        } else {
            _cp(tmp + 16 * k, items + 16 * i)
            i++
        }
        k++
    }
    while (i < h) {
        _cp(tmp + 16 * k, items + 16 * i)
        i++
        k++
    }
    while (j < n) {
        _cp(tmp + 16 * k, items + 16 * j)
        j++
        k++
    }
    memcpy(items, tmp, 16 * n)
}

func lb_sort(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let l = _arg_list(self_p, argv_p, 0)
    let tmp = lv_alloc(16 * (ld64(l + L_COUNT) + 1))
    _merge_sort(ld64(l + L_ITEMS), tmp, ld64(l + L_COUNT))
    let o = stack_buf(16)
    _null(o)
    retp(o)
}

func lb_map(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let l = _arg_list(self_p, argv_p, 0)
    let o = stack_buf(16)
    let a = stack_buf(16)
    let r = stack_buf(16)
    _list_new(o, ld64(l + L_COUNT))
    for (let i = 0; i < ld64(l + L_COUNT); i++) {
        _cp(a, ld64(l + L_ITEMS) + 16 * i)
        lvp_call(r, argv_p + 16, 1, a)
        _list_push(o, r)
    }
    retp(o)
}

func lb_filter(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let l = _arg_list(self_p, argv_p, 0)
    let o = stack_buf(16)
    let a = stack_buf(16)
    let r = stack_buf(16)
    _list_new(o, ld64(l + L_COUNT))
    for (let i = 0; i < ld64(l + L_COUNT); i++) {
        _cp(a, ld64(l + L_ITEMS) + 16 * i)
        lvp_call(r, argv_p + 16, 1, a)
        if (lvp_truth(r) != 0) {
            _list_push(o, a)
        }
    }
    retp(o)
}

func lb_reduce(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 3, 3)
    let l = _arg_list(self_p, argv_p, 0)
    let acc = stack_buf(16)
    let pair = stack_buf(32)
    _cp(acc, argv_p + 32)
    for (let i = 0; i < ld64(l + L_COUNT); i++) {
        _cp(pair, acc)
        _cp(pair + 16, ld64(l + L_ITEMS) + 16 * i)
        lvp_call(acc, argv_p + 16, 2, pair)
    }
    retp(acc)
}

# ---- strings ------------------------------------------------------------------------------------

func lb_is_empty(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    _bool(o, ld64(_arg_str(self_p, argv_p, 0)) == 0)
    retp(o)
}

func lb_concat(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let a = stack_buf(16)
    let b = stack_buf(16)
    let o = stack_buf(16)
    _text_str(self_p, argv_p, 0, a)
    _text_str(self_p, argv_p + 16, 1, b)
    if (_tag(argv_p) == T_STR) {
        _cp(a, argv_p)
    }
    if (_tag(argv_p + 16) == T_STR) {
        _cp(b, argv_p + 16)
    }
    lvp_add(o, a, b)
    retp(o)
}

func lb_substring(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 3, 3)
    let s = _arg_str(self_p, argv_p, 0)
    let start = _arg_int(self_p, argv_p, 1)
    let n = _arg_int(self_p, argv_p, 2)
    let o = stack_buf(16)
    if (start < 0) {
        start = 0
    }
    if (start >= ld64(s)) {
        _str(o, cstr(""))
        retp(o)
    }
    if (n < 0) {
        n = 0
    }
    if (start + n > ld64(s)) {
        n = ld64(s) - start
    }
    _str_n(o, s + S_DATA + start, n)
    retp(o)
}

func lb_char_at(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let s = _arg_str(self_p, argv_p, 0)
    let i = _arg_int(self_p, argv_p, 1)
    let o = stack_buf(16)
    if (i < 0 or i >= ld64(s)) {
        _str(o, cstr(""))
    } else {
        _str_n(o, s + S_DATA + i, 1)
    }
    retp(o)
}

# Index of sub in s at or after from, or -1.
func _find_sub(s, sub, frm) {
    let n = ld64(s)
    let m = ld64(sub)
    if (m == 0) {
        if (frm <= n) {
            return frm
        }
        return -1
    }
    let i = frm
    while (i + m <= n) {
        if (memcmp(s + S_DATA + i, sub + S_DATA, m) == 0) {
            return i
        }
        i += 1
    }
    return -1
}

func lb_index_of(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let tmp = stack_buf(16)
    let s = _arg_str(self_p, argv_p, 0)
    let sub = _text_str(self_p, argv_p + 16, 1, tmp)
    let o = stack_buf(16)
    _int(o, _find_sub(s, sub, 0))
    retp(o)
}

func lb_last_index_of(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let tmp = stack_buf(16)
    let s = _arg_str(self_p, argv_p, 0)
    let t = _text_str(self_p, argv_p + 16, 1, tmp)
    let o = stack_buf(16)
    let i = ld64(s) - ld64(t)
    while (i >= 0) {
        if (memcmp(s + S_DATA + i, t + S_DATA, ld64(t)) == 0) {
            _int(o, i)
            retp(o)
        }
        i -= 1
    }
    _int(o, -1)
    retp(o)
}

func lb_contains(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let o = stack_buf(16)
    if (_tag(argv_p) == T_LIST) {
        let l = _val(argv_p)
        for (let i = 0; i < ld64(l + L_COUNT); i++) {
            if (lvp_equal(ld64(l + L_ITEMS) + 16 * i, argv_p + 16) != 0) {
                _bool(o, 1)
                retp(o)
            }
        }
        _bool(o, 0)
        retp(o)
    }
    let tmp = stack_buf(16)
    let s = _arg_str(self_p, argv_p, 0)
    let sub = _text_str(self_p, argv_p + 16, 1, tmp)
    _bool(o, _find_sub(s, sub, 0) >= 0)
    retp(o)
}

func lb_starts_with(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let tmp = stack_buf(16)
    let s = _arg_str(self_p, argv_p, 0)
    let p = _text_str(self_p, argv_p + 16, 1, tmp)
    let o = stack_buf(16)
    _bool(o, ld64(p) <= ld64(s) and memcmp(s + S_DATA, p + S_DATA, ld64(p)) == 0)
    retp(o)
}

func lb_ends_with(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let tmp = stack_buf(16)
    let s = _arg_str(self_p, argv_p, 0)
    let p = _text_str(self_p, argv_p + 16, 1, tmp)
    let o = stack_buf(16)
    _bool(o, ld64(p) <= ld64(s) and memcmp(s + S_DATA + ld64(s) - ld64(p), p + S_DATA, ld64(p)) == 0)
    retp(o)
}

# A copy of s with every byte run through the C ctype function toupper or tolower.
func _map_case(o, s, upper) {
    _str_n(o, s + S_DATA, ld64(s))
    let d = _val(o) + S_DATA
    for (let i = 0; i < ld64(s); i++) {
        if (upper != 0) {
            st8(d + i, toupper(ld8(s + S_DATA + i)))
        } else {
            st8(d + i, tolower(ld8(s + S_DATA + i)))
        }
    }
}

func _case_builtin(self_p, argc_i, argv_p, upper) {
    lv_arity(self_p, argc_i, 1, 1)
    let tmp = stack_buf(16)
    let o = stack_buf(16)
    let s = _text_str(self_p, argv_p, 0, tmp)
    _map_case(o, s, upper)
    if (_tag(argv_p) == T_CHAR) {
        _chr(o, ld8(_val(o) + S_DATA))
    }
    retp(o)
}

func lb_to_upper(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    callv(o, _case_builtin, self_p, argc_i, argv_p, 1)
    retp(o)
}

func lb_to_lower(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    callv(o, _case_builtin, self_p, argc_i, argv_p, 0)
    retp(o)
}

func _trim(o, s, left, right) {
    let a = 0
    let b = ld64(s)
    if (left != 0) {
        while (a < b and isspace(ld8(s + S_DATA + a)) != 0) {
            a += 1
        }
    }
    if (right != 0) {
        while (b > a and isspace(ld8(s + S_DATA + b - 1)) != 0) {
            b -= 1
        }
    }
    _str_n(o, s + S_DATA + a, b - a)
}

func lb_trim(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    _trim(o, _arg_str(self_p, argv_p, 0), 1, 1)
    retp(o)
}

func lb_trim_left(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    _trim(o, _arg_str(self_p, argv_p, 0), 1, 0)
    retp(o)
}

func lb_trim_right(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    _trim(o, _arg_str(self_p, argv_p, 0), 0, 1)
    retp(o)
}

func lb_replace(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 3, 3)
    let t1 = stack_buf(16)
    let t2 = stack_buf(16)
    let s = _arg_str(self_p, argv_p, 0)
    let frm = _text_str(self_p, argv_p + 16, 1, t1)
    let to = _text_str(self_p, argv_p + 32, 2, t2)
    let o = stack_buf(16)
    if (ld64(frm) == 0) {
        _cp(o, argv_p)
        retp(o)
    }
    let b = stack_buf(B_SIZE)
    _buf_init(b)
    let i = 0
    while (true) {
        let j = _find_sub(s, frm, i)
        if (j < 0) {
            break
        }
        _buf_add(b, s + S_DATA + i, j - i)
        _buf_add(b, to + S_DATA, ld64(to))
        i = j + ld64(frm)
    }
    _buf_add(b, s + S_DATA + i, ld64(s) - i)
    _buf_done(o, b)
    retp(o)
}

func lb_reverse(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    if (_tag(argv_p) == T_LIST) {
        let l = _val(argv_p)
        let items = ld64(l + L_ITEMS)
        let t = stack_buf(16)
        let i = 0
        let j = ld64(l + L_COUNT) - 1
        while (i < j) {
            _cp(t, items + 16 * i)
            _cp(items + 16 * i, items + 16 * j)
            _cp(items + 16 * j, t)
            i++
            j -= 1
        }
        _cp(o, argv_p)
        retp(o)
    }
    let s = _arg_str(self_p, argv_p, 0)
    _str_n(o, s + S_DATA, ld64(s))
    let n = ld64(s)
    for (let i = 0; i < n; i++) {
        st8(_val(o) + S_DATA + i, ld8(s + S_DATA + n - 1 - i))
    }
    retp(o)
}

func lb_repeat(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let tmp = stack_buf(16)
    let s = _text_str(self_p, argv_p, 0, tmp)
    let n = _arg_int(self_p, argv_p, 1)
    let o = stack_buf(16)
    let b = stack_buf(B_SIZE)
    _buf_init(b)
    for (let i = 0; i < n; i++) {
        _buf_add(b, s + S_DATA, ld64(s))
    }
    _buf_done(o, b)
    retp(o)
}

func _pad(self_p, argv, left, o) {
    let s = _arg_str(self_p, argv, 0)
    let w = _arg_int(self_p, argv, 1)
    let tmp = stack_buf(16)
    let pad = _text_str(self_p, argv + 32, 0, tmp)
    if (ld64(s) >= w or ld64(pad) == 0) {
        _cp(o, argv)
        return 0
    }
    let b = stack_buf(B_SIZE)
    _buf_init(b)
    if (left == 0) {
        _buf_add(b, s + S_DATA, ld64(s))
    }
    for (let i = 0; i < w - ld64(s); i++) {
        _buf_add(b, pad + S_DATA, 1)
    }
    if (left != 0) {
        _buf_add(b, s + S_DATA, ld64(s))
    }
    _buf_done(o, b)
}

func lb_pad_left(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 3, 3)
    let o = stack_buf(16)
    _pad(self_p, argv_p, 1, o)
    retp(o)
}

func lb_pad_right(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 3, 3)
    let o = stack_buf(16)
    _pad(self_p, argv_p, 0, o)
    retp(o)
}

func lb_format(self_p, argc_i, argv_p) {
    if (argc_i < 1) {
        lv_arity(self_p, argc_i, 1, 1)
    }
    let f = _arg_str(self_p, argv_p, 0)
    let b = stack_buf(B_SIZE)
    let o = stack_buf(16)
    _buf_init(b)
    let next = 1
    let n = ld64(f)
    let i = 0
    while (i < n) {
        if (ld8(f + S_DATA + i) == 123 and i + 1 < n and ld8(f + S_DATA + i + 1) == 125 and next < argc_i) {
            _buf_value(b, argv_p + 16 * next)
            next += 1
            i += 1
        } else {
            _buf_add(b, f + S_DATA + i, 1)
        }
        i += 1
    }
    _buf_done(o, b)
    retp(o)
}

# Splits on every occurrence of the delimiter; empty pieces are kept.
func lb_split(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let tmp = stack_buf(16)
    let s = _arg_str(self_p, argv_p, 0)
    let d = _text_str(self_p, argv_p + 16, 1, tmp)
    let o = stack_buf(16)
    let piece = stack_buf(16)
    _list_new(o, 8)
    if (ld64(d) == 0) {
        for (let i = 0; i < ld64(s); i++) {
            _str_n(piece, s + S_DATA + i, 1)
            _list_push(o, piece)
        }
        retp(o)
    }
    # Like the VM (strtok): every character of the delimiter separates, and empty pieces
    # are dropped.
    let copy = lv_alloc(ld64(s) + 1)
    memcpy(copy, s + S_DATA, ld64(s) + 1)
    let save = stack_buf(8)
    let tok = strtok_r(copy, d + S_DATA, save)
    while (tok != 0) {
        _str(piece, tok)
        _list_push(o, piece)
        tok = strtok_r(0, d + S_DATA, save)
    }
    retp(o)
}

func lb_join(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let l = _arg_list(self_p, argv_p, 0)
    let tmp = stack_buf(16)
    let d = _text_str(self_p, argv_p + 16, 0, tmp)
    let b = stack_buf(B_SIZE)
    let o = stack_buf(16)
    _buf_init(b)
    for (let i = 0; i < ld64(l + L_COUNT); i++) {
        if (i != 0) {
            _buf_add(b, d + S_DATA, ld64(d))
        }
        _buf_value(b, ld64(l + L_ITEMS) + 16 * i)
    }
    _buf_done(o, b)
    retp(o)
}

# 0 = isdigit, 1 = isalpha, 2 = isalnum, 3 = isspace
func _class_match(kind, c) {
    if (kind == 0) {
        return isdigit(c)
    }
    if (kind == 1) {
        return isalpha(c)
    }
    if (kind == 2) {
        return isalnum(c)
    }
    return isspace(c)
}

func _char_class(self_p, argc_i, argv_p, kind, o) {
    lv_arity(self_p, argc_i, 1, 1)
    let tmp = stack_buf(16)
    let s = _text_str(self_p, argv_p, 0, tmp)
    if (ld64(s) == 0) {
        _bool(o, 0)
        return 0
    }
    for (let i = 0; i < ld64(s); i++) {
        if (_class_match(kind, ld8(s + S_DATA + i)) == 0) {
            _bool(o, 0)
            return 0
        }
    }
    _bool(o, 1)
}

func lb_is_digit(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _char_class(self_p, argc_i, argv_p, 0, o)
    retp(o)
}

func lb_is_alpha(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _char_class(self_p, argc_i, argv_p, 1, o)
    retp(o)
}

func lb_is_alnum(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _char_class(self_p, argc_i, argv_p, 2, o)
    retp(o)
}

func lb_is_space(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _char_class(self_p, argc_i, argv_p, 3, o)
    retp(o)
}
