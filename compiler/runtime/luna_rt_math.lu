func _round_to_int(o, r) {
    if (fgt(r, -9300000000000000000.0) == 0 or flt(r, 9300000000000000000.0) == 0) {
        _flt(o, r)
    } else {
        _int(o, f2i(r))
    }
}

# 0 = floor, 1 = ceil, 2 = round, 3 = trunc
func _round_builtin(self_p, argc_i, argv_p, which, o) {
    lv_arity(self_p, argc_i, 1, 1)
    if (_tag(argv_p) == T_INT) {
        _cp(o, argv_p)
        return 0
    }
    let x = _arg_num(self_p, argv_p, 0)
    if (which == 0) {
        _round_to_int(o, floor(x))
    } else if (which == 1) {
        _round_to_int(o, ceil(x))
    } else if (which == 2) {
        _round_to_int(o, round(x))
    } else {
        _round_to_int(o, trunc(x))
    }
}

func lb_floor(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _round_builtin(self_p, argc_i, argv_p, 0, o)
    retp(o)
}

