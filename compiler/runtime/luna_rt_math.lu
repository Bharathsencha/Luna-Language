# ---- math ---------------------------------------------------------------------------------

func lb_abs(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    if (_tag(argv_p) == T_INT) {
        let i = _val(argv_p)
        if (i == -9223372036854775807 - 1) {
            _overflow(cstr("abs"))
        }
        if (i < 0) {
            _int(o, 0 - i)
        } else {
            _int(o, i)
        }
        retp(o)
    }
    _flt(o, fabs(_arg_num(self_p, argv_p, 0)))
    retp(o)
}

func lb_min(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    _arg_num(self_p, argv_p, 0)
    _arg_num(self_p, argv_p, 1)
    let o = stack_buf(16)
    if (_sort_cmp(argv_p + 16, argv_p) < 0) {
        _cp(o, argv_p + 16)
    } else {
        _cp(o, argv_p)
    }
    retp(o)
}

func lb_max(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    _arg_num(self_p, argv_p, 0)
    _arg_num(self_p, argv_p, 1)
    let o = stack_buf(16)
    if (_sort_cmp(argv_p + 16, argv_p) > 0) {
        _cp(o, argv_p + 16)
    } else {
        _cp(o, argv_p)
    }
    retp(o)
}

func lb_clamp(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 3, 3)
    _arg_num(self_p, argv_p, 0)
    _arg_num(self_p, argv_p, 1)
    _arg_num(self_p, argv_p, 2)
    let o = stack_buf(16)
    if (_sort_cmp(argv_p, argv_p + 16) < 0) {
        _cp(o, argv_p + 16)
    } else if (_sort_cmp(argv_p, argv_p + 32) > 0) {
        _cp(o, argv_p + 32)
    } else {
        _cp(o, argv_p)
    }
    retp(o)
}

func lb_sign(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let x = _arg_num(self_p, argv_p, 0)
    let o = stack_buf(16)
    _int(o, fgt(x, 0.0) - flt(x, 0.0))
    retp(o)
}

# glibc returns 3.0000000000000004 for cbrt(27); make exact cubes exact.
func _cbrt(x) {
    let r = cbrt(x)
    let n = round(r)
    if (feq(fmul(fmul(n, n), n), x)) {
        return n
    }
    return r
}

# One-argument math: which picks the function.
func _math1(self_p, argc_i, argv_p, which, o) {
    lv_arity(self_p, argc_i, 1, 1)
    let x = _arg_num(self_p, argv_p, 0)
    let r = 0
    if (which == 0) {
        r = sqrt(x)
    } else if (which == 1) {
        r = _cbrt(x)
    } else if (which == 2) {
        r = exp(x)
    } else if (which == 3) {
        r = log(x)
    } else if (which == 4) {
        r = log10(x)
    } else if (which == 5) {
        r = sin(x)
    } else if (which == 6) {
        r = cos(x)
    } else if (which == 7) {
        r = tan(x)
    } else if (which == 8) {
        r = asin(x)
    } else if (which == 9) {
        r = acos(x)
    } else if (which == 10) {
        r = atan(x)
    } else if (which == 11) {
        r = sinh(x)
    } else if (which == 12) {
        r = cosh(x)
    } else if (which == 13) {
        r = tanh(x)
    } else if (which == 14) {
        r = fsub(x, floor(x))
    } else if (which == 15) {
        r = fdiv(fmul(x, 3.14159265358979323846), 180.0)
    } else {
        r = fdiv(fmul(x, 180.0), 3.14159265358979323846)
    }
    _flt(o, r)
}

