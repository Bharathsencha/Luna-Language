# scope.lu: variable scopes, captures and deferred calls.

use { BUILTINS, emit, emit_tmp, uid } from "cstate.lu"
use { ST } from "state.lu"


export func push_scope() {
    append(ST.ctx.scopes, {})
    append(ST.ctx.defers, [])
}

# Emits the deferred calls of every scope from index `from_depth` inward, innermost first.
export func run_defers(from_depth) {
    let i = len(ST.ctx.defers) - 1
    while (i >= from_depth) {
        let list = ST.ctx.defers[i]
        let j = len(list) - 1
        while (j >= 0) {
            let d = list[j]
            if (d.kind == "boxes") {
                emit("lv_box_release_scope({d.id});")
            } else if (d.kind == "unsafe") {
                emit("lv_unsafe_end();")
            } else {
                emit("lv_call({d.f}, {len(d.args)}, {args_array(d.args)});")
            }
            j -= 1
        }
        i -= 1
    }
}

export func pop_scope() {
    run_defers(len(ST.ctx.defers) - 1)
    remove(ST.ctx.scopes, len(ST.ctx.scopes) - 1)
    remove(ST.ctx.defers, len(ST.ctx.defers) - 1)
}

export func at_top() {
    return ST.ctx.is_main and len(ST.ctx.scopes) == 1
}

export func declare(name, init_expr) {
    let id = uid()
    let is_cell = ST.ctx.nested[name] != null
    let v = {"name": name, "cell": is_cell, "c": ""}
    if (is_cell) {
        v.c = "c_{name}_{id}"
        emit("LV *{v.c} = lv_cell({init_expr});")
    } else {
        v.c = "v_{name}_{id}"
        emit("LV {v.c} = {init_expr};")
    }
    ST.ctx.scopes[len(ST.ctx.scopes) - 1][name] = v
    return v
}

export func var_get(v) {
    if (v.cell) {
        return emit_tmp("*{v.c}")
    }
    return v.c
}

export func var_set(v, expr) {
    if (v.cell) {
        emit("*{v.c} = {expr};")
    } else {
        emit("{v.c} = {expr};")
    }
}

func find_local(name) {
    let i = len(ST.ctx.scopes) - 1
    while (i >= 0) {
        let v = ST.ctx.scopes[i][name]
        if (v != null) {
            return v
        }
        i -= 1
    }
    return null
}

export func resolve(name) {
    let v = find_local(name)
    if (v != null) {
        return {"kind": "local", "v": v}
    }
    let ci = ST.ctx.capmap[name]
    if (ci != null) {
        return {"kind": "cap", "i": ci}
    }
    if (ST.mod.globals[name] != null) {
        return {"kind": "global"}
    }
    if (name == "null") {
        return {"kind": "null"}
    }
    if (BUILTINS[name] != null) {
        return {"kind": "builtin"}
    }
    return {"kind": "global"}
}

export func args_array(items) {
    if (len(items) == 0) {
        return "NULL"
    }
    let body = join(items, ", ")
    return "(LV[])\{{body}\}"
}
