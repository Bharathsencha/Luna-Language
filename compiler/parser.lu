# parser.lu: tokens to AST.

use { die } from "util.lu"
use { lex } from "lexer.lu"

let P_toks = []
let P_pos = 0

func p_tok() {
    return P_toks[P_pos]
}

func p_at(t) {
    return P_toks[P_pos].t == t
}

func p_next() {
    let tk = P_toks[P_pos]
    if (P_pos < len(P_toks) - 1) {
        P_pos += 1
    }
    return tk
}

func p_eat(t) {
    if (P_toks[P_pos].t == t) {
        p_next()
        return true
    }
    return false
}

func p_skip_nl() {
    while (P_toks[P_pos].t == "nl") {
        p_next()
    }
}

func p_fail(msg) {
    die("Syntax Error", P_toks[P_pos].line, msg)
}

func p_expect(t, msg) {
    if (P_toks[P_pos].t != t) {
        p_fail(msg)
    }
    return p_next()
}

func node(k, line) {
    return {"k": k, "line": line}
}

# Parses source text with its own token stream, then restores the parser.
func parse_inline(text, line) {
    let saved_toks = P_toks
    let saved_pos = P_pos
    P_toks = lex(text, line)
    P_pos = 0
    let e = p_expr()
    p_skip_nl()
    if (not p_at("eof")) {
        p_fail("Invalid expression inside string interpolation")
    }
    P_toks = saved_toks
    P_pos = saved_pos
    return e
}

func p_string(tk) {
    let parts = tk.v
    let has_expr = false
    for (let part in parts) {
        if (type(part) == "map") {
            has_expr = true
        }
    }
    if (not has_expr) {
        let s = node("str", tk.line)
        s.v = parts[0]
        return s
    }
    let t = node("tmpl", tk.line)
    let items = []
    for (let part in parts) {
        if (type(part) == "map") {
            append(items, parse_inline(part.expr, part.line))
        } else {
            append(items, part)
        }
    }
    t.parts = items
    return t
}

func p_list_literal(line) {
    let items = []
    p_skip_nl()
    if (not p_at("]")) {
        let more = true
        while (more) {
            p_skip_nl()
            append(items, p_expr())
            p_skip_nl()
            more = p_eat(",")
        }
    }
    p_skip_nl()
    p_expect("]", "Expected ']' at end of list")
    let n = node("list", line)
    n.items = items
    return n
}

func p_map_literal(line) {
    let keys = []
    let vals = []
    p_skip_nl()
    if (not p_at("}")) {
        let more = true
        while (more) {
            p_skip_nl()
            if (not p_at("str")) {
                p_fail("Map literal keys must be strings")
            }
            let kt = p_next()
            if (len(kt.v) != 1 or type(kt.v[0]) != "string") {
                p_fail("Map literal keys must be plain strings")
            }
            append(keys, kt.v[0])
            p_expect(":", "Expected ':' after map key")
            append(vals, p_expr())
            p_skip_nl()
            more = p_eat(",")
        }
    }
    p_skip_nl()
    p_expect("}", "Expected '}' at end of map literal")
    let n = node("map", line)
    n.keys = keys
    n.vals = vals
    return n
}

func p_func_rest(name, line, is_export) {
    p_expect("(", "Expected '('")
    let params = []
    let defaults = []
    if (not p_at(")")) {
        let more = true
        while (more) {
            if (not p_at("id")) {
                p_fail("Expected parameter name")
            }
            append(params, p_next().v)
            if (p_eat("=")) {
                append(defaults, p_expr())
            } else {
                append(defaults, null)
            }
            more = p_eat(",")
        }
    }
    p_expect(")", "Expected ')'")
    p_expect("{", "Expected '\{'")
    let n = node("func", line)
    n.name = name
    n.params = params
    n.defaults = defaults
    n.body = p_block()
    n.exported = is_export
    return n
}

func p_primary() {
    let tk = p_tok()
    let line = tk.line
    let t = tk.t
    if (t == "num") {
        p_next()
        let n = node("num", line)
        n.v = tk.v
        return n
    }
    if (t == "float") {
        p_next()
        let n = node("float", line)
        n.v = tk.v
        return n
    }
    if (t == "str") {
        p_next()
        return p_string(tk)
    }
    if (t == "char") {
        p_next()
        let n = node("char", line)
        n.v = tk.v
        return n
    }
    if (t == "true" or t == "false") {
        p_next()
        let n = node("bool", line)
        n.v = t == "true"
        return n
    }
    if (t == "id") {
        p_next()
        let n = node("id", line)
        n.name = tk.v
        return n
    }
    if (t == "(") {
        p_next()
        let e = p_expr()
        p_expect(")", "Expected ')' after expression")
        return e
    }
    if (t == "[") {
        p_next()
        return p_list_literal(line)
    }
    if (t == "{") {
        p_next()
        return p_map_literal(line)
    }
    if (t == "func") {
        p_next()
        return p_func_rest(null, line, false)
    }
    if (t == "input") {
        p_next()
        p_expect("(", "Expected '(' after input")
        let n = node("input", line)
        n.prompt = null
        if (not p_at(")")) {
            if (not p_at("str")) {
                p_fail("Expected string prompt for input")
            }
            n.prompt = p_next().v
        }
        p_expect(")", "Expected ')' after input")
        return n
    }
    if (t == "box") {
        p_next()
        p_expect("[", "Expected '[' after 'box'")
        let n = node("box", line)
        n.size = p_expr()
        p_expect("]", "Expected ']' after box size")
        return n
    }
    if (t == ";") {
        p_fail("Unexpected semicolon ';'")
    }
    p_fail("Unexpected token '{t}': expected an expression")
}

func p_postfix() {
    let line = p_tok().line
    let e = p_primary()
    while (true) {
        if (p_at("(")) {
            p_next()
            let args = []
            p_skip_nl()
            if (not p_at(")")) {
                let more = true
                while (more) {
                    p_skip_nl()
                    append(args, p_expr())
                    p_skip_nl()
                    more = p_eat(",")
                }
            }
            p_skip_nl()
            p_expect(")", "Expected ')' after arguments")
            let c = node("call", line)
            c.callee = e
            c.args = args
            e = c
        } else if (p_at("\{") and e.k == "id") {
            p_next()
            let args = []
            p_skip_nl()
            if (not p_at("}")) {
                let more = true
                while (more) {
                    p_skip_nl()
                    append(args, p_expr())
                    p_skip_nl()
                    more = p_eat(",")
                }
            }
            p_expect("}", "Expected '}' after typed constructor arguments")
            let c = node("call", line)
            c.callee = e
            c.args = args
            e = c
        } else if (p_at("[")) {
            p_next()
            let idx = p_expr()
            p_expect("]", "Expected ']' after index")
            let n = node("index", line)
            n.target = e
            n.index = idx
            e = n
        } else if (p_at(".")) {
            p_next()
            if (not p_at("id")) {
                p_fail("Expected field name after '.'")
            }
            let n = node("field", line)
            n.target = e
            n.field = p_next().v
            e = n
        } else if (p_at("++") or p_at("--")) {
            let op = p_next().t
            if (e.k != "id") {
                p_fail("'{op}' can only be applied to variables")
            }
            let n = node("incdec", line)
            n.name = e.name
            n.op = op
            e = n
        } else {
            break
        }
    }
    return e
}

func p_unary() {
    let line = p_tok().line
    if (p_eat("not")) {
        let n = node("not", line)
        n.e = p_unary()
        return n
    }
    if (p_eat("-")) {
        let r = p_unary()
        if (r.k == "num") {
            r.v = "-{r.v}"
            return r
        }
        if (r.k == "float") {
            r.v = "-{r.v}"
            return r
        }
        let n = node("bin", line)
        n.op = "-"
        n.l = node("num", line)
        n.l.v = "0"
        n.r = r
        return n
    }
    if (p_eat("+")) {
        return p_unary()
    }
    return p_postfix()
}

func p_binary_level(sub, ops) {
    let line = p_tok().line
    let e = sub()
    while (has_op(ops, p_tok().t)) {
        let op = p_next().t
        let r = sub()
        let n = node("bin", line)
        n.op = op
        n.l = e
        n.r = r
        e = n
    }
    return e
}

func has_op(ops, t) {
    for (let o in ops) {
        if (o == t) {
            return true
        }
    }
    return false
}

func p_mul() {
    return p_binary_level(p_unary, ["*", "/", "%"])
}

func p_add() {
    return p_binary_level(p_mul, ["+", "-"])
}

func p_cmp() {
    return p_binary_level(p_add, ["<", ">", "<=", ">="])
}

func p_eq() {
    return p_binary_level(p_cmp, ["==", "!="])
}

func p_and() {
    return p_binary_level(p_eq, ["and"])
}

func p_expr() {
    return p_binary_level(p_and, ["or"])
}

func p_block() {
    let stmts = []
    while (not p_at("}") and not p_at("eof")) {
        if (p_eat("nl")) {
            continue
        }
        append(stmts, p_statement())
    }
    p_expect("}", "Expected '}'")
    return stmts
}

func p_declaration(is_const, is_export) {
    let line = p_tok().line
    let names = []
    let more = true
    while (more) {
        if (not p_at("id")) {
            p_fail("Expected variable name after 'let' or ','")
        }
        append(names, p_next().v)
        more = p_eat(",")
    }
    let vals = []
    if (p_eat("=")) {
        more = true
        while (more) {
            append(vals, p_expr())
            more = p_eat(",")
        }
    }
    if (is_const and len(vals) != len(names)) {
        p_fail("const declarations require an initializer for every name")
    }
    if (len(vals) > 0 and len(vals) != len(names)) {
        p_fail("Variable count ({len(names)}) does not match value count ({len(vals)})")
    }
    let lets = []
    for (let i = 0; i < len(names); i++) {
        let n = node("let", line)
        n.name = names[i]
        n.init = null
        if (len(vals) > 0) {
            n.init = vals[i]
        }
        n.exported = is_export
        n.const_decl = is_const
        append(lets, n)
    }
    if (len(lets) == 1) {
        return lets[0]
    }
    let g = node("group", line)
    g.items = lets
    return g
}

func p_cond_paren(what) {
    p_expect("(", "Expected '(' after {what}")
    let c = p_expr()
    p_expect(")", "Expected ')' after condition")
    return c
}

func p_if(line) {
    let cond = p_cond_paren("if")
    p_eat("nl")
    p_expect("{", "Expected '\{'")
    let n = node("if", line)
    n.cond = cond
    n.then = p_block()
    n.els = []
    p_eat("nl")
    if (p_eat("else")) {
        p_eat("nl")
        if (p_at("if")) {
            n.els = [p_statement()]
        } else {
            p_expect("{", "Expected '\{'")
            n.els = p_block()
        }
    }
    return n
}

func p_for(line) {
    p_expect("(", "Expected '(' after for")
    if (p_at("let")) {
        p_next()
        if (not p_at("id")) {
            p_fail("Expected loop variable name in for loop")
        }
        let name = p_next().v
        if (p_eat("in")) {
            let iter = p_expr()
            p_expect(")", "Expected ')' after for-in iterable")
            p_eat("nl")
            p_expect("{", "Expected '\{' for loop body")
            let n = node("forin", line)
            n.name = name
            n.iter = iter
            n.body = p_block()
            return n
        }
        let init = node("let", line)
        init.name = name
        init.init = null
        init.exported = false
        if (p_eat("=")) {
            init.init = p_expr()
        }
        return p_for_rest(line, init)
    }
    return p_for_rest(line, p_statement())
}

func p_for_rest(line, init) {
    p_expect(";", "Expected ';' after loop initializer")
    let cond = p_expr()
    p_expect(";", "Expected ';' after loop condition")
    let incr = p_statement()
    p_expect(")", "Expected ')' after loop increment")
    p_eat("nl")
    p_expect("{", "Expected '\{' for loop body")
    let n = node("for", line)
    n.init = init
    n.cond = cond
    n.incr = incr
    n.body = p_block()
    return n
}

func p_switch(line) {
    p_expect("(", "Expected '(' after switch")
    let e = p_expr()
    p_expect(")", "Expected ')'")
    p_expect("{", "Expected '\{' starting switch block")
    let cases = []
    let dflt = []
    while (not p_at("}") and not p_at("eof")) {
        let cline = p_tok().line
        if (p_eat("case")) {
            let v = p_expr()
            p_expect(":", "Expected ':' after case value")
            let body = p_case_body()
            append(cases, {"value": v, "body": body, "line": cline})
        } else if (p_eat("default")) {
            p_expect(":", "Expected ':' after default")
            dflt = p_case_body()
        } else if (p_eat("nl")) {
            continue
        } else {
            p_fail("Expected 'case' or 'default' inside switch")
        }
    }
    p_expect("}", "Expected '}' ending switch")
    let n = node("switch", line)
    n.e = e
    n.cases = cases
    n.dflt = dflt
    return n
}

func p_case_body() {
    let body = []
    while (not p_at("case") and not p_at("default") and not p_at("}")) {
        if (p_eat("nl")) {
            continue
        }
        append(body, p_statement())
    }
    return body
}

func compound_op(t) {
    if (t == "+=") {
        return "+"
    }
    if (t == "-=") {
        return "-"
    }
    if (t == "*=") {
        return "*"
    }
    if (t == "/=") {
        return "/"
    }
    return null
}

func p_simple(line) {
    let e = p_expr()
    if (p_eat("=")) {
        let v = p_expr()
        if (e.k == "id") {
            let n = node("assign", line)
            n.name = e.name
            n.e = v
            return n
        }
        return make_setidx(e, v, null, line)
    }
    let op = compound_op(p_tok().t)
    if (op != null) {
        p_next()
        let rhs = p_expr()
        if (e.k == "id") {
            let b = node("bin", line)
            b.op = op
            b.l = e
            b.r = rhs
            let n = node("assign", line)
            n.name = e.name
            n.e = b
            return n
        }
        return make_setidx(e, rhs, op, line)
    }
    return e
}

# target[index] = value  /  target.field = value, with an optional compound op.
func make_setidx(e, v, op, line) {
    let n = node("setidx", line)
    if (e.k == "index") {
        n.target = e.target
        n.index = e.index
    } else if (e.k == "field") {
        n.target = e.target
        n.index = node("str", line)
        n.index.v = e.field
    } else {
        p_fail("Invalid assignment target")
    }
    n.e = v
    n.op = op
    return n
}

func p_typedef(line, word) {
    if (not p_at("id")) {
        p_fail("Expected a name after '{word}'")
    }
    let n = node("typedef", line)
    n.name = p_next().v
    n.is_template = word == "template"
    n.is_bloc = word == "bloc"
    n.fields = []
    p_expect("\{", "Expected '\{' after type name")
    while (not p_at("}") and not p_at("eof")) {
        p_skip_nl()
        if (not p_at("id")) {
            p_fail("Expected field name in {word} declaration")
        }
        append(n.fields, p_next().v)
        p_skip_nl()
        if (not p_eat(",")) {
            break
        }
    }
    p_expect("}", "Expected '}' after {word} fields")
    return n
}

func p_use(line, word) {
    let n = node("use", line)
    n.names = []
    if (word == "use" and p_at("\{")) {
        p_next()
        while (not p_at("}") and not p_at("eof")) {
            if (not p_at("id")) {
                p_fail("Expected exported name inside use list")
            }
            append(n.names, p_next().v)
            if (not p_eat(",")) {
                break
            }
        }
        p_expect("}", "Expected '}' after use list")
        p_expect("from", "Expected 'from' after use list")
    }
    if (not p_at("str")) {
        p_fail("Expected string path after {word}")
    }
    n.path = p_next().v[0]
    return n
}

func p_statement() {
    let tk = p_tok()
    let line = tk.line
    let t = tk.t
    if (t == "func") {
        p_next()
        if (not p_at("id")) {
            p_fail("Expected function name after 'func'")
        }
        let name = p_next().v
        return p_func_rest(name, line, false)
    }
    if (t == "let" or t == "const") {
        p_next()
        return p_declaration(t == "const", false)
    }
    if (t == "export") {
        p_next()
        if (p_at("let") or p_at("const")) {
            let is_const = p_at("const")
            p_next()
            return p_declaration(is_const, true)
        }
        if (p_at("func")) {
            p_next()
            let name = p_next().v
            return p_func_rest(name, line, true)
        }
        if (p_at("data") or p_at("template") or p_at("bloc")) {
            let word = p_next().t
            return p_typedef(line, word)
        }
        p_fail("export can only be used with let, const, func, data or bloc declarations")
    }
    if (t == "use" or t == "import") {
        p_next()
        return p_use(line, t)
    }
    if (t == "data" or t == "template" or t == "bloc") {
        p_next()
        return p_typedef(line, t)
    }
    if (t == "unsafe") {
        p_next()
        p_eat("nl")
        p_expect("\{", "Expected '\{' after unsafe")
        let n = node("unsafe", line)
        n.body = p_block()
        return n
    }
    if (t == "print") {
        p_next()
        p_expect("(", "Expected '(' after print")
        let args = []
        if (not p_at(")")) {
            let more = true
            while (more) {
                append(args, p_expr())
                more = p_eat(",")
            }
        }
        p_expect(")", "Expected ')' after print args")
        let n = node("print", line)
        n.args = args
        return n
    }
    if (t == "return") {
        p_next()
        let n = node("return", line)
        n.e = null
        if (not p_at("}") and not p_at("nl") and not p_at("eof")) {
            n.e = p_expr()
        }
        return n
    }
    if (t == "break") {
        p_next()
        return node("break", line)
    }
    if (t == "continue") {
        p_next()
        return node("continue", line)
    }
    if (t == "if") {
        p_next()
        return p_if(line)
    }
    if (t == "while") {
        p_next()
        let cond = p_cond_paren("while")
        p_eat("nl")
        p_expect("{", "Expected '\{'")
        let n = node("while", line)
        n.cond = cond
        n.body = p_block()
        return n
    }
    if (t == "for") {
        p_next()
        return p_for(line)
    }
    if (t == "switch") {
        p_next()
        return p_switch(line)
    }
    return p_simple(line)
}

export func parse_program(toks) {
    P_toks = toks
    P_pos = 0
    let stmts = []
    while (not p_at("eof")) {
        if (p_eat("nl")) {
            continue
        }
        append(stmts, p_statement())
    }
    return stmts
}
