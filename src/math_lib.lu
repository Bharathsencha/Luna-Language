# math_lib.lu: math builtins.

use { HOST, spec } from "library.lu"

export func register_math() {
    spec("abs", 1, 1, "n")
    spec("min", 2, 2, "nn")
    spec("max", 2, 2, "nn")
    spec("clamp", 3, 3, "nnn")
    spec("sign", 1, 1, "n")
    spec("pow", 2, 2, "nn")
    spec("atan2", 2, 2, "nn")
    spec("mod", 2, 2, "nn")
    spec("lerp", 3, 3, "nnn")
    spec("rand", 0, 2, "nn")
    spec("srand", 0, 1, "n")
    spec("trand", 0, 0, "")
    for (let name in split("sqrt cbrt exp ln log10 sin cos tan asin acos atan sinh cosh tanh floor ceil round trunc fract deg_to_rad rad_to_deg", " ")) {
        spec(name, 1, 1, "n")
    }

    HOST["abs"] = abs
    HOST["acos"] = acos
    HOST["asin"] = asin
    HOST["atan"] = atan
    HOST["atan2"] = atan2
    HOST["cbrt"] = cbrt
    HOST["ceil"] = ceil
    HOST["clamp"] = clamp
    HOST["cos"] = cos
    HOST["cosh"] = cosh
    HOST["deg_to_rad"] = deg_to_rad
    HOST["exp"] = exp
    HOST["floor"] = floor
    HOST["fract"] = fract
    HOST["lerp"] = lerp
    HOST["ln"] = ln
    HOST["log10"] = log10
    HOST["max"] = max
    HOST["min"] = min
    HOST["mod"] = mod
    HOST["pow"] = pow
    HOST["rad_to_deg"] = rad_to_deg
    HOST["round"] = round
    HOST["sign"] = sign
    HOST["sin"] = sin
    HOST["sinh"] = sinh
    HOST["sqrt"] = sqrt
    HOST["tan"] = tan
    HOST["tanh"] = tanh
    HOST["trunc"] = trunc
    HOST["rand"] = rand
    HOST["srand"] = srand
    HOST["trand"] = trand
}
