# value.lu: value kinds, to-string, equality and arithmetic.

use { rt_error, type_error } from "error.lu"
use { HOOK } from "state.lu"

func hook_bloc_equal(a, b) {
    let f = HOOK["bloc_equal"]
    return f(a, b)
}

func hook_ptr_compare_check(a, b, op) {
    let f = HOOK["ptr_compare_check"]
    return f(a, b, op)
}

func hook_ptr_address(p) {
    let f = HOOK["ptr_address"]
    return f(p)
}

func hook_box_text(b) {
    let f = HOOK["box_text"]
    return f(b)
}

let MAX_INT = 9223372036854775807

let MIN_INT = -9223372036854775807 - 1

export func vkind(v) {
    let t = type(v)
    if (t == "map") {
        let k = v["@k"]
        if (k != null) {
            return k
        }
        return "map"
    }
    return t
}

# The type name used in error messages (value_type_name in the VM).
export func tname(v) {
    let k = vkind(v)
    if (k == "long") {
        return "int"
    }
    if (k == "fn") {
        return "function"
    }
    if (k == "native") {
        return "native_function"
    }
    if (k == "bloctype") {
        return "bloc_type"
    }
    if (k == "dtype") {
        return "data_type"
    }
    if (k == "tpl") {
        return "template"
    }
    if (k == "ptr") {
        return "pointer"
    }
    return k
}

# The name type() returns.
export func type_name(v) {
    let k = vkind(v)
    if (k == "fn") {
        return "function"
    }
    if (k == "native") {
        return "native_function"
    }
    if (k == "bloctype") {
        return "bloc_type"
    }
    if (k == "dtype") {
        return "data_type"
    }
    if (k == "tpl") {
        return "template"
    }
    if (k == "ptr") {
        return "pointer"
    }
    return k
}

export func is_int(v) {
    let t = type(v)
    return t == "int" or t == "long"
}

export func is_num(v) {
    let t = type(v)
    return t == "int" or t == "long" or t == "float"
}

func is_listish(v) {
    return type(v) == "list"
}

# True when a list holds nothing that needs the interpreter's own formatting.
func plain_list(v) {
    for (let x in v) {
        let t = type(x)
        if (t == "map" or t == "list") {
            return false
        }
    }
    return true
}

export func tostr(v) {
    let t = type(v)
    if (t == "string") {
        return v
    }
    if (t == "list") {
        if (plain_list(v)) {
            return to_string(v)
        }
        let parts = []
        for (let x in v) {
            append(parts, tostr(x))
        }
        let body = join(parts, ", ")
        return "[{body}]"
    }
    if (t == "map") {
        let k = v["@k"]
        if (k == null) {
            return tostr_map(v)
        }
        return tostr_special(k, v)
    }
    if (t == "file") {
        return "<file handle>"
    }
    return to_string(v)
}

func tostr_map(m) {
    let parts = []
    for (let key in map_keys(m)) {
        let shown = tostr(m[key])
        append(parts, "\"{key}\": {shown}")
    }
    let body = join(parts, ", ")
    return "\{{body}}"
}

func tostr_special(k, v) {
    if (k == "fn") {
        return "<vm closure>"
    }
    if (k == "native") {
        return "<native function>"
    }
    if (k == "bloc") {
        let parts = []
        let d = v.desc
        for (let i = 0; i < len(d.fields); i++) {
            append(parts, "{d.fields[i]}: {tostr(v.vals[i])}")
        }
        let body = join(parts, ", ")
        return "{d.name}\{{body}}"
    }
    if (k == "bloctype") {
        return "<bloc {v.desc.name}>"
    }
    if (k == "dtype") {
        return "<data {v.name}>"
    }
    if (k == "tpl") {
        let parts = []
        let dt = v.dt
        for (let i = 0; i < len(dt.fields); i++) {
            append(parts, "{dt.fields[i]}: {tostr(v.vals[i])}")
        }
        let body = join(parts, ", ")
        return "{dt.name}\{{body}}"
    }
    if (k == "box") {
        return hook_box_text(v)
    }
    if (k == "ptr") {
        return "ptr(0x{hex(hook_ptr_address(v))})"
    }
    return "<{k}>"
}

func hex(n) {
    if (n == 0) {
        return "0"
    }
    let digits = "0123456789abcdef"
    let out = []
    while (n > 0) {
        append(out, "{digits[n % 16]}")
        n = n / 16
    }
    return join(reverse_list(out), "")
}

func reverse_list(l) {
    let out = []
    let i = len(l) - 1
    while (i >= 0) {
        append(out, l[i])
        i -= 1
    }
    return out
}

export func truth(v) {
    if (type(v) == "boolean") {
        return v
    }
    type_error("condition must be a boolean, got {tname(v)}", "Write the test explicitly, for example x != 0, len(s) > 0 or v != null.")
}

func family(v) {
    let k = vkind(v)
    if (k == "int" or k == "long" or k == "float") {
        return "number"
    }
    if (k == "list") {
        return "list"
    }
    if (k == "fn" or k == "native") {
        return "function"
    }
    return k
}

# == without the type check (used by switch after the check, and by builtins).
func raw_equal(l, r) {
    let lk = vkind(l)
    if (lk == "bloc") {
        return hook_bloc_equal(l, r)
    }
    if (lk == "box") {
        return l.h == r.h
    }
    if (lk == "ptr") {
        return hook_ptr_address(l) == hook_ptr_address(r)
    }
    if (lk == "native") {
        return l.name == r.name
    }
    return l == r
}

export func values_equal(l, r) {
    if (l == null or r == null) {
        return l == null and r == null
    }
    if (family(l) != family(r)) {
        type_error("cannot compare {tname(l)} with {tname(r)}", "Compare values of the same type (comparing with null is always allowed).")
    }
    if (type(l) == "list") {
        return l == r
    }
    return raw_equal(l, r)
}

# -1, 0 or 1 for numbers, strings, chars and pointers.
func order_of(l, r) {
    let lt = type(l)
    let rt = type(r)
    if (is_num(l) and is_num(r)) {
        if (l < r) {
            return -1
        }
        if (l > r) {
            return 1
        }
        return 0
    }
    if ((lt == "string" and rt == "string") or (lt == "char" and rt == "char")) {
        if (l < r) {
            return -1
        }
        if (l > r) {
            return 1
        }
        return 0
    }
    if (vkind(l) == "ptr" and vkind(r) == "ptr") {
        let a = hook_ptr_address(l)
        let b = hook_ptr_address(r)
        if (a < b) {
            return -1
        }
        if (a > b) {
            return 1
        }
        return 0
    }
    type_error("cannot order {tname(l)} and {tname(r)} with <, <=, > or >=", "Ordering works on two numbers, two strings or two chars.")
}

func overflow_error(op) {
    rt_error("integer overflow in '{op}'", "The result does not fit in a 64-bit int. Use floats for very large numbers.")
}

func div_zero_error() {
    rt_error("division by zero", "Check the divisor before dividing.")
}

func operand_error(op, l, r) {
    let hint = "Both sides must be numbers."
    if (op == "+") {
        hint = "Both sides must be numbers, or both strings. Build text with \"\{x}\" or to_string(x)."
    }
    type_error("cannot use '{op}' on {tname(l)} and {tname(r)}", hint)
}

func int_arith(op, l, r) {
    if (op == "+") {
        if ((r > 0 and l > MAX_INT - r) or (r < 0 and l < MIN_INT - r)) {
            overflow_error("+")
        }
        return l + r
    }
    if (op == "-") {
        if ((r < 0 and l > MAX_INT + r) or (r > 0 and l < MIN_INT + r)) {
            overflow_error("-")
        }
        return l - r
    }
    if (op == "*") {
        if (l > 0) {
            if (r > 0) {
                if (l > MAX_INT / r) {
                    overflow_error("*")
                }
            } else if (r < MIN_INT / l) {
                overflow_error("*")
            }
        } else {
            if (r > 0) {
                if (l < MIN_INT / r) {
                    overflow_error("*")
                }
            } else if (l != 0 and r < MAX_INT / l) {
                overflow_error("*")
            }
        }
        return l * r
    }
    if (op == "/") {
        if (r == 0) {
            div_zero_error()
        }
        if (l == MIN_INT and r == -1) {
            overflow_error("/")
        }
        return l / r
    }
    if (r == 0) {
        div_zero_error()
    }
    if (r == -1) {
        return 0
    }
    return l % r
}

export func arith(op, l, r) {
    let lt = type(l)
    let rt = type(r)
    let li = lt == "int" or lt == "long"
    let ri = rt == "int" or rt == "long"
    if (li and ri) {
        return int_arith(op, l, r)
    }
    let ln = li or lt == "float"
    let rn = ri or rt == "float"
    if (ln and rn) {
        if (op == "/" or op == "%") {
            if (r == 0) {
                div_zero_error()
            }
        }
        if (op == "+") {
            return l + r
        }
        if (op == "-") {
            return l - r
        }
        if (op == "*") {
            return l * r
        }
        if (op == "/") {
            return l / r
        }
        return l % r
    }
    if (lt == "list" and rt == "list") {
        if (op == "+") {
            return l + r
        }
        if (op == "-") {
            return l - r
        }
        if (op == "*") {
            return l * r
        }
        if (op == "/") {
            return l / r
        }
    }
    if (op == "+" and lt == "string" and rt == "string") {
        return l + r
    }
    operand_error(op, l, r)
}

export func binary(op, l, r) {
    if (op == "+" or op == "-" or op == "*" or op == "/" or op == "%") {
        return arith(op, l, r)
    }
    if (op == "==") {
        if (vkind(l) == "ptr") {
            hook_ptr_compare_check(l, r, 0)
        }
        return values_equal(l, r)
    }
    if (op == "!=") {
        if (vkind(l) == "ptr") {
            hook_ptr_compare_check(l, r, 1)
        }
        return not values_equal(l, r)
    }
    if (vkind(l) == "ptr") {
        let code = 2
        if (op == ">") {
            code = 3
        } else if (op == "<=") {
            code = 4
        } else if (op == ">=") {
            code = 5
        }
        hook_ptr_compare_check(l, r, code)
    }
    let c = order_of(l, r)
    if (op == "<") {
        return c < 0
    }
    if (op == "<=") {
        return c <= 0
    }
    if (op == ">") {
        return c > 0
    }
    return c >= 0
}

export func repeat_list(v, count) {
    let out = []
    for (let i = 0; i < count; i++) {
        append(out, v)
    }
    return out
}
