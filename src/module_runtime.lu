# module_runtime.lu: use / import: path resolution, module cache, running modules.

use { name_error } from "error.lu"
use { lex } from "lexer.lu"
use { parse_program } from "parser.lu"
use { exec_list, global_scope, leave_scope } from "interpreter.lu"
use { define_type } from "data_runtime.lu"
use { RT } from "state.lu"

export func new_module_record(path, canon, text) {
    return {"path": path, "canon": canon, "lines": split_lines(text), "globals": null,
            "exports": [], "state": 0, "id": 0}
}

# split() drops empty lines and treats every delimiter character separately,
# so lines are cut by hand.
func split_lines(text) {
    let lines = []
    let start = 0
    let n = len(text)
    for (let i = 0; i < n; i++) {
        if (text[i] == '\n') {
            append(lines, slice(text, start, i))
            start = i + 1
        }
    }
    if (start < n) {
        append(lines, slice(text, start, n))
    }
    return lines
}

export let MODULES = {}

let MODULE_COUNT = 0

func path_dir(p) {
    let i = last_index_of(p, "/")
    if (i < 0) {
        return ""
    }
    if (i == 0) {
        return "/"
    }
    return slice(p, 0, i)
}

func path_join(dir, rel) {
    if (starts_with(rel, "/") or dir == "") {
        return rel
    }
    if (dir == "/") {
        return "/{rel}"
    }
    return "{dir}/{rel}"
}

# Resolves "." and ".." segments.
export func path_norm(p) {
    let absolute = starts_with(p, "/")
    let out = []
    for (let seg in split(p, "/")) {
        if (seg == "." or seg == "") {
            continue
        }
        if (seg == ".." and len(out) > 0 and out[len(out) - 1] != "..") {
            remove(out, len(out) - 1)
        } else if (seg == ".." and absolute) {
            continue
        } else {
            append(out, seg)
        }
    }
    let joined = join(out, "/")
    if (absolute) {
        return "/{joined}"
    }
    return joined
}

export func collect_exports(stmts, out) {
    for (let s in stmts) {
        if (s.k == "group") {
            collect_exports(s.items, out)
        } else if ((s.k == "let" or s.k == "func") and s.exported and s.name != null) {
            append(out, s.name)
        }
    }
}

export func read_source(path) {
    let f = open(path, "r")
    if (f == null) {
        return null
    }
    let text = read(f)
    close(f)
    return text
}

# Runs a module's statements in its own global scope.
export func run_module(m, stmts) {
    let saved_cur = RT.cur
    let saved_line = RT.cur_line
    let saved_func = RT.func_depth
    RT.cur = m
    RT.func_depth = 0
    let g = {"@p": null, "@g": true}
    m.globals = g
    if (m.id == 0) {
        for (let s in stmts) {
            if (s.k == "typedef") {
                RT.cur_line = s.line
                let t = define_type(s)
                g[s.name] = [t]
            }
        }
    }
    let st = exec_list(stmts, g)
    leave_scope(g)
    RT.cur = saved_cur
    RT.cur_line = saved_line
    RT.func_depth = saved_func
}

export func ex_use(n, sc) {
    RT.cur_line = n.line
    let canon = path_norm(path_join(path_dir(RT.cur.canon), n.path))
    let m = MODULES[canon]
    if (m != null and m.state == 1) {
        name_error("Circular import detected: '{n.path}' is already loading", "Modules must not import each other in a cycle; move shared code to a third module")
    }
    if (m == null) {
        let text = read_source(canon)
        if (text == null) {
            name_error("Could not import file '{n.path}'", "Check that the import path exists and ends with .lu")
        }
        MODULE_COUNT += 1
        m = new_module_record(canon, canon, text)
        m.id = MODULE_COUNT
        MODULES[canon] = m
        let saved = RT.cur
        RT.cur = m
        let stmts = parse_program(lex(text, 1))
        RT.cur = saved
        collect_exports(stmts, m.exports)
        m.state = 1
        run_module(m, stmts)
        m.state = 2
    }
    let names = n.names
    if (len(names) == 0) {
        names = m.exports
    }
    let target = global_scope(sc)
    for (let name in names) {
        if (find(m.exports, name) < 0) {
            name_error("Module '{n.path}' does not export '{name}'", "Export names explicitly in the module before using them")
        }
        let b = m.globals[name]
        if (b == null) {
            name_error("Export '{name}' is missing from module '{n.path}'", "Make sure the exported value is defined at module top level")
        }
        target[name] = [b[0]]
    }
    return 0
}
