# list_lib.lu: list, map and vector builtins.

use { tname } from "value.lu"
use { arg_error, type_error } from "error.lu"
use { call_value } from "interpreter.lu"
use { HOST, IMPL, loose_truth, spec } from "library.lu"
use { container_check } from "box.lu"

func b_append(a) {
    container_check(a[1])
    append(a[0], a[1])
    return null
}

func b_range(a) {
    let n = len(a)
    let step = 1
    if (n == 3) {
        step = a[2]
    }
    if (step == 0) {
        arg_error("range() step must not be 0", null)
    }
    if (n == 1) {
        return range(a[0])
    }
    if (n == 2) {
        return range(a[0], a[1])
    }
    return range(a[0], a[1], a[2])
}

func b_map(a) {
    let out = []
    for (let x in a[0]) {
        append(out, call_value(a[1], [x], null))
    }
    return out
}

func b_filter(a) {
    let out = []
    for (let x in a[0]) {
        if (loose_truth(call_value(a[1], [x], null))) {
            append(out, x)
        }
    }
    return out
}

func b_reduce(a) {
    let acc = a[2]
    for (let x in a[0]) {
        acc = call_value(a[1], [acc, x], null)
    }
    return acc
}

func b_slice(a) {
    let t = type(a[0])
    if (t != "list" and t != "string") {
        type_error("slice() argument 1 must be a string, got {tname(a[0])}", null)
    }
    return slice(a[0], a[1], a[2])
}

export func register_list() {
    spec("append", 2, 2, "la")
    spec("list_append", 2, 2, "la")
    spec("range", 1, 3, "iii")
    spec("map_set", 3, 3, "msa")
    spec("map_get", 2, 2, "ms")
    spec("map_has", 2, 2, "ms")
    spec("map_delete", 2, 2, "ms")
    spec("map_keys", 1, 1, "m")
    spec("map_values", 1, 1, "m")
    spec("map_items", 1, 1, "m")
    spec("remove", 2, 2, "li")
    spec("find", 2, 2, "la")
    spec("slice", 3, 3, "aii")
    spec("sort", 1, 1, "l")
    spec("shuffle", 0, 99, "")
    spec("ssort", 0, 99, "")
    spec("map", 2, 2, "la")
    spec("filter", 2, 2, "la")
    spec("reduce", 3, 3, "laa")
    spec("dense_list", 0, 99, "")
    spec("vec_add", 0, 99, "")
    spec("vec_sub", 0, 99, "")
    spec("vec_mul", 0, 99, "")
    spec("vec_div", 0, 99, "")
    spec("vec_mul_inline", 0, 99, "")
    spec("mat_mul", 0, 99, "")

    HOST["find"] = find
    HOST["remove"] = remove
    HOST["sort"] = sort
    HOST["shuffle"] = shuffle
    HOST["ssort"] = ssort
    HOST["dense_list"] = dense_list
    HOST["vec_add"] = vec_add
    HOST["vec_sub"] = vec_sub
    HOST["vec_mul"] = vec_mul
    HOST["vec_div"] = vec_div
    HOST["vec_mul_inline"] = vec_mul_inline
    HOST["mat_mul"] = mat_mul
    HOST["map_set"] = map_set
    HOST["map_get"] = map_get
    HOST["map_has"] = map_has
    HOST["map_delete"] = map_delete
    HOST["map_keys"] = map_keys
    HOST["map_values"] = map_values
    HOST["map_items"] = map_items
    IMPL["append"] = b_append
    IMPL["list_append"] = b_append
    IMPL["range"] = b_range
    IMPL["map"] = b_map
    IMPL["filter"] = b_filter
    IMPL["reduce"] = b_reduce
    IMPL["slice"] = b_slice
}
