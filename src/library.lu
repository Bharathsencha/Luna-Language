#
# library.lu: builtin tables, argument checks and the core builtins.
#
# SPEC gives each builtin's argument count and a letter per argument:
#   a any, s string (a char is accepted), i int, n number, l list, m map, f file.
# Builtins that touch the interpreter's own value kinds are written out in the
# *_lib.lu files; the rest call the host's builtin of the same name (HOST).
# Each *_lib.lu file has a register_*() that fills SPEC, HOST and IMPL.

use { is_int, is_num, tname, tostr, type_name, vkind } from "value.lu"
use { arg_error, fail, out_line, out_text, rt_error, type_error } from "error.lu"
use { arity_error, undefined_var } from "interpreter.lu"
use { box_length } from "box.lu"
use { is_registered_pointer, ptr_address, ptr_cast_check } from "unsafe_runtime.lu"
use { RT } from "state.lu"

export let SPEC = {}
export let HOST = {}
export let IMPL = {}

export func spec(name, lo, hi, kinds) {
    SPEC[name] = [lo, hi, kinds]
}

func kind_phrase(letter) {
    if (letter == "s") {
        return "a string"
    }
    if (letter == "i") {
        return "an int"
    }
    if (letter == "n") {
        return "a number"
    }
    if (letter == "l") {
        return "a list"
    }
    if (letter == "m") {
        return "a map"
    }
    return "a file"
}

func arg_matches(letter, v) {
    if (letter == "s") {
        return type(v) == "string"
    }
    if (letter == "i") {
        return is_int(v)
    }
    if (letter == "n") {
        return is_num(v)
    }
    if (letter == "l") {
        return type(v) == "list"
    }
    if (letter == "m") {
        return vkind(v) == "map"
    }
    if (letter == "f") {
        return type(v) == "file"
    }
    return true
}

# Checks the arguments against SPEC and turns chars into strings where a string
# is wanted. Returns the (possibly rewritten) argument list.
func check_args(name, args) {
    let sp = SPEC[name]
    let na = len(args)
    if (na < sp[0] or na > sp[1]) {
        arity_error(name, na, sp[0], sp[1])
    }
    let kinds = sp[2]
    let out = args
    for (let i = 0; i < len(kinds) and i < na; i++) {
        let letter = "{kinds[i]}"
        let v = args[i]
        if (letter == "s" and type(v) == "char") {
            if (out == args) {
                out = slice(args, 0, na)
            }
            out[i] = "{v}"
        } else if (not arg_matches(letter, v)) {
            type_error("{name}() argument {i + 1} must be {kind_phrase(letter)}, got {tname(v)}", null)
        }
    }
    return out
}

export func call_builtin(name, args) {
    let sp = SPEC[name]
    if (sp == null) {
        undefined_var(name)
    }
    let a = check_args(name, args)
    let h = IMPL[name]
    if (h != null) {
        return h(a)
    }
    let f = HOST[name]
    let n = len(a)
    if (n == 0) {
        return f()
    }
    if (n == 1) {
        return f(a[0])
    }
    if (n == 2) {
        return f(a[0], a[1])
    }
    return f(a[0], a[1], a[2])
}

# Truthiness as assert() and filter() use it (looser than a condition).
export func loose_truth(v) {
    let t = type(v)
    if (t == "boolean") {
        return v
    }
    if (t == "int" or t == "long") {
        return v != 0
    }
    if (t == "float") {
        return v != 0.0
    }
    if (t == "string") {
        return len(v) > 0
    }
    if (t == "char") {
        return int(v) != 0
    }
    if (t == "null") {
        return false
    }
    if (vkind(v) == "ptr") {
        return ptr_address(v) != 0
    }
    return true
}

func b_len(a) {
    let v = a[0]
    let t = type(v)
    if (t == "string" or t == "list") {
        return len(v)
    }
    if (t == "map") {
        let k = v["@k"]
        if (k == null) {
            return len(v)
        }
        if (k == "tpl") {
            return len(v.vals)
        }
        if (k == "box") {
            return box_length(v)
        }
    }
    type_error("len() needs a string, list or map, got {tname(v)}", null)
}

func b_type(a) {
    let v = a[0]
    let t = type(v)
    if (t == "map") {
        return type_name(v)
    }
    return t
}

func b_int(a) {
    let v = a[0]
    let k = vkind(v)
    if (k == "ptr") {
        if (is_registered_pointer(v)) {
            return ptr_address(v)
        }
    }
    if (k == "int" or k == "long") {
        return v
    }
    if (k == "float") {
        if (not (v > -9300000000000000000.0 and v < 9300000000000000000.0)) {
            rt_error("int() of a float that does not fit in 64 bits", null)
        }
        return int(v)
    }
    if (k == "char" or k == "boolean" or k == "string") {
        return int(v)
    }
    type_error("int() cannot convert {tname(v)}", null)
}

func b_float(a) {
    let v = a[0]
    let k = vkind(v)
    if (k == "ptr") {
        ptr_cast_check(v, 1)
    }
    if (k == "int" or k == "long" or k == "float" or k == "char" or k == "boolean" or k == "string") {
        return float(v)
    }
    type_error("float() cannot convert {tname(v)}", null)
}

func b_to_string(a) {
    return tostr(a[0])
}

func b_to_int(a) {
    if (type(a[0]) == "string") {
        return to_int(a[0])
    }
    return b_int(a)
}

func b_to_float(a) {
    return b_float(a)
}

func b_assert(a) {
    if (len(a) != 1) {
        arg_error("assert() takes exactly 1 argument", "Use assert(condition) to verify logic.")
    }
    if (not loose_truth(a[0])) {
        fail("Assertion Error", "Assertion failed", "The condition evaluated to false.")
    }
    return true
}

func b_input(a) {
    if (len(a) == 1) {
        out_text(tostr(a[0]))
    }
    return input("")
}

func b_debug(a) {
    out_line("value = {tostr(a[0])}")
    return a[0]
}

func b_args(a) {
    return slice(RT.script_args, 0, len(RT.script_args))
}

func b_exit(a) {
    if (len(a) == 1) {
        exit(a[0])
    }
    exit(0)
}

export func register_core() {
    spec("len", 1, 1, "a")
    spec("str_len", 1, 1, "a")
    spec("type", 1, 1, "a")
    spec("int", 1, 1, "a")
    spec("float", 1, 1, "a")
    spec("to_string", 1, 1, "a")
    spec("to_int", 1, 1, "a")
    spec("to_float", 1, 1, "a")
    spec("assert", 0, 99, "")
    spec("input", 0, 1, "a")
    spec("debug", 1, 1, "a")
    spec("args", 0, 0, "")
    spec("exit", 0, 1, "i")
    spec("clock", 0, 0, "")

    HOST["clock"] = clock
    IMPL["len"] = b_len
    IMPL["str_len"] = b_len
    IMPL["type"] = b_type
    IMPL["int"] = b_int
    IMPL["float"] = b_float
    IMPL["to_string"] = b_to_string
    IMPL["to_int"] = b_to_int
    IMPL["to_float"] = b_to_float
    IMPL["assert"] = b_assert
    IMPL["input"] = b_input
    IMPL["debug"] = b_debug
    IMPL["args"] = b_args
    IMPL["exit"] = b_exit
}
