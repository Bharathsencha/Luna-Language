# statements.lu: statement handlers (let, if, while, for, switch, ...).

use { arith, tostr, truth, values_equal } from "value.lu"
use { fail, out_line, type_error } from "error.lu"
use { EV, assign_var, define_var, exec_list, exec_one, index_get } from "interpreter.lu"
use { index_set, leave_scope, make_closure, run_block } from "interpreter.lu"
use { box_escape_check } from "box.lu"
use { unsafe_begin, unsafe_end } from "unsafe_runtime.lu"
use { RT } from "state.lu"

export func ex_let(n, sc) {
    let v = null
    if (n.init != null) {
        v = EV[n.init.k](n.init, sc)
    }
    define_var(sc, n.name, v)
    return 0
}

export func ex_group(n, sc) {
    for (let item in n.items) {
        ex_let(item, sc)
    }
    return 0
}

export func ex_func(n, sc) {
    let f = make_closure(n, sc)
    define_var(sc, n.name, f)
    return 0
}

export func ex_assign(n, sc) {
    let v = EV[n.e.k](n.e, sc)
    assign_var(sc, n.name, v)
    return 0
}

export func ex_setidx(n, sc) {
    let t = EV[n.target.k](n.target, sc)
    let i = EV[n.index.k](n.index, sc)
    let v = EV[n.e.k](n.e, sc)
    RT.cur_line = n.line
    if (n.op != null) {
        let cur = index_get(t, i)
        v = arith(n.op, cur, v)
    }
    index_set(t, i, v)
    return 0
}

export func ex_print(n, sc) {
    for (let a in n.args) {
        let v = EV[a.k](a, sc)
        RT.cur_line = n.line
        out_line(tostr(v))
    }
    return 0
}

export func ex_return(n, sc) {
    let v = null
    if (n.e != null) {
        v = EV[n.e.k](n.e, sc)
    }
    RT.cur_line = n.line
    if (RT.func_depth > 0) {
        box_escape_check(v, "returned from a function")
    }
    RT.retv = v
    return 3
}

export func ex_break(n, sc) {
    return 1
}

export func ex_continue(n, sc) {
    return 2
}

export func ex_if(n, sc) {
    let c = truth(EV[n.cond.k](n.cond, sc))
    if (c) {
        return run_block(n.then, sc)
    }
    if (len(n.els) > 0) {
        return run_block(n.els, sc)
    }
    return 0
}

export func ex_while(n, sc) {
    while (true) {
        RT.cur_line = n.line
        let c = truth(EV[n.cond.k](n.cond, sc))
        if (not c) {
            break
        }
        let st = run_block(n.body, sc)
        if (st == 1) {
            break
        }
        if (st == 3) {
            return 3
        }
    }
    return 0
}

export func ex_for(n, sc) {
    let ls = {"@p": sc}
    exec_one(n.init, ls)
    let result = 0
    while (true) {
        RT.cur_line = n.line
        let c = truth(EV[n.cond.k](n.cond, ls))
        if (not c) {
            break
        }
        let st = run_block(n.body, ls)
        if (st == 1) {
            break
        }
        if (st == 3) {
            result = 3
            break
        }
        exec_one(n.incr, ls)
    }
    leave_scope(ls)
    return result
}

export func ex_forin(n, sc) {
    let it = EV[n.iter.k](n.iter, sc)
    RT.cur_line = n.line
    let t = type(it)
    if (t != "list" and t != "string") {
        type_error("for-in expects a list, dense list, or string", "Use for (let item in list) \{ ... }")
    }
    let count = len(it)
    let i = 0
    let result = 0
    while (i < count) {
        if (i >= len(it)) {
            fail("Index Error", "Index {i} is out of bounds for {t} of length {len(it)}", "Ensure your index is between 0 and len-1")
        }
        let isc = {"@p": sc}
        isc[n.name] = [it[i]]
        let st = exec_list(n.body, isc)
        leave_scope(isc)
        if (st == 1) {
            break
        }
        if (st == 3) {
            result = 3
            break
        }
        i += 1
    }
    return result
}

export func ex_switch(n, sc) {
    let v = EV[n.e.k](n.e, sc)
    for (let c in n.cases) {
        let cv = EV[c.value.k](c.value, sc)
        RT.cur_line = c.line
        if (values_equal(v, cv)) {
            let st = run_block(c.body, sc)
            if (st == 1) {
                return 0
            }
            return st
        }
    }
    let st = run_block(n.dflt, sc)
    if (st == 1) {
        return 0
    }
    return st
}

export func ex_unsafe(n, sc) {
    unsafe_begin()
    let st = run_block(n.body, sc)
    unsafe_end()
    return st
}
