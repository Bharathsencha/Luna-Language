#
# state.lu: state shared between modules, and the hook table.

# State shared between modules. An imported name is a copy, so a value that several
# modules assign lives in this map, not in a top-level variable.
#   cur           the module record whose source is being run or parsed
#   cur_line      the line being executed
#   retv          value of the return statement being unwound
#   func_depth    > 0 while a user function body is running
#   unsafe_depth  > 0 while an unsafe block is running
#   script_args   arguments after the program path
export let RT = {"cur": null, "cur_line": 0, "retv": null, "func_depth": 0,
                 "unsafe_depth": 0, "script_args": []}

# Functions that a lower layer must call but cannot import. main.lu fills this in.
export let HOOK = {}
