# memory_lib.lu: alloc, free, load, store, defer and shape.

use { IMPL, spec } from "library.lu"
use { shape_of } from "data_runtime.lu"
use { b_free } from "box.lu"
use { b_alloc, b_load, b_ptr_offset, b_store, defer_pointer } from "unsafe_runtime.lu"

func b_shape(a) {
    return shape_of(a[0])
}

func b_defer(a) {
    return defer_pointer(a[0])
}

export func register_memory() {
    spec("shape", 1, 1, "a")
    spec("alloc", 1, 1, "a")
    spec("free", 1, 1, "a")
    spec("load", 1, 1, "a")
    spec("deref", 1, 1, "a")
    spec("store", 2, 2, "aa")
    spec("ptr_offset", 2, 2, "aa")
    spec("ptr_add", 2, 2, "aa")
    spec("defer", 1, 1, "a")

    IMPL["shape"] = b_shape
    IMPL["defer"] = b_defer
    IMPL["alloc"] = b_alloc
    IMPL["free"] = b_free
    IMPL["load"] = b_load
    IMPL["deref"] = b_load
    IMPL["store"] = b_store
    IMPL["ptr_offset"] = b_ptr_offset
    IMPL["ptr_add"] = b_ptr_offset
}
