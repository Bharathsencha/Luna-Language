#
# main.lu: entry point: tables, hooks, argument handling and the run of a program.
#
# Luna implemented in Luna. Run a program with:
#
#   luna src/main.lu program.lu [arguments...]
#
# Values of the interpreted program are host values: ints, floats, strings,
# chars, bools, null, lists and maps are the interpreter's own. Everything else
# (functions, blocs, templates, boxes, pointers, types) is a map that carries a
# "@k" key naming its kind.
#
# Names such as data, from, in, input and print are keywords in Luna, so these
# files never use them as identifiers. A literal { inside a string is written \{.

use { vkind } from "value.lu"
use { err_text, format_error, io_init } from "error.lu"
use { MODULES, collect_exports, ex_use, new_module_record, path_norm, read_source } from "module_runtime.lu"
use { run_module } from "module_runtime.lu"
use { lex } from "lexer.lu"
use { node, parse_program } from "parser.lu"
use { EV, EX, NATIVES, call_fn } from "interpreter.lu"
use { ex_assign, ex_break, ex_continue, ex_for, ex_forin, ex_func } from "statements.lu"
use { ex_group, ex_if, ex_let, ex_print, ex_return, ex_setidx } from "statements.lu"
use { ex_switch, ex_unsafe, ex_while } from "statements.lu"
use { ev_bin, ev_box, ev_call, ev_const, ev_field, ev_func } from "expressions.lu"
use { ev_id, ev_incdec, ev_index, ev_input, ev_list, ev_map } from "expressions.lu"
use { ev_not, ev_tmpl } from "expressions.lu"
use { SPEC, call_builtin, register_core } from "library.lu"
use { register_list } from "list_lib.lu"
use { register_string } from "string_lib.lu"
use { register_file } from "file_lib.lu"
use { register_memory } from "memory_lib.lu"
use { bloc_equal } from "data_runtime.lu"
use { box_text } from "box.lu"
use { ptr_address, ptr_compare_check } from "unsafe_runtime.lu"
use { lint_program } from "lint.lu"
use { register_math } from "math_lib.lu"
use { HOOK, RT } from "state.lu"

func init_hooks() {
    HOOK["box_text"] = box_text
    HOOK["ptr_address"] = ptr_address
    HOOK["ptr_compare_check"] = ptr_compare_check
    HOOK["bloc_equal"] = bloc_equal
    HOOK["call_builtin"] = call_builtin
}

func ex_noop(n, sc) {
    return 0
}

func ex_func_stmt(n, sc) {
    if (n.name == null) {
        return 0
    }
    return ex_func(n, sc)
}

func init_tables() {
    init_hooks()
    EV["num"] = ev_const
    EV["float"] = ev_const
    EV["str"] = ev_const
    EV["char"] = ev_const
    EV["bool"] = ev_const
    EV["tmpl"] = ev_tmpl
    EV["id"] = ev_id
    EV["list"] = ev_list
    EV["map"] = ev_map
    EV["func"] = ev_func
    EV["bin"] = ev_bin
    EV["not"] = ev_not
    EV["incdec"] = ev_incdec
    EV["input"] = ev_input
    EV["index"] = ev_index
    EV["field"] = ev_field
    EV["box"] = ev_box
    EV["call"] = ev_call

    EX["let"] = ex_let
    EX["group"] = ex_group
    EX["func"] = ex_func_stmt
    EX["assign"] = ex_assign
    EX["setidx"] = ex_setidx
    EX["print"] = ex_print
    EX["return"] = ex_return
    EX["break"] = ex_break
    EX["continue"] = ex_continue
    EX["if"] = ex_if
    EX["while"] = ex_while
    EX["for"] = ex_for
    EX["forin"] = ex_forin
    EX["switch"] = ex_switch
    EX["unsafe"] = ex_unsafe
    EX["use"] = ex_use
    EX["typedef"] = ex_noop

    register_core()
    register_string()
    register_math()
    register_list()
    register_file()
    register_memory()
    for (let name in map_keys(SPEC)) {
        NATIVES[name] = {"@k": "native", "name": name}
    }
}

func has_zero_arg_main(g) {
    let b = g["main"]
    if (b == null) {
        return false
    }
    let f = b[0]
    return vkind(f) == "fn" and len(f.node.params) == 0 and f.env == g
}

func main() {
    let a = args()
    if (len(a) < 1) {
        err_text("usage: luna luna_in_luna.lu program.lu [arguments...]\n")
        exit(1)
    }
    let path = a[0]
    if (not ends_with(path, ".lu")) {
        err_text("Error: expected a .lu file\n")
        exit(1)
    }
    io_init()
    init_tables()
    RT.script_args = slice(a, 1, len(a))
    let text = read_source(path)
    if (text == null) {
        err_text("Could not read file: {path}\n")
        exit(1)
    }
    let m = new_module_record(path, path_norm(path), text)
    MODULES[m.canon] = m
    RT.cur = m
    let stmts = parse_program(lex(text, 1))
    let lint_line = lint_program(stmts)
    if (lint_line != null) {
        err_text(format_error("Static Error", lint_line, 0, "free() may not appear inside conditional control flow", "Move free(ptr) out of the branch/loop, or use defer(ptr) instead"))
        err_text("Parsing failed.\n")
        exit(1)
    }
    collect_exports(stmts, m.exports)
    m.state = 1
    run_module(m, stmts)
    m.state = 2
    if (has_zero_arg_main(m.globals)) {
        RT.cur = m
        call_fn(m.globals["main"][0], [])
    }
}
