# interpreter.lu: scopes, statement execution core, calls, indexing.

use { is_int, tname, vkind } from "value.lu"
use { arg_error, fail, name_error, rt_error, type_error } from "error.lu"
use { node } from "parser.lu"
use { construct, special_field, special_index, special_index_set } from "data_runtime.lu"
use { box_release, container_check, global_store_check } from "box.lu"
use { unsafe_error } from "unsafe_runtime.lu"
use { HOOK, RT } from "state.lu"

func hook_call_builtin(name, args) {
    let f = HOOK["call_builtin"]
    return f(name, args)
}

let CALL_DEPTH = 0         # nested user function calls

let CALL_LIMIT = 4096

export let EV = {}                # expression handlers, filled in at the end of the file

export let EX = {}                # statement handlers

export let NATIVES = {}           # builtin name -> value

export func scope_find(sc, name) {
    let s = sc
    while (s != null) {
        let b = s[name]
        if (b != null) {
            return b
        }
        s = s["@p"]
    }
    return null
}

export func global_scope(sc) {
    let s = sc
    while (s["@p"] != null) {
        s = s["@p"]
    }
    return s
}

export func undefined_var(name) {
    name_error("Variable '{name}' is not defined", "Declare variables with 'let' before using them")
}

# Stores to a name. Variables of a module's global scope are the ones the unsafe
# and box rules watch.
export func assign_var(sc, name, v) {
    let s = sc
    while (s != null) {
        let b = s[name]
        if (b != null) {
            if (s["@g"] != null) {
                global_store_check(v)
            }
            b[0] = v
            return null
        }
        s = s["@p"]
    }
    let g = global_scope(sc)
    global_store_check(v)
    g[name] = [v]
}

export func define_var(sc, name, v) {
    if (sc["@g"] != null) {
        global_store_check(v)
    }
    sc[name] = [v]
}

export func leave_scope(sc) {
    let d = sc["@d"]
    if (d != null) {
        sc["@d"] = null
        let i = len(d) - 1
        while (i >= 0) {
            let item = d[i]
            RT.cur_line = item.line
            call_value(item.f, item.args, null)
            i -= 1
        }
    }
    let b = sc["@b"]
    if (b != null) {
        sc["@b"] = null
        for (let h in b) {
            box_release(h)
        }
    }
}

export func exec_one(s, sc) {
    RT.cur_line = s.line
    let h = EX[s.k]
    if (h == null) {
        EV[s.k](s, sc)
        return 0
    }
    return h(s, sc)
}

export func exec_list(stmts, sc) {
    for (let s in stmts) {
        RT.cur_line = s.line
        let h = EX[s.k]
        let st = 0
        if (h == null) {
            EV[s.k](s, sc)
        } else {
            st = h(s, sc)
        }
        if (st != 0) {
            return st
        }
    }
    return 0
}

# Runs statements in a fresh scope.
export func run_block(stmts, parent) {
    let sc = {"@p": parent}
    let st = exec_list(stmts, sc)
    leave_scope(sc)
    return st
}

export func make_closure(n, sc) {
    return {"@k": "fn", "node": n, "env": sc, "mod": RT.cur}
}

func ev(n, sc) {
    return EV[n.k](n, sc)
}

export func call_value(f, args, cn) {
    let k = vkind(f)
    if (k == "fn") {
        if (RT.unsafe_depth > 0) {
            unsafe_error(11)
        }
        return call_fn(f, args)
    }
    if (k == "native") {
        return hook_call_builtin(f.name, args)
    }
    if (k == "dtype" or k == "bloctype") {
        return construct(f, args)
    }
    let name = "value"
    if (cn != null and cn.k == "id") {
        name = cn.name
    }
    type_error("'{name}' is not a function", "Make sure you are calling a function value, closure, or native builtin")
}

export func arity_error(name, na, lo, hi) {
    let plural = "s"
    if (hi == 1) {
        plural = ""
    }
    if (lo == hi) {
        arg_error("{name}() expects {lo} argument{plural}, but got {na}", "Pass one value per parameter")
    }
    arg_error("{name}() expects {lo} to {hi} arguments, but got {na}", "Pass one value per required parameter")
}

export func call_fn(f, args) {
    let n = f.node
    let na = len(args)
    let np = len(n.params)
    if (na < n.required or na > np) {
        let name = n.name
        if (name == null) {
            name = "<anonymous>"
        }
        arity_error(name, na, n.required, np)
    }
    if (CALL_DEPTH >= CALL_LIMIT) {
        rt_error("stack overflow: recursion is too deep", "Luna allows 4096 nested calls. Check for a recursion that never stops.")
    }
    CALL_DEPTH += 1
    RT.func_depth += 1
    let saved_cur = RT.cur
    let saved_line = RT.cur_line
    RT.cur = f.mod
    let sc = {"@p": f.env}
    let params = n.params
    for (let i = 0; i < np; i++) {
        if (i < na) {
            sc[params[i]] = [args[i]]
        } else {
            let d = n.defaults[i]
            sc[params[i]] = [EV[d.k](d, sc)]
        }
    }
    let st = exec_list(n.body, sc)
    let result = null
    if (st == 3) {
        result = RT.retv
        RT.retv = null
    }
    leave_scope(sc)
    RT.cur = saved_cur
    RT.cur_line = saved_line
    RT.func_depth -= 1
    CALL_DEPTH -= 1
    return result
}

func index_oob(idx, n, what, hint) {
    fail("Index Error", "Index {idx} is out of bounds for {what} of length {n}", hint)
}

export func index_get(t, i) {
    let tt = type(t)
    if (tt == "list" or tt == "string") {
        if (not is_int(i)) {
            let what = "list"
            if (tt == "string") {
                what = "string"
            }
            type_error("{what} index must be an int, got {tname(i)}", "Use an int index")
        }
        let n = len(t)
        let idx = i
        if (idx < 0) {
            idx += n
        }
        if (idx < 0 or idx >= n) {
            index_oob(i, n, tt, "Ensure your index is between 0 and len-1")
        }
        return t[idx]
    }
    if (tt == "map") {
        let k = t["@k"]
        if (k == null) {
            if (type(i) != "string") {
                type_error("map key must be a string, got {tname(i)}", "Maps use string keys")
            }
            return t[i]
        }
        return special_index(k, t, i)
    }
    type_error("cannot index {tname(t)}", "Index lists and strings with ints, maps with strings")
}

export func field_get(t, name) {
    if (type(t) == "map") {
        let k = t["@k"]
        if (k == null) {
            return t[name]
        }
        return special_field(k, t, name)
    }
    type_error("cannot read field '{name}' of {tname(t)}", "Dot access works on maps")
}

export func index_set(t, i, v) {
    let tt = type(t)
    if (tt == "list") {
        if (not is_int(i)) {
            type_error("list index must be an int, got {tname(i)}", "Use an int index")
        }
        container_check(v)
        let n = len(t)
        let idx = i
        if (idx < 0) {
            idx += n
        }
        if (idx < 0 or idx >= n) {
            index_oob(i, n, "list", "Ensure your index is between 0 and len(list)-1")
        }
        t[idx] = v
        return null
    }
    if (tt == "map") {
        let k = t["@k"]
        if (k == null) {
            if (type(i) != "string") {
                type_error("map key must be a string, got {tname(i)}", "Maps use string keys")
            }
            container_check(v)
            t[i] = v
            return null
        }
        return special_index_set(k, t, i, v)
    }
    type_error("Cannot assign through this target", "Use integer indices for lists, or string keys for maps and templates")
}
