# error.lu: output streams, error formatting and error raising.

use { RT } from "state.lu"

let OUT = null

let ERRS = null

# Output goes through streams of our own, flushed on every write, so stdout and
# stderr keep their order no matter how the host buffers.
export func io_init() {
    OUT = open("/dev/stdout", "a")
    ERRS = open("/dev/stderr", "a")
}

export func out_line(text) {
    if (OUT == null) {
        print(text)
        return null
    }
    write(OUT, text)
    write(OUT, "\n")
    flush(OUT)
}

export func out_text(text) {
    if (OUT == null) {
        print(text)
        return null
    }
    write(OUT, text)
    flush(OUT)
}

export func err_text(text) {
    if (ERRS == null) {
        print(text)
        return null
    }
    write(ERRS, text)
    flush(ERRS)
}

# Formats an error the way the VM does (src/error.c).
export func format_error(kind, line, col, msg, hint) {
    if (line <= 0) {
        line = RT.cur_line
    }
    let out = []
    let head = [kind]
    if (RT.cur != null) {
        append(head, " in {RT.cur.path}")
    }
    append(head, " at line {line}")
    if (col > 0) {
        append(head, ", column {col}")
    }
    let head_text = join(head, "")
    append(out, "{head_text}:\n  {msg}\n")
    if (RT.cur != null) {
        let lines = RT.cur.lines
        if (line >= 1 and line <= len(lines)) {
            let num = pad_left(to_string(line), 4, " ")
            append(out, "\n{num} | {lines[line - 1]}\n")
            if (col > 0) {
                let pad = repeat(" ", col - 1)
                append(out, "     | {pad}^~~~ here\n")
            }
            append(out, "\n")
        }
    }
    if (hint != null) {
        append(out, "Hint: {hint}\n")
    }
    return join(out, "")
}

func fail_at(kind, line, col, msg, hint) {
    err_text(format_error(kind, line, col, msg, hint))
    exit(1)
}

# A runtime error at the line being executed. Never returns.
export func fail(kind, msg, hint) {
    fail_at(kind, RT.cur_line, 0, msg, hint)
}

export func rt_error(msg, hint) {
    fail("Runtime Error", msg, hint)
}

export func type_error(msg, hint) {
    fail("Type Error", msg, hint)
}

export func name_error(msg, hint) {
    fail("Name Error", msg, hint)
}

export func arg_error(msg, hint) {
    fail("Argument Error", msg, hint)
}
