#
# luna_in_luna.lu -- the Luna language, implemented in Luna.
#
# One file: lexer, parser, interpreter, standard library, modules, and the
# data / box / unsafe rules. It reads a Luna program and runs it:
#
#   luna luna_in_luna.lu program.lu [arguments...]
#
# It can run on the bytecode VM, or be compiled with compiler/lunac.sh into a
# native binary (much faster, and with deep recursion).
#
# Values of the interpreted program are host values: ints, floats, strings,
# chars, bools, null, lists and maps are the interpreter's own. Everything else
# (functions, blocs, templates, boxes, pointers, types) is a map that carries a
# "@k" key naming its kind.
#
# Names such as data, from, in, input and print are keywords in Luna, so this
# file never uses them as identifiers. A literal { inside a string is written \{.

# ---------------------------------------------------------------------------
# Output, errors
# ---------------------------------------------------------------------------

let MAX_INT = 9223372036854775807
let MIN_INT = -9223372036854775807 - 1

let OUT = null
let ERRS = null

# Output goes through streams of our own, flushed on every write, so stdout and
# stderr keep their order no matter how the host buffers.
func io_init() {
    OUT = open("/dev/stdout", "a")
    ERRS = open("/dev/stderr", "a")
}

func out_line(text) {
    if (OUT == null) {
        print(text)
        return null
    }
    write(OUT, text)
    write(OUT, "\n")
    flush(OUT)
}

func out_text(text) {
    if (OUT == null) {
        print(text)
        return null
    }
    write(OUT, text)
    flush(OUT)
}

func err_text(text) {
    if (ERRS == null) {
        print(text)
        return null
    }
    write(ERRS, text)
    flush(ERRS)
}

# The module whose source is being run or parsed, and the line being executed.
let CUR = null
let CUR_LINE = 0

func new_module_record(path, canon, text) {
    return {"path": path, "canon": canon, "lines": split_lines(text), "globals": null,
            "exports": [], "state": 0, "id": 0}
}

# split() drops empty lines and treats every delimiter character separately,
# so lines are cut by hand.
func split_lines(text) {
    let lines = []
    let start = 0
    let n = len(text)
    for (let i = 0; i < n; i++) {
        if (text[i] == '\n') {
            append(lines, slice(text, start, i))
            start = i + 1
        }
    }
    if (start < n) {
        append(lines, slice(text, start, n))
    }
    return lines
}

# Formats an error the way the VM does (src/error.c).
func format_error(kind, line, col, msg, hint) {
    if (line <= 0) {
        line = CUR_LINE
    }
    let out = []
    let head = [kind]
    if (CUR != null) {
        append(head, " in {CUR.path}")
    }
    append(head, " at line {line}")
    if (col > 0) {
        append(head, ", column {col}")
    }
    let head_text = join(head, "")
    append(out, "{head_text}:\n  {msg}\n")
    if (CUR != null) {
        let lines = CUR.lines
        if (line >= 1 and line <= len(lines)) {
            let num = pad_left(to_string(line), 4, " ")
            append(out, "\n{num} | {lines[line - 1]}\n")
            if (col > 0) {
                let pad = repeat(" ", col - 1)
                append(out, "     | {pad}^~~~ here\n")
            }
            append(out, "\n")
        }
    }
    if (hint != null) {
        append(out, "Hint: {hint}\n")
    }
    return join(out, "")
}

func fail_at(kind, line, col, msg, hint) {
    err_text(format_error(kind, line, col, msg, hint))
    exit(1)
}

# A runtime error at the line being executed. Never returns.
func fail(kind, msg, hint) {
    fail_at(kind, CUR_LINE, 0, msg, hint)
}

func rt_error(msg, hint) {
    fail("Runtime Error", msg, hint)
}

func type_error(msg, hint) {
    fail("Type Error", msg, hint)
}

func name_error(msg, hint) {
    fail("Name Error", msg, hint)
}

func arg_error(msg, hint) {
    fail("Argument Error", msg, hint)
}

# ---------------------------------------------------------------------------
# Lexer
# ---------------------------------------------------------------------------

let KEYWORDS = {
    "and": "and", "or": "or", "not": "not",
    "let": "let", "balls": "let", "big_balls": "let", "shared_balls": "let",
    "const": "const",
    "func": "func", "grab_balls": "func",
    "if": "if", "if_balls": "if", "else": "else", "else_balls": "else",
    "while": "while", "spin_balls": "while",
    "for": "for", "loop_your_balls": "for", "in": "in",
    "return": "return", "break": "break", "drop_balls": "break",
    "continue": "continue", "jiggle_balls": "continue",
    "switch": "switch", "switch_balls": "switch", "case": "case", "default": "default",
    "print": "print", "input": "input", "true": "true", "false": "false",
    "use": "use", "from": "from", "export": "export", "import": "import",
    "data": "data", "template": "template", "bloc": "bloc", "box": "box", "unsafe": "unsafe"
}

let TWO_CHAR = {
    "==": "==", "!=": "!=", "<=": "<=", ">=": ">=", "++": "++", "+=": "+=",
    "--": "--", "-=": "-=", "*=": "*=", "/=": "/=", "&&": "and", "||": "or"
}

let ONE_CHAR = {
    "=": "=", "+": "+", "-": "-", "*": "*", "/": "/", "%": "%", "<": "<", ">": ">",
    "(": "(", ")": ")", "{": "{", "}": "}", "[": "[", "]": "]", ",": ",", ".": ".",
    ":": ":", ";": ";", "!": "not"
}

# Token names as they appear in syntax errors.
let TOKNAMES = {
    "nl": "NEWLINE", "eof": "EOF", "id": "IDENT", "num": "NUMBER", "float": "FLOAT",
    "str": "STRING", "char": "CHAR", "+": "PLUS", "+=": "PLUS_EQ", "-": "MINUS",
    "-=": "MINUS_EQ", "*": "MUL", "*=": "MUL_EQ", "/": "DIV", "/=": "DIV_EQ",
    "%": "MOD", "++": "INC", "--": "DEC", "=": "EQ", "==": "EQEQ", "!=": "NEQ",
    "<": "LT", ">": "GT", "<=": "LTE", ">=": "GTE", "(": "LPAREN", ")": "RPAREN",
    "\{": "LBRACE", "}": "RBRACE", "[": "LBRACKET", "]": "RBRACKET", ",": "COMMA",
    ".": "DOT", ":": "COLON", ";": "SEMICOLON", "and": "AND", "or": "OR", "not": "NOT",
    "let": "LET", "if": "IF", "else": "ELSE", "func": "FUNC", "return": "RETURN",
    "print": "PRINT", "input": "INPUT", "true": "TRUE", "false": "FALSE",
    "while": "WHILE", "for": "FOR", "in": "IN", "const": "CONST", "data": "DATA",
    "bloc": "BLOC", "box": "BOX", "use": "USE", "from": "FROM", "export": "EXPORT",
    "import": "IMPORT", "unsafe": "UNSAFE", "break": "BREAK", "continue": "CONTINUE",
    "switch": "SWITCH", "case": "CASE", "default": "DEFAULT"
}

func tokname(t) {
    let n = TOKNAMES[t]
    if (n == null) {
        return "UNKNOWN"
    }
    return n
}

func is_dig(c) {
    return c >= '0' and c <= '9'
}

func is_ident_start(c) {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'
}

func is_ident_char(c) {
    return is_ident_start(c) or is_dig(c)
}

func make_tok(t, v, line, col) {
    return {"t": t, "v": v, "line": line, "col": col}
}

# A syntax error at a position. Never returns.
func syntax_error(line, col, msg, hint) {
    err_text(format_error("Syntax Error (Skill issue)", line, col, msg, hint))
    if (CUR != null and CUR.id == 0) {
        err_text("Parsing failed.\n")
    }
    exit(1)
}

# Reads the string whose opening quote is at index i. Returns [parts, next_i,
# next_line, next_line_start]. A part is a string or {"expr": source, "line": n}.
func lex_string(src, i, line, ls) {
    let n = len(src)
    let pcs = []
    let start_line = line
    i += 1
    while (i < n and src[i] != '"') {
        let c = src[i]
        if (c == '\\') {
            i += 1
            if (i >= n) {
                break
            }
            let e = src[i]
            if (e == 'n') {
                append(pcs, "\n")
            } else if (e == 't') {
                append(pcs, "\t")
            } else if (e == 'r') {
                append(pcs, "\r")
            } else if (e == '\{') {
                append(pcs, "<LB>")
            } else if (e == '}') {
                append(pcs, "<RB>")
            } else {
                append(pcs, "{e}")
            }
            if (e == '\n') {
                line += 1
                ls = i + 1
            }
        } else {
            if (c == '\n') {
                line += 1
                ls = i + 1
            }
            append(pcs, "{c}")
        }
        i += 1
    }
    if (i < n) {
        i += 1
    }

    let parts = []
    let cur = []
    let j = 0
    let m = len(pcs)
    while (j < m) {
        let p = pcs[j]
        if (p == "<LB>") {
            append(cur, "\{")
        } else if (p == "<RB>") {
            append(cur, "\}")
        } else if (p == "\{" and j + 1 < m and pcs[j + 1] != "\}") {
            let depth = 1
            let k = j + 1
            let ex = []
            while (k < m) {
                let q = pcs[k]
                if (q == "\{") {
                    depth += 1
                } else if (q == "\}") {
                    depth -= 1
                    if (depth == 0) {
                        break
                    }
                }
                if (q == "<LB>") {
                    append(ex, "\{")
                } else if (q == "<RB>") {
                    append(ex, "\}")
                } else {
                    append(ex, q)
                }
                k += 1
            }
            if (k >= m) {
                syntax_error(start_line, 0, "Unclosed string interpolation expression", "Close the interpolation with '}'")
            }
            if (len(cur) > 0) {
                append(parts, join(cur, ""))
                cur = []
            }
            append(parts, {"expr": join(ex, ""), "line": start_line})
            j = k
        } else {
            append(cur, p)
        }
        j += 1
    }
    if (len(cur) > 0 or len(parts) == 0) {
        append(parts, join(cur, ""))
    }
    return [parts, i, line, ls]
}

func lex(src, first_line) {
    let toks = []
    let n = len(src)
    let i = 0
    let line = first_line
    let ls = 0
    while (i < n) {
        let c = src[i]
        let col = i - ls + 1
        if (c == '\n') {
            append(toks, make_tok("nl", null, line, col))
            line += 1
            i += 1
            ls = i
        } else if (c == ' ' or c == '\t' or int(c) == 13 or int(c) == 12 or int(c) == 11) {
            i += 1
        } else if (c == '#' or (c == '/' and i + 1 < n and src[i + 1] == '/')) {
            while (i < n and src[i] != '\n') {
                i += 1
            }
        } else if (c == '"') {
            let start_line = line
            let r = lex_string(src, i, line, ls)
            append(toks, make_tok("str", r[0], start_line, col))
            i = r[1]
            line = r[2]
            ls = r[3]
        } else if (c == '\'') {
            i += 1
            let ch = '\0'
            if (i < n) {
                ch = src[i]
            }
            if (i < n and src[i] == '\\') {
                i += 1
                if (i < n) {
                    let e = src[i]
                    if (e == 'n') {
                        ch = '\n'
                    } else if (e == 't') {
                        ch = '\t'
                    } else if (e == '0') {
                        ch = '\0'
                    } else {
                        ch = e
                    }
                }
            }
            i += 1
            if (i < n and src[i] == '\'') {
                i += 1
            }
            append(toks, make_tok("char", ch, line, col))
        } else if (is_dig(c)) {
            let s = i
            while (i < n and is_dig(src[i])) {
                i += 1
            }
            let is_float = false
            if (i + 1 < n and src[i] == '.' and is_dig(src[i + 1])) {
                is_float = true
                i += 1
                while (i < n and is_dig(src[i])) {
                    i += 1
                }
            }
            if (is_float) {
                append(toks, make_tok("float", to_float(slice(src, s, i)), line, col))
            } else {
                append(toks, make_tok("num", to_int(slice(src, s, i)), line, col))
            }
        } else if (is_ident_start(c)) {
            let s = i
            while (i < n and is_ident_char(src[i])) {
                i += 1
            }
            let word = slice(src, s, i)
            let kw = KEYWORDS[word]
            if (kw != null) {
                append(toks, make_tok(kw, word, line, col))
            } else {
                append(toks, make_tok("id", word, line, col))
            }
        } else {
            let two = ""
            if (i + 1 < n) {
                two = slice(src, i, i + 2)
            }
            let one = "{c}"
            if (TWO_CHAR[two] != null) {
                append(toks, make_tok(TWO_CHAR[two], two, line, col))
                i += 2
            } else if (ONE_CHAR[one] != null) {
                append(toks, make_tok(ONE_CHAR[one], one, line, col))
                i += 1
            } else {
                append(toks, make_tok("id", one, line, col))
                i += 1
            }
        }
    }
    append(toks, make_tok("eof", null, line, i - ls + 1))
    return toks
}

# ---------------------------------------------------------------------------
# Parser
#
# Follows src/parser.c: the same grammar, the same error messages and hints.
# Nodes are maps with a "k" kind and a "line".
# ---------------------------------------------------------------------------

let P_toks = []
let P_pos = 0

func p_at(t) {
    return P_toks[P_pos].t == t
}

func p_next() {
    let tk = P_toks[P_pos]
    if (P_pos < len(P_toks) - 1) {
        P_pos += 1
    }
    return tk
}

func p_eat(t) {
    if (P_toks[P_pos].t == t) {
        p_next()
        return true
    }
    return false
}

func p_skip_nl() {
    while (P_toks[P_pos].t == "nl") {
        p_next()
    }
}

# Reports a syntax error at the current token and stops.
func p_fail(msg, hint) {
    let tk = P_toks[P_pos]
    syntax_error(tk.line, tk.col, msg, hint)
}

# Consumes a token of type t, or fails with the given message.
func p_expect(t, msg) {
    let tk = P_toks[P_pos]
    if (tk.t != t) {
        syntax_error(tk.line, tk.col, msg, "Expected {tokname(t)} but found {tokname(tk.t)}")
    }
    return p_next()
}

func node(k, line) {
    return {"k": k, "line": line}
}

# Parses expression text from inside a string with its own token stream.
func parse_inline(text, line) {
    let saved_toks = P_toks
    let saved_pos = P_pos
    P_toks = lex(text, line)
    P_pos = 0
    let e = p_expr()
    p_skip_nl()
    if (not p_at("eof")) {
        syntax_error(line, 0, "Invalid expression inside string interpolation", "Use a valid Luna expression inside \{ ... }")
    }
    P_toks = saved_toks
    P_pos = saved_pos
    return e
}

func p_string(tk) {
    let parts = tk.v
    let has_expr = false
    for (let part in parts) {
        if (type(part) == "map") {
            has_expr = true
        }
    }
    if (not has_expr) {
        let s = node("str", tk.line)
        s.v = parts[0]
        return s
    }
    let t = node("tmpl", tk.line)
    let items = []
    for (let part in parts) {
        if (type(part) == "map") {
            append(items, parse_inline(part.expr, part.line))
        } else {
            append(items, part)
        }
    }
    t.parts = items
    return t
}

func p_list_literal(line) {
    let items = []
    p_skip_nl()
    if (not p_at("]")) {
        let more = true
        while (more) {
            p_skip_nl()
            append(items, p_expr())
            p_skip_nl()
            more = p_eat(",")
        }
    }
    p_skip_nl()
    p_expect("]", "Expected ']' at end of list")
    let n = node("list", line)
    n.items = items
    return n
}

func p_map_literal(line) {
    let keys = []
    let vals = []
    p_skip_nl()
    if (not p_at("}")) {
        let more = true
        while (more) {
            p_skip_nl()
            if (not p_at("str")) {
                p_fail("Map literal keys must be strings", "Use \{\"key\": value} for map literals")
            }
            let kt = p_next()
            append(keys, kt.v[0])
            p_expect(":", "Expected ':' after map key")
            append(vals, p_expr())
            p_skip_nl()
            more = p_eat(",")
        }
    }
    p_skip_nl()
    p_expect("}", "Expected '}' at end of map literal")
    let n = node("map", line)
    n.keys = keys
    n.vals = vals
    return n
}

func p_func_rest(name, line) {
    p_expect("(", "Expected '('")
    let params = []
    let defaults = []
    let required = 0
    if (not p_at(")")) {
        let more = true
        while (more) {
            if (not p_at("id")) {
                p_fail("Expected parameter name", "Function parameters must be valid identifiers, e.g., 'func add(a, b)'")
            }
            append(params, p_next().v)
            if (p_eat("=")) {
                append(defaults, p_expr())
            } else {
                append(defaults, null)
                required += 1
            }
            more = p_eat(",")
        }
    }
    p_expect(")", "Expected ')'")
    p_expect("\{", "Expected '\{'")
    let n = node("func", line)
    n.name = name
    n.params = params
    n.defaults = defaults
    n.required = required
    n.body = p_block()
    n.exported = false
    return n
}

func p_primary() {
    let tk = P_toks[P_pos]
    let line = tk.line
    let t = tk.t
    if (t == "num") {
        p_next()
        let n = node("num", line)
        n.v = tk.v
        return n
    }
    if (t == "float") {
        p_next()
        let n = node("float", line)
        n.v = tk.v
        return n
    }
    if (t == "str") {
        p_next()
        return p_string(tk)
    }
    if (t == "char") {
        p_next()
        let n = node("char", line)
        n.v = tk.v
        return n
    }
    if (t == "true" or t == "false") {
        p_next()
        let n = node("bool", line)
        n.v = t == "true"
        return n
    }
    if (t == "id") {
        p_next()
        let n = node("id", line)
        n.name = tk.v
        return n
    }
    if (t == "box") {
        p_next()
        p_expect("[", "Expected '[' after 'box'")
        let n = node("box", line)
        n.size = p_expr()
        p_expect("]", "Expected ']' after box size")
        return n
    }
    if (t == "(") {
        p_next()
        let e = p_expr()
        p_expect(")", "Expected ')' after expression")
        return e
    }
    if (t == "[") {
        p_next()
        return p_list_literal(line)
    }
    if (t == "\{") {
        p_next()
        return p_map_literal(line)
    }
    if (t == "func") {
        p_next()
        return p_func_rest(null, line)
    }
    if (t == "input") {
        p_next()
        p_expect("(", "Expected '(' after input")
        let n = node("input", line)
        n.prompt = null
        if (not p_at(")")) {
            if (not p_at("str")) {
                p_fail("Expected string prompt for input", "Use input(\"prompt\") to get user input with a message")
            }
            n.prompt = p_next().v[0]
        }
        p_expect(")", "Expected ')' after input")
        return n
    }
    if (t == ";") {
        p_fail("Unexpected semicolon ';'", "fucking noob")
    }
    p_fail("Unexpected token '{tokname(t)}'", "Expected an expression (number, string, variable, or '(')")
}

func p_postfix() {
    let line = P_toks[P_pos].line
    let e = p_primary()
    while (true) {
        if (p_eat("(")) {
            let args = []
            if (not p_at(")")) {
                let more = true
                while (more) {
                    append(args, p_expr())
                    more = p_eat(",")
                }
            }
            p_expect(")", "Expected ')' after arguments")
            let c = node("call", line)
            c.callee = e
            c.args = args
            e = c
        } else if (e.k == "id" and p_at("\{")) {
            p_next()
            let args = []
            p_skip_nl()
            if (not p_at("}")) {
                let more = true
                while (more) {
                    p_skip_nl()
                    append(args, p_expr())
                    p_skip_nl()
                    more = p_eat(",")
                }
            }
            p_expect("}", "Expected '}' after typed constructor arguments")
            let c = node("call", line)
            c.callee = e
            c.args = args
            c.typed = true
            e = c
        } else if (p_eat("[")) {
            let idx = p_expr()
            p_expect("]", "Expected ']' after index")
            let n = node("index", line)
            n.target = e
            n.index = idx
            e = n
        } else if (p_eat(".")) {
            if (not p_at("id")) {
                p_fail("Expected field name after '.'", "Use dot access like point.x")
            }
            let n = node("field", line)
            n.target = e
            n.field = p_next().v
            e = n
        } else if (p_at("++") or p_at("--")) {
            let op = P_toks[P_pos].t
            if (e.k != "id") {
                p_next()
                p_fail("'{op}' can only be applied to variables", "Use '{op}' only on variable names, e.g., 'count{op}'")
            }
            p_next()
            let n = node("incdec", line)
            n.name = e.name
            n.op = op
            e = n
        } else {
            break
        }
    }
    return e
}

func p_unary() {
    let line = P_toks[P_pos].line
    if (p_eat("not")) {
        let n = node("not", line)
        n.e = p_unary()
        return n
    }
    if (p_eat("-")) {
        let r = p_unary()
        if (r.k == "num") {
            r.v = 0 - r.v
            return r
        }
        if (r.k == "float") {
            r.v = 0.0 - r.v
            return r
        }
        let n = node("bin", line)
        n.op = "-"
        n.l = node("num", line)
        n.l.v = 0
        n.r = r
        return n
    }
    if (p_eat("+")) {
        return p_unary()
    }
    return p_postfix()
}

func has_op(ops, t) {
    for (let o in ops) {
        if (o == t) {
            return true
        }
    }
    return false
}

func p_binary_level(sub, ops) {
    let line = P_toks[P_pos].line
    let e = sub()
    while (has_op(ops, P_toks[P_pos].t)) {
        let op = p_next().t
        let r = sub()
        let n = node("bin", line)
        n.op = op
        n.l = e
        n.r = r
        e = n
    }
    return e
}

func p_mul() {
    return p_binary_level(p_unary, ["*", "/", "%"])
}

func p_add() {
    return p_binary_level(p_mul, ["+", "-"])
}

func p_cmp() {
    return p_binary_level(p_add, ["<", ">", "<=", ">="])
}

func p_eq() {
    return p_binary_level(p_cmp, ["==", "!="])
}

func p_and() {
    return p_binary_level(p_eq, ["and"])
}

func p_expr() {
    return p_binary_level(p_and, ["or"])
}

# Statements ---------------------------------------------------------------

func p_block() {
    let stmts = []
    while (not p_at("}") and not p_at("eof")) {
        if (p_eat("nl")) {
            continue
        }
        append(stmts, p_statement())
    }
    p_expect("}", "Expected '}'")
    return stmts
}

func p_declaration(is_const, is_export) {
    let line = P_toks[P_pos].line
    let names = []
    let more = true
    while (more) {
        if (not p_at("id")) {
            if (is_const) {
                p_fail("Expected variable name after 'const' or ','", "Variables must be identifiers (e.g., let a, b, c)")
            }
            p_fail("Expected variable name after 'let' or ','", "Variables must be identifiers (e.g., let a, b, c)")
        }
        append(names, p_next().v)
        more = p_eat(",")
    }
    let vals = []
    if (p_eat("=")) {
        more = true
        while (more) {
            append(vals, p_expr())
            more = p_eat(",")
        }
    }
    if (is_const and len(vals) != len(names)) {
        p_fail("const declarations require an initializer for every name", "Use const x = value")
    }
    if (len(vals) > 0 and len(vals) != len(names)) {
        p_fail("Variable count ({len(names)}) does not match value count ({len(vals)})", "Ensure you provide a value for every variable declared, or none at all.")
    }
    let lets = []
    for (let i = 0; i < len(names); i++) {
        let n = node("let", line)
        n.name = names[i]
        n.init = null
        if (len(vals) > 0) {
            n.init = vals[i]
        }
        n.is_const = is_const
        n.exported = is_export
        append(lets, n)
    }
    if (len(lets) == 1) {
        return lets[0]
    }
    let g = node("group", line)
    g.items = lets
    return g
}

func p_if(line) {
    p_expect("(", "Expected '(' after if")
    let cond = p_expr()
    p_expect(")", "Expected ')' after condition")
    p_eat("nl")
    p_expect("\{", "Expected '\{'")
    let n = node("if", line)
    n.cond = cond
    n.then = p_block()
    n.els = []
    p_eat("nl")
    if (p_eat("else")) {
        p_eat("nl")
        if (p_at("if")) {
            n.els = [p_statement()]
        } else {
            p_expect("\{", "Expected '\{'")
            n.els = p_block()
        }
    }
    return n
}

func p_for(line) {
    p_expect("(", "Expected '(' after for")
    if (p_at("let")) {
        p_next()
        if (not p_at("id")) {
            p_fail("Expected loop variable name in for-in loop", "Use for (let item in list) \{ ... }")
        }
        let name = p_next().v
        if (p_eat("in")) {
            let iter = p_expr()
            p_expect(")", "Expected ')' after for-in iterable")
            p_eat("nl")
            p_expect("\{", "Expected '\{' for loop body")
            let n = node("forin", line)
            n.name = name
            n.iter = iter
            n.body = p_block()
            return n
        }
        let init = node("let", line)
        init.name = name
        init.init = null
        init.is_const = false
        init.exported = false
        if (p_eat("=")) {
            init.init = p_expr()
        }
        return p_for_rest(line, init)
    }
    return p_for_rest(line, p_statement())
}

func p_for_rest(line, init) {
    p_expect(";", "Expected ';' after loop initializer")
    let cond = p_expr()
    p_expect(";", "Expected ';' after loop condition")
    let incr = p_statement()
    p_expect(")", "Expected ')' after loop increment")
    p_eat("nl")
    p_expect("\{", "Expected '\{' for loop body")
    let n = node("for", line)
    n.init = init
    n.cond = cond
    n.incr = incr
    n.body = p_block()
    return n
}

func p_case_body() {
    let body = []
    while (not p_at("case") and not p_at("default") and not p_at("}")) {
        if (p_eat("nl")) {
            continue
        }
        append(body, p_statement())
    }
    return body
}

func p_switch(line) {
    p_expect("(", "Expected '(' after switch")
    let e = p_expr()
    p_expect(")", "Expected ')'")
    p_expect("\{", "Expected '\{' starting switch block")
    let cases = []
    let dflt = []
    while (not p_at("}") and not p_at("eof")) {
        let cline = P_toks[P_pos].line
        if (p_eat("case")) {
            let v = p_expr()
            p_expect(":", "Expected ':' after case value")
            let body = p_case_body()
            append(cases, {"value": v, "body": body, "line": cline})
        } else if (p_eat("default")) {
            p_expect(":", "Expected ':' after default")
            dflt = p_case_body()
        } else if (p_eat("nl")) {
            continue
        } else {
            p_fail("Expected 'case' or 'default' inside switch", "Switch blocks must contain 'case value:' or 'default:' statements")
        }
    }
    p_expect("}", "Expected '}' ending switch")
    let n = node("switch", line)
    n.e = e
    n.cases = cases
    n.dflt = dflt
    return n
}

func compound_op(t) {
    if (t == "+=") {
        return "+"
    }
    if (t == "-=") {
        return "-"
    }
    if (t == "*=") {
        return "*"
    }
    if (t == "/=") {
        return "/"
    }
    return null
}

# target[index] = value  or  target.field = value, with an optional compound operator.
func make_setidx(e, v, op, line) {
    let n = node("setidx", line)
    if (e.k == "index") {
        n.target = e.target
        n.index = e.index
    } else {
        n.target = e.target
        n.index = node("str", line)
        n.index.v = e.field
    }
    n.e = v
    n.op = op
    return n
}

func p_simple(line) {
    let e = p_expr()
    if (p_eat("=")) {
        if (e.k == "id") {
            let n = node("assign", line)
            n.name = e.name
            n.e = p_expr()
            return n
        }
        if (e.k == "index" or e.k == "field") {
            let v = p_expr()
            return make_setidx(e, v, null, line)
        }
        p_fail("Invalid assignment target", "Assign to variables, indices, or fields like x = 5, arr[0] = 5, obj.name = 5")
    }
    let op = compound_op(P_toks[P_pos].t)
    if (op != null) {
        p_next()
        let rhs = p_expr()
        if (e.k == "id") {
            let b = node("bin", line)
            b.op = op
            b.l = e
            b.r = rhs
            let n = node("assign", line)
            n.name = e.name
            n.e = b
            return n
        }
        if (e.k == "index" or e.k == "field") {
            return make_setidx(e, rhs, op, line)
        }
        p_fail("Invalid compound assignment target", "Use +=, -=, *=, /= with variables, indices, or fields")
    }
    return e
}

func p_typedef(line, word) {
    let is_data = word == "data" or word == "template"
    if (not p_at("id")) {
        if (word == "template") {
            p_fail("Expected template name after 'template'", "Use template Shape \{ field1, field2 }")
        }
        if (word == "data") {
            p_fail("Expected data type name after 'data'", "Use data Shape \{ field1, field2 }")
        }
        p_fail("Expected bloc type name after 'bloc'", "Use bloc Vec2 \{ x, y }")
    }
    let n = node("typedef", line)
    n.name = p_next().v
    n.word = word
    n.fields = []
    n.exported = false
    if (is_data) {
        p_expect("\{", "Expected '\{' after data type name")
    } else {
        p_expect("\{", "Expected '\{' after bloc type name")
    }
    while (not p_at("}")) {
        p_skip_nl()
        if (not p_at("id")) {
            if (is_data) {
                p_fail("Expected field name in data declaration", "Use comma-separated identifiers inside data \{ ... }")
            }
            p_fail("Expected field name in bloc declaration", "Use comma-separated identifiers inside bloc \{ ... }")
        }
        append(n.fields, p_next().v)
        p_skip_nl()
        if (not p_eat(",")) {
            break
        }
    }
    if (is_data) {
        p_expect("}", "Expected '}' after data fields")
    } else {
        p_expect("}", "Expected '}' after bloc fields")
    }
    return n
}

func mark_exported(n) {
    if (n.k == "let" or n.k == "func" or n.k == "typedef") {
        n.exported = true
    } else if (n.k == "group") {
        for (let item in n.items) {
            mark_exported(item)
        }
    }
}

func p_use(line) {
    let n = node("use", line)
    n.names = []
    if (p_at("str")) {
        n.path = p_next().v[0]
        return n
    }
    p_expect("\{", "Expected '\{' or string path after use")
    while (not p_at("}") and not p_at("eof")) {
        if (not p_at("id")) {
            p_fail("Expected exported name inside use list", "Use syntax like use \{greet, answer} from \"module.lu\"")
        }
        append(n.names, p_next().v)
        if (not p_eat(",")) {
            break
        }
    }
    p_expect("}", "Expected '}' after use list")
    p_expect("from", "Expected 'from' after use list")
    if (not p_at("str")) {
        p_fail("Expected string path after from", "Use syntax like use \{greet} from \"module.lu\"")
    }
    n.path = p_next().v[0]
    return n
}

func p_statement() {
    let tk = P_toks[P_pos]
    let line = tk.line
    let t = tk.t
    if (t == "func") {
        p_next()
        if (not p_at("id")) {
            p_fail("Expected function name after 'func'", "Use 'func functionName(params) \{ ... }' to define a function")
        }
        let name = p_next().v
        return p_func_rest(name, line)
    }
    if (t == "data" or t == "template" or t == "bloc") {
        p_next()
        return p_typedef(line, t)
    }
    if (t == "let" or t == "const") {
        p_next()
        return p_declaration(t == "const", false)
    }
    if (t == "export") {
        p_next()
        let n = p_statement()
        if (n.k != "let" and n.k != "func" and n.k != "group" and n.k != "typedef") {
            fail_export(line)
        }
        mark_exported(n)
        return n
    }
    if (t == "use") {
        p_next()
        return p_use(line)
    }
    if (t == "import") {
        p_next()
        if (not p_at("str")) {
            p_fail("Expected string path after import", "Use import \"path/to/file.lu\"")
        }
        let n = node("use", line)
        n.names = []
        n.path = p_next().v[0]
        return n
    }
    if (t == "unsafe") {
        p_next()
        p_eat("nl")
        p_expect("\{", "Expected '\{' after unsafe")
        let n = node("unsafe", line)
        n.body = p_block()
        return n
    }
    if (t == "print") {
        p_next()
        p_expect("(", "Expected '(' after print")
        let args = []
        if (not p_at(")")) {
            let more = true
            while (more) {
                append(args, p_expr())
                more = p_eat(",")
            }
        }
        p_expect(")", "Expected ')' after print args")
        let n = node("print", line)
        n.args = args
        return n
    }
    if (t == "return") {
        p_next()
        let n = node("return", line)
        n.e = null
        if (not p_at("}")) {
            n.e = p_expr()
        }
        return n
    }
    if (t == "break") {
        p_next()
        return node("break", line)
    }
    if (t == "continue") {
        p_next()
        return node("continue", line)
    }
    if (t == "if") {
        p_next()
        return p_if(line)
    }
    if (t == "while") {
        p_next()
        p_expect("(", "Expected '(' after while")
        let cond = p_expr()
        p_expect(")", "Expected ')'")
        p_eat("nl")
        p_expect("\{", "Expected '\{'")
        let n = node("while", line)
        n.cond = cond
        n.body = p_block()
        return n
    }
    if (t == "for") {
        p_next()
        return p_for(line)
    }
    if (t == "switch") {
        p_next()
        return p_switch(line)
    }
    return p_simple(line)
}

func fail_export(line) {
    syntax_error(line, 0, "export can only be used with let, const, func, data, or bloc declarations", "Use export let, export func, export data, or export bloc at module top level")
}

# Parses a whole file into a list of statements.
func parse_program(toks) {
    P_toks = toks
    P_pos = 0
    let stmts = []
    while (not p_at("eof")) {
        if (p_eat("nl")) {
            continue
        }
        append(stmts, p_statement())
    }
    return stmts
}

# ---------------------------------------------------------------------------
# Values and operators
#
# The interpreted program's ints, floats, strings, chars, bools, null, lists and
# maps are host values. Any other value is a map whose "@k" key names its kind:
#   fn, native, bloctype, bloc, dtype, tpl, box, ptr
# ---------------------------------------------------------------------------

func vkind(v) {
    let t = type(v)
    if (t == "map") {
        let k = v["@k"]
        if (k != null) {
            return k
        }
        return "map"
    }
    return t
}

# The type name used in error messages (value_type_name in the VM).
func tname(v) {
    let k = vkind(v)
    if (k == "long") {
        return "int"
    }
    if (k == "fn") {
        return "function"
    }
    if (k == "native") {
        return "native_function"
    }
    if (k == "bloctype") {
        return "bloc_type"
    }
    if (k == "dtype") {
        return "data_type"
    }
    if (k == "tpl") {
        return "template"
    }
    if (k == "ptr") {
        return "pointer"
    }
    return k
}

# The name type() returns.
func type_name(v) {
    let k = vkind(v)
    if (k == "fn") {
        return "function"
    }
    if (k == "native") {
        return "native_function"
    }
    if (k == "bloctype") {
        return "bloc_type"
    }
    if (k == "dtype") {
        return "data_type"
    }
    if (k == "tpl") {
        return "template"
    }
    if (k == "ptr") {
        return "pointer"
    }
    return k
}

func is_int(v) {
    let t = type(v)
    return t == "int" or t == "long"
}

func is_num(v) {
    let t = type(v)
    return t == "int" or t == "long" or t == "float"
}

func is_listish(v) {
    return type(v) == "list"
}

# Strings --------------------------------------------------------------------

# True when a list holds nothing that needs the interpreter's own formatting.
func plain_list(v) {
    for (let x in v) {
        let t = type(x)
        if (t == "map" or t == "list") {
            return false
        }
    }
    return true
}

func tostr(v) {
    let t = type(v)
    if (t == "string") {
        return v
    }
    if (t == "list") {
        if (plain_list(v)) {
            return to_string(v)
        }
        let parts = []
        for (let x in v) {
            append(parts, tostr(x))
        }
        let body = join(parts, ", ")
        return "[{body}]"
    }
    if (t == "map") {
        let k = v["@k"]
        if (k == null) {
            return tostr_map(v)
        }
        return tostr_special(k, v)
    }
    if (t == "file") {
        return "<file handle>"
    }
    return to_string(v)
}

func tostr_map(m) {
    let parts = []
    for (let key in map_keys(m)) {
        let shown = tostr(m[key])
        append(parts, "\"{key}\": {shown}")
    }
    let body = join(parts, ", ")
    return "\{{body}}"
}

func tostr_special(k, v) {
    if (k == "fn") {
        return "<vm closure>"
    }
    if (k == "native") {
        return "<native function>"
    }
    if (k == "bloc") {
        let parts = []
        let d = v.desc
        for (let i = 0; i < len(d.fields); i++) {
            append(parts, "{d.fields[i]}: {tostr(v.vals[i])}")
        }
        let body = join(parts, ", ")
        return "{d.name}\{{body}}"
    }
    if (k == "bloctype") {
        return "<bloc {v.desc.name}>"
    }
    if (k == "dtype") {
        return "<data {v.name}>"
    }
    if (k == "tpl") {
        let parts = []
        let dt = v.dt
        for (let i = 0; i < len(dt.fields); i++) {
            append(parts, "{dt.fields[i]}: {tostr(v.vals[i])}")
        }
        let body = join(parts, ", ")
        return "{dt.name}\{{body}}"
    }
    if (k == "box") {
        return box_text(v)
    }
    if (k == "ptr") {
        return "ptr(0x{hex(ptr_address(v))})"
    }
    return "<{k}>"
}

func hex(n) {
    if (n == 0) {
        return "0"
    }
    let digits = "0123456789abcdef"
    let out = []
    while (n > 0) {
        append(out, "{digits[n % 16]}")
        n = n / 16
    }
    return join(reverse_list(out), "")
}

func reverse_list(l) {
    let out = []
    let i = len(l) - 1
    while (i >= 0) {
        append(out, l[i])
        i -= 1
    }
    return out
}

# Truth, equality, order -------------------------------------------------------

func truth(v) {
    if (type(v) == "boolean") {
        return v
    }
    type_error("condition must be a boolean, got {tname(v)}", "Write the test explicitly, for example x != 0, len(s) > 0 or v != null.")
}

func family(v) {
    let k = vkind(v)
    if (k == "int" or k == "long" or k == "float") {
        return "number"
    }
    if (k == "list") {
        return "list"
    }
    if (k == "fn" or k == "native") {
        return "function"
    }
    return k
}

# == without the type check (used by switch after the check, and by builtins).
func raw_equal(l, r) {
    let lk = vkind(l)
    if (lk == "bloc") {
        return bloc_equal(l, r)
    }
    if (lk == "box") {
        return l.h == r.h
    }
    if (lk == "ptr") {
        return ptr_address(l) == ptr_address(r)
    }
    if (lk == "native") {
        return l.name == r.name
    }
    return l == r
}

func values_equal(l, r) {
    if (l == null or r == null) {
        return l == null and r == null
    }
    if (family(l) != family(r)) {
        type_error("cannot compare {tname(l)} with {tname(r)}", "Compare values of the same type (comparing with null is always allowed).")
    }
    if (type(l) == "list") {
        return l == r
    }
    return raw_equal(l, r)
}

# -1, 0 or 1 for numbers, strings, chars and pointers.
func order_of(l, r) {
    let lt = type(l)
    let rt = type(r)
    if (is_num(l) and is_num(r)) {
        if (l < r) {
            return -1
        }
        if (l > r) {
            return 1
        }
        return 0
    }
    if ((lt == "string" and rt == "string") or (lt == "char" and rt == "char")) {
        if (l < r) {
            return -1
        }
        if (l > r) {
            return 1
        }
        return 0
    }
    if (vkind(l) == "ptr" and vkind(r) == "ptr") {
        let a = ptr_address(l)
        let b = ptr_address(r)
        if (a < b) {
            return -1
        }
        if (a > b) {
            return 1
        }
        return 0
    }
    type_error("cannot order {tname(l)} and {tname(r)} with <, <=, > or >=", "Ordering works on two numbers, two strings or two chars.")
}

# Arithmetic -------------------------------------------------------------------

func overflow_error(op) {
    rt_error("integer overflow in '{op}'", "The result does not fit in a 64-bit int. Use floats for very large numbers.")
}

func div_zero_error() {
    rt_error("division by zero", "Check the divisor before dividing.")
}

func operand_error(op, l, r) {
    let hint = "Both sides must be numbers."
    if (op == "+") {
        hint = "Both sides must be numbers, or both strings. Build text with \"\{x}\" or to_string(x)."
    }
    type_error("cannot use '{op}' on {tname(l)} and {tname(r)}", hint)
}

func int_arith(op, l, r) {
    if (op == "+") {
        if ((r > 0 and l > MAX_INT - r) or (r < 0 and l < MIN_INT - r)) {
            overflow_error("+")
        }
        return l + r
    }
    if (op == "-") {
        if ((r < 0 and l > MAX_INT + r) or (r > 0 and l < MIN_INT + r)) {
            overflow_error("-")
        }
        return l - r
    }
    if (op == "*") {
        if (l > 0) {
            if (r > 0) {
                if (l > MAX_INT / r) {
                    overflow_error("*")
                }
            } else if (r < MIN_INT / l) {
                overflow_error("*")
            }
        } else {
            if (r > 0) {
                if (l < MIN_INT / r) {
                    overflow_error("*")
                }
            } else if (l != 0 and r < MAX_INT / l) {
                overflow_error("*")
            }
        }
        return l * r
    }
    if (op == "/") {
        if (r == 0) {
            div_zero_error()
        }
        if (l == MIN_INT and r == -1) {
            overflow_error("/")
        }
        return l / r
    }
    if (r == 0) {
        div_zero_error()
    }
    if (r == -1) {
        return 0
    }
    return l % r
}

func arith(op, l, r) {
    let lt = type(l)
    let rt = type(r)
    let li = lt == "int" or lt == "long"
    let ri = rt == "int" or rt == "long"
    if (li and ri) {
        return int_arith(op, l, r)
    }
    let ln = li or lt == "float"
    let rn = ri or rt == "float"
    if (ln and rn) {
        if (op == "/" or op == "%") {
            if (r == 0) {
                div_zero_error()
            }
        }
        if (op == "+") {
            return l + r
        }
        if (op == "-") {
            return l - r
        }
        if (op == "*") {
            return l * r
        }
        if (op == "/") {
            return l / r
        }
        return l % r
    }
    if (lt == "list" and rt == "list") {
        if (op == "+") {
            return l + r
        }
        if (op == "-") {
            return l - r
        }
        if (op == "*") {
            return l * r
        }
        if (op == "/") {
            return l / r
        }
    }
    if (op == "+" and lt == "string" and rt == "string") {
        return l + r
    }
    operand_error(op, l, r)
}

func binary(op, l, r) {
    if (op == "+" or op == "-" or op == "*" or op == "/" or op == "%") {
        return arith(op, l, r)
    }
    if (op == "==") {
        if (vkind(l) == "ptr") {
            ptr_compare_check(l, r, 0)
        }
        return values_equal(l, r)
    }
    if (op == "!=") {
        if (vkind(l) == "ptr") {
            ptr_compare_check(l, r, 1)
        }
        return not values_equal(l, r)
    }
    if (vkind(l) == "ptr") {
        let code = 2
        if (op == ">") {
            code = 3
        } else if (op == "<=") {
            code = 4
        } else if (op == ">=") {
            code = 5
        }
        ptr_compare_check(l, r, code)
    }
    let c = order_of(l, r)
    if (op == "<") {
        return c < 0
    }
    if (op == "<=") {
        return c <= 0
    }
    if (op == ">") {
        return c > 0
    }
    return c >= 0
}

# ---------------------------------------------------------------------------
# Interpreter state
# ---------------------------------------------------------------------------

let RETV = null            # value of the return statement being unwound
let CALL_DEPTH = 0         # nested user function calls
let FUNC_DEPTH = 0         # > 0 while a user function body is running
let CALL_LIMIT = 4096
let EV = {}                # expression handlers, filled in at the end of the file
let EX = {}                # statement handlers
let SCRIPT_ARGS = []
let NATIVES = {}           # builtin name -> value

# Statement results: 0 normal, 1 break, 2 continue, 3 return.

# Scopes -------------------------------------------------------------------
#
# A scope is a map. "@p" is its parent, "@g" marks a module's global scope, "@d"
# holds deferred calls and "@b" the boxes made in it. Each variable is stored as
# a one-element list [value], so closures and pointers share it.

func scope_find(sc, name) {
    let s = sc
    while (s != null) {
        let b = s[name]
        if (b != null) {
            return b
        }
        s = s["@p"]
    }
    return null
}

func global_scope(sc) {
    let s = sc
    while (s["@p"] != null) {
        s = s["@p"]
    }
    return s
}

func undefined_var(name) {
    name_error("Variable '{name}' is not defined", "Declare variables with 'let' before using them")
}

# Stores to a name. Variables of a module's global scope are the ones the unsafe
# and box rules watch.
func assign_var(sc, name, v) {
    let s = sc
    while (s != null) {
        let b = s[name]
        if (b != null) {
            if (s["@g"] != null) {
                global_store_check(v)
            }
            b[0] = v
            return null
        }
        s = s["@p"]
    }
    let g = global_scope(sc)
    global_store_check(v)
    g[name] = [v]
}

func define_var(sc, name, v) {
    if (sc["@g"] != null) {
        global_store_check(v)
    }
    sc[name] = [v]
}

func leave_scope(sc) {
    let d = sc["@d"]
    if (d != null) {
        sc["@d"] = null
        let i = len(d) - 1
        while (i >= 0) {
            let item = d[i]
            CUR_LINE = item.line
            call_value(item.f, item.args, null)
            i -= 1
        }
    }
    let b = sc["@b"]
    if (b != null) {
        sc["@b"] = null
        for (let h in b) {
            box_release(h)
        }
    }
}

# Statements ------------------------------------------------------------------

func exec_one(s, sc) {
    CUR_LINE = s.line
    let h = EX[s.k]
    if (h == null) {
        EV[s.k](s, sc)
        return 0
    }
    return h(s, sc)
}

func exec_list(stmts, sc) {
    for (let s in stmts) {
        CUR_LINE = s.line
        let h = EX[s.k]
        let st = 0
        if (h == null) {
            EV[s.k](s, sc)
        } else {
            st = h(s, sc)
        }
        if (st != 0) {
            return st
        }
    }
    return 0
}

# Runs statements in a fresh scope.
func run_block(stmts, parent) {
    let sc = {"@p": parent}
    let st = exec_list(stmts, sc)
    leave_scope(sc)
    return st
}

func ex_let(n, sc) {
    let v = null
    if (n.init != null) {
        v = EV[n.init.k](n.init, sc)
    }
    define_var(sc, n.name, v)
    return 0
}

func ex_group(n, sc) {
    for (let item in n.items) {
        ex_let(item, sc)
    }
    return 0
}

func ex_func(n, sc) {
    let f = make_closure(n, sc)
    define_var(sc, n.name, f)
    return 0
}

func make_closure(n, sc) {
    return {"@k": "fn", "node": n, "env": sc, "mod": CUR}
}

func ex_assign(n, sc) {
    let v = EV[n.e.k](n.e, sc)
    assign_var(sc, n.name, v)
    return 0
}

func ex_setidx(n, sc) {
    let t = EV[n.target.k](n.target, sc)
    let i = EV[n.index.k](n.index, sc)
    let v = EV[n.e.k](n.e, sc)
    CUR_LINE = n.line
    if (n.op != null) {
        let cur = index_get(t, i)
        v = arith(n.op, cur, v)
    }
    index_set(t, i, v)
    return 0
}

func ex_print(n, sc) {
    for (let a in n.args) {
        let v = EV[a.k](a, sc)
        CUR_LINE = n.line
        out_line(tostr(v))
    }
    return 0
}

func ex_return(n, sc) {
    let v = null
    if (n.e != null) {
        v = EV[n.e.k](n.e, sc)
    }
    CUR_LINE = n.line
    if (FUNC_DEPTH > 0) {
        box_escape_check(v, "returned from a function")
    }
    RETV = v
    return 3
}

func ex_break(n, sc) {
    return 1
}

func ex_continue(n, sc) {
    return 2
}

func ex_if(n, sc) {
    let c = truth(EV[n.cond.k](n.cond, sc))
    if (c) {
        return run_block(n.then, sc)
    }
    if (len(n.els) > 0) {
        return run_block(n.els, sc)
    }
    return 0
}

func ex_while(n, sc) {
    while (true) {
        CUR_LINE = n.line
        let c = truth(EV[n.cond.k](n.cond, sc))
        if (not c) {
            break
        }
        let st = run_block(n.body, sc)
        if (st == 1) {
            break
        }
        if (st == 3) {
            return 3
        }
    }
    return 0
}

func ex_for(n, sc) {
    let ls = {"@p": sc}
    exec_one(n.init, ls)
    let result = 0
    while (true) {
        CUR_LINE = n.line
        let c = truth(EV[n.cond.k](n.cond, ls))
        if (not c) {
            break
        }
        let st = run_block(n.body, ls)
        if (st == 1) {
            break
        }
        if (st == 3) {
            result = 3
            break
        }
        exec_one(n.incr, ls)
    }
    leave_scope(ls)
    return result
}

func ex_forin(n, sc) {
    let it = EV[n.iter.k](n.iter, sc)
    CUR_LINE = n.line
    let t = type(it)
    if (t != "list" and t != "string") {
        type_error("for-in expects a list, dense list, or string", "Use for (let item in list) \{ ... }")
    }
    let count = len(it)
    let i = 0
    let result = 0
    while (i < count) {
        if (i >= len(it)) {
            fail("Index Error", "Index {i} is out of bounds for {t} of length {len(it)}", "Ensure your index is between 0 and len-1")
        }
        let isc = {"@p": sc}
        isc[n.name] = [it[i]]
        let st = exec_list(n.body, isc)
        leave_scope(isc)
        if (st == 1) {
            break
        }
        if (st == 3) {
            result = 3
            break
        }
        i += 1
    }
    return result
}

func ex_switch(n, sc) {
    let v = EV[n.e.k](n.e, sc)
    for (let c in n.cases) {
        let cv = EV[c.value.k](c.value, sc)
        CUR_LINE = c.line
        if (values_equal(v, cv)) {
            let st = run_block(c.body, sc)
            if (st == 1) {
                return 0
            }
            return st
        }
    }
    let st = run_block(n.dflt, sc)
    if (st == 1) {
        return 0
    }
    return st
}

func ex_unsafe(n, sc) {
    unsafe_begin()
    let st = run_block(n.body, sc)
    unsafe_end()
    return st
}

# Expressions -----------------------------------------------------------------

func ev(n, sc) {
    return EV[n.k](n, sc)
}

func ev_const(n, sc) {
    return n.v
}

func ev_tmpl(n, sc) {
    let out = []
    for (let part in n.parts) {
        if (type(part) == "string") {
            append(out, part)
        } else {
            let v = EV[part.k](part, sc)
            append(out, tostr(v))
        }
    }
    return join(out, "")
}

func ev_id(n, sc) {
    let b = scope_find(sc, n.name)
    if (b != null) {
        return b[0]
    }
    let nat = NATIVES[n.name]
    if (nat != null) {
        return nat
    }
    if (n.name == "null") {
        return null
    }
    CUR_LINE = n.line
    undefined_var(n.name)
}

func ev_list(n, sc) {
    let out = []
    for (let item in n.items) {
        let v = EV[item.k](item, sc)
        CUR_LINE = n.line
        container_check(v)
        append(out, v)
    }
    return out
}

func ev_map(n, sc) {
    let m = {}
    for (let i = 0; i < len(n.keys); i++) {
        let v = EV[n.vals[i].k](n.vals[i], sc)
        CUR_LINE = n.line
        container_check(v)
        m[n.keys[i]] = v
    }
    return m
}

func ev_func(n, sc) {
    return make_closure(n, sc)
}

func ev_bin(n, sc) {
    let op = n.op
    if (op == "and") {
        let l = EV[n.l.k](n.l, sc)
        CUR_LINE = n.line
        if (not truth(l)) {
            return l
        }
        return EV[n.r.k](n.r, sc)
    }
    if (op == "or") {
        let l = EV[n.l.k](n.l, sc)
        CUR_LINE = n.line
        if (truth(l)) {
            return l
        }
        return EV[n.r.k](n.r, sc)
    }
    let l = EV[n.l.k](n.l, sc)
    let r = EV[n.r.k](n.r, sc)
    CUR_LINE = n.line
    return binary(op, l, r)
}

func ev_not(n, sc) {
    let v = EV[n.e.k](n.e, sc)
    CUR_LINE = n.line
    return not truth(v)
}

func ev_incdec(n, sc) {
    CUR_LINE = n.line
    let b = scope_find(sc, n.name)
    if (b == null) {
        undefined_var(n.name)
    }
    let v = null
    if (n.op == "++") {
        v = arith("+", b[0], 1)
    } else {
        v = arith("-", b[0], 1)
    }
    assign_var(sc, n.name, v)
    return v
}

func ev_input(n, sc) {
    CUR_LINE = n.line
    if (n.prompt != null) {
        out_text(n.prompt)
    }
    return input("")
}

func ev_index(n, sc) {
    let t = EV[n.target.k](n.target, sc)
    let i = EV[n.index.k](n.index, sc)
    CUR_LINE = n.line
    return index_get(t, i)
}

func ev_field(n, sc) {
    let t = EV[n.target.k](n.target, sc)
    CUR_LINE = n.line
    return field_get(t, n.field)
}

func ev_box(n, sc) {
    let size = EV[n.size.k](n.size, sc)
    CUR_LINE = n.line
    return box_new(size, sc)
}

func ev_args(nodes, sc) {
    let out = []
    for (let a in nodes) {
        append(out, EV[a.k](a, sc))
    }
    return out
}

func ev_call(n, sc) {
    let cn = n.callee
    if (cn.k == "id") {
        let name = cn.name
        if (name == "defer" and len(n.args) == 1 and n.args[0].k == "call" and scope_find(sc, name) == null) {
            return defer_call(n, sc)
        }
        if ((name == "address_of" or name == "addr") and scope_find(sc, name) == null) {
            return ev_address_of(n, sc)
        }
    }
    let f = EV[cn.k](cn, sc)
    let args = ev_args(n.args, sc)
    CUR_LINE = n.line
    return call_value(f, args, cn)
}

# defer(f(args)): the callee and arguments are captured now and called when the
# scope exits.
func defer_call(n, sc) {
    let inner = n.args[0]
    let f = EV[inner.callee.k](inner.callee, sc)
    let args = ev_args(inner.args, sc)
    let d = sc["@d"]
    if (d == null) {
        d = []
        sc["@d"] = d
    }
    append(d, {"f": f, "args": args, "line": n.line})
    return null
}

func ev_address_of(n, sc) {
    CUR_LINE = n.line
    if (len(n.args) == 1 and n.args[0].k == "id") {
        let b = scope_find(sc, n.args[0].name)
        if (b == null) {
            undefined_var(n.args[0].name)
        }
        return address_of_var(b)
    }
    return address_of_invalid(len(n.args))
}

# Calls ----------------------------------------------------------------------------

func call_value(f, args, cn) {
    let k = vkind(f)
    if (k == "fn") {
        if (UNSAFE_DEPTH > 0) {
            unsafe_error(11)
        }
        return call_fn(f, args)
    }
    if (k == "native") {
        return call_builtin(f.name, args)
    }
    if (k == "dtype" or k == "bloctype") {
        return construct(f, args)
    }
    let name = "value"
    if (cn != null and cn.k == "id") {
        name = cn.name
    }
    type_error("'{name}' is not a function", "Make sure you are calling a function value, closure, or native builtin")
}

func arity_error(name, na, lo, hi) {
    let plural = "s"
    if (hi == 1) {
        plural = ""
    }
    if (lo == hi) {
        arg_error("{name}() expects {lo} argument{plural}, but got {na}", "Pass one value per parameter")
    }
    arg_error("{name}() expects {lo} to {hi} arguments, but got {na}", "Pass one value per required parameter")
}

func call_fn(f, args) {
    let n = f.node
    let na = len(args)
    let np = len(n.params)
    if (na < n.required or na > np) {
        let name = n.name
        if (name == null) {
            name = "<anonymous>"
        }
        arity_error(name, na, n.required, np)
    }
    if (CALL_DEPTH >= CALL_LIMIT) {
        rt_error("stack overflow: recursion is too deep", "Luna allows 4096 nested calls. Check for a recursion that never stops.")
    }
    CALL_DEPTH += 1
    FUNC_DEPTH += 1
    let saved_cur = CUR
    let saved_line = CUR_LINE
    CUR = f.mod
    let sc = {"@p": f.env}
    let params = n.params
    for (let i = 0; i < np; i++) {
        if (i < na) {
            sc[params[i]] = [args[i]]
        } else {
            let d = n.defaults[i]
            sc[params[i]] = [EV[d.k](d, sc)]
        }
    }
    let st = exec_list(n.body, sc)
    let result = null
    if (st == 3) {
        result = RETV
        RETV = null
    }
    leave_scope(sc)
    CUR = saved_cur
    CUR_LINE = saved_line
    FUNC_DEPTH -= 1
    CALL_DEPTH -= 1
    return result
}

# Indexing -------------------------------------------------------------------------

func index_oob(idx, n, what, hint) {
    fail("Index Error", "Index {idx} is out of bounds for {what} of length {n}", hint)
}

func index_get(t, i) {
    let tt = type(t)
    if (tt == "list" or tt == "string") {
        if (not is_int(i)) {
            let what = "list"
            if (tt == "string") {
                what = "string"
            }
            type_error("{what} index must be an int, got {tname(i)}", "Use an int index")
        }
        let n = len(t)
        let idx = i
        if (idx < 0) {
            idx += n
        }
        if (idx < 0 or idx >= n) {
            index_oob(i, n, tt, "Ensure your index is between 0 and len-1")
        }
        return t[idx]
    }
    if (tt == "map") {
        let k = t["@k"]
        if (k == null) {
            if (type(i) != "string") {
                type_error("map key must be a string, got {tname(i)}", "Maps use string keys")
            }
            return t[i]
        }
        return special_index(k, t, i)
    }
    type_error("cannot index {tname(t)}", "Index lists and strings with ints, maps with strings")
}

func field_get(t, name) {
    if (type(t) == "map") {
        let k = t["@k"]
        if (k == null) {
            return t[name]
        }
        return special_field(k, t, name)
    }
    type_error("cannot read field '{name}' of {tname(t)}", "Dot access works on maps")
}

func index_set(t, i, v) {
    let tt = type(t)
    if (tt == "list") {
        if (not is_int(i)) {
            type_error("list index must be an int, got {tname(i)}", "Use an int index")
        }
        container_check(v)
        let n = len(t)
        let idx = i
        if (idx < 0) {
            idx += n
        }
        if (idx < 0 or idx >= n) {
            index_oob(i, n, "list", "Ensure your index is between 0 and len(list)-1")
        }
        t[idx] = v
        return null
    }
    if (tt == "map") {
        let k = t["@k"]
        if (k == null) {
            if (type(i) != "string") {
                type_error("map key must be a string, got {tname(i)}", "Maps use string keys")
            }
            container_check(v)
            t[i] = v
            return null
        }
        return special_index_set(k, t, i, v)
    }
    type_error("Cannot assign through this target", "Use integer indices for lists, or string keys for maps and templates")
}

# ---------------------------------------------------------------------------
# Builtins
#
# SPEC gives each builtin's argument count and a letter per argument:
#   a any, s string (a char is accepted), i int, n number, l list, m map, f file.
# Builtins that touch the interpreter's own value kinds are written out below;
# the rest call the host's builtin of the same name.
# ---------------------------------------------------------------------------

let SPEC = {}
let HOST = {}
let IMPL = {}

func spec(name, lo, hi, kinds) {
    SPEC[name] = [lo, hi, kinds]
}

func init_spec() {
    spec("len", 1, 1, "a")
    spec("str_len", 1, 1, "a")
    spec("append", 2, 2, "la")
    spec("list_append", 2, 2, "la")
    spec("type", 1, 1, "a")
    spec("int", 1, 1, "a")
    spec("float", 1, 1, "a")
    spec("to_string", 1, 1, "a")
    spec("to_int", 1, 1, "a")
    spec("to_float", 1, 1, "a")
    spec("assert", 0, 99, "")
    spec("input", 0, 1, "a")
    spec("debug", 1, 1, "a")
    spec("range", 1, 3, "iii")
    spec("args", 0, 0, "")
    spec("exit", 0, 1, "i")
    spec("clock", 0, 0, "")
    spec("shape", 1, 1, "a")
    spec("map_set", 3, 3, "msa")
    spec("map_get", 2, 2, "ms")
    spec("map_has", 2, 2, "ms")
    spec("map_delete", 2, 2, "ms")
    spec("map_keys", 1, 1, "m")
    spec("map_values", 1, 1, "m")
    spec("map_items", 1, 1, "m")
    spec("remove", 2, 2, "li")
    spec("find", 2, 2, "la")
    spec("slice", 3, 3, "aii")
    spec("sort", 1, 1, "l")
    spec("shuffle", 0, 99, "")
    spec("ssort", 0, 99, "")
    spec("map", 2, 2, "la")
    spec("filter", 2, 2, "la")
    spec("reduce", 3, 3, "laa")
    spec("dense_list", 0, 99, "")
    spec("vec_add", 0, 99, "")
    spec("vec_sub", 0, 99, "")
    spec("vec_mul", 0, 99, "")
    spec("vec_div", 0, 99, "")
    spec("vec_mul_inline", 0, 99, "")
    spec("mat_mul", 0, 99, "")
    spec("is_empty", 1, 1, "s")
    spec("concat", 2, 2, "ss")
    spec("substring", 3, 3, "sii")
    spec("char_at", 2, 2, "si")
    spec("index_of", 2, 2, "ss")
    spec("last_index_of", 2, 2, "ss")
    spec("contains", 2, 2, "ss")
    spec("starts_with", 2, 2, "ss")
    spec("ends_with", 2, 2, "ss")
    spec("to_upper", 1, 1, "s")
    spec("to_lower", 1, 1, "s")
    spec("trim", 1, 1, "s")
    spec("trim_left", 1, 1, "s")
    spec("trim_right", 1, 1, "s")
    spec("replace", 3, 3, "sss")
    spec("reverse", 1, 1, "s")
    spec("repeat", 2, 2, "si")
    spec("pad_left", 3, 3, "sis")
    spec("pad_right", 3, 3, "sis")
    spec("format", 1, 99, "s")
    spec("split", 2, 2, "ss")
    spec("join", 2, 2, "ls")
    spec("is_digit", 1, 1, "s")
    spec("is_alpha", 1, 1, "s")
    spec("is_alnum", 1, 1, "s")
    spec("is_space", 1, 1, "s")
    spec("abs", 1, 1, "n")
    spec("min", 2, 2, "nn")
    spec("max", 2, 2, "nn")
    spec("clamp", 3, 3, "nnn")
    spec("sign", 1, 1, "n")
    spec("pow", 2, 2, "nn")
    spec("atan2", 2, 2, "nn")
    spec("mod", 2, 2, "nn")
    spec("lerp", 3, 3, "nnn")
    spec("rand", 0, 2, "nn")
    spec("srand", 0, 1, "n")
    spec("trand", 0, 0, "")
    for (let name in split("sqrt cbrt exp ln log10 sin cos tan asin acos atan sinh cosh tanh floor ceil round trunc fract deg_to_rad rad_to_deg", " ")) {
        spec(name, 1, 1, "n")
    }
    spec("open", 2, 2, "ss")
    spec("close", 1, 1, "f")
    spec("read", 1, 1, "f")
    spec("read_line", 1, 1, "f")
    spec("write", 2, 2, "fa")
    spec("file_exists", 1, 1, "s")
    spec("remove_file", 1, 1, "s")
    spec("flush", 1, 1, "f")
    spec("alloc", 1, 1, "a")
    spec("free", 1, 1, "a")
    spec("load", 1, 1, "a")
    spec("deref", 1, 1, "a")
    spec("store", 2, 2, "aa")
    spec("ptr_offset", 2, 2, "aa")
    spec("ptr_add", 2, 2, "aa")
    spec("defer", 1, 1, "a")
}

