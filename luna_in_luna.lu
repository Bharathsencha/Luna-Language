func kind_phrase(letter) {
    if (letter == "s") {
        return "a string"
    }
    if (letter == "i") {
        return "an int"
    }
    if (letter == "n") {
        return "a number"
    }
    if (letter == "l") {
        return "a list"
    }
    if (letter == "m") {
        return "a map"
    }
    return "a file"
}

func arg_matches(letter, v) {
    if (letter == "s") {
        return type(v) == "string"
    }
    if (letter == "i") {
        return is_int(v)
    }
    if (letter == "n") {
        return is_num(v)
    }
    if (letter == "l") {
        return type(v) == "list"
    }
    if (letter == "m") {
        return vkind(v) == "map"
    }
    if (letter == "f") {
        return type(v) == "file"
    }
    return true
}

# Checks the arguments against SPEC and turns chars into strings where a string
# is wanted. Returns the (possibly rewritten) argument list.
func check_args(name, args) {
    let sp = SPEC[name]
    let na = len(args)
    if (na < sp[0] or na > sp[1]) {
        arity_error(name, na, sp[0], sp[1])
    }
    let kinds = sp[2]
    let out = args
    for (let i = 0; i < len(kinds) and i < na; i++) {
        let letter = "{kinds[i]}"
        let v = args[i]
        if (letter == "s" and type(v) == "char") {
            if (out == args) {
                out = slice(args, 0, na)
            }
            out[i] = "{v}"
        } else if (not arg_matches(letter, v)) {
            type_error("{name}() argument {i + 1} must be {kind_phrase(letter)}, got {tname(v)}", null)
        }
    }
    return out
}

func call_builtin(name, args) {
    let sp = SPEC[name]
    if (sp == null) {
        undefined_var(name)
    }
    let a = check_args(name, args)
    let h = IMPL[name]
    if (h != null) {
        return h(a)
    }
    let f = HOST[name]
    let n = len(a)
    if (n == 0) {
        return f()
    }
    if (n == 1) {
        return f(a[0])
    }
    if (n == 2) {
        return f(a[0], a[1])
    }
    return f(a[0], a[1], a[2])
}

# Truthiness as assert() and filter() use it (looser than a condition).
func loose_truth(v) {
    let t = type(v)
    if (t == "boolean") {
        return v
    }
    if (t == "int" or t == "long") {
        return v != 0
    }
    if (t == "float") {
        return v != 0.0
    }
    if (t == "string") {
        return len(v) > 0
    }
    if (t == "char") {
        return int(v) != 0
    }
    if (t == "null") {
        return false
    }
    if (vkind(v) == "ptr") {
        return ptr_address(v) != 0
    }
    return true
}

# Builtins written out -------------------------------------------------------------

func b_len(a) {
    let v = a[0]
    let t = type(v)
    if (t == "string" or t == "list") {
        return len(v)
    }
    if (t == "map") {
        let k = v["@k"]
        if (k == null) {
            return len(v)
        }
        if (k == "tpl") {
            return len(v.vals)
        }
        if (k == "box") {
            return box_length(v)
        }
    }
    type_error("len() needs a string, list or map, got {tname(v)}", null)
}

func b_append(a) {
    container_check(a[1])
    append(a[0], a[1])
    return null
}

func b_type(a) {
    let v = a[0]
    let t = type(v)
    if (t == "map") {
        return type_name(v)
    }
    return t
}

func b_int(a) {
    let v = a[0]
    let k = vkind(v)
    if (k == "ptr") {
        if (is_registered_pointer(v)) {
            return ptr_address(v)
        }
    }
    if (k == "int" or k == "long") {
        return v
    }
    if (k == "float") {
        if (not (v > -9300000000000000000.0 and v < 9300000000000000000.0)) {
            rt_error("int() of a float that does not fit in 64 bits", null)
        }
        return int(v)
    }
    if (k == "char" or k == "boolean" or k == "string") {
        return int(v)
    }
    type_error("int() cannot convert {tname(v)}", null)
}

func b_float(a) {
    let v = a[0]
    let k = vkind(v)
    if (k == "ptr") {
        ptr_cast_check(v, 1)
    }
    if (k == "int" or k == "long" or k == "float" or k == "char" or k == "boolean" or k == "string") {
        return float(v)
    }
    type_error("float() cannot convert {tname(v)}", null)
}

func b_to_string(a) {
    return tostr(a[0])
}

func b_to_int(a) {
    if (type(a[0]) == "string") {
        return to_int(a[0])
    }
    return b_int(a)
}

func b_to_float(a) {
    return b_float(a)
}

func b_assert(a) {
    if (len(a) != 1) {
        arg_error("assert() takes exactly 1 argument", "Use assert(condition) to verify logic.")
    }
    if (not loose_truth(a[0])) {
        fail("Assertion Error", "Assertion failed", "The condition evaluated to false.")
    }
    return true
}

func b_input(a) {
    if (len(a) == 1) {
        out_text(tostr(a[0]))
    }
    return input("")
}

func b_debug(a) {
    out_line("value = {tostr(a[0])}")
    return a[0]
}

func b_range(a) {
    let n = len(a)
    let step = 1
    if (n == 3) {
        step = a[2]
    }
    if (step == 0) {
        arg_error("range() step must not be 0", null)
    }
    if (n == 1) {
        return range(a[0])
    }
    if (n == 2) {
        return range(a[0], a[1])
    }
    return range(a[0], a[1], a[2])
}

func b_args(a) {
    return slice(SCRIPT_ARGS, 0, len(SCRIPT_ARGS))
}

func b_exit(a) {
    if (len(a) == 1) {
        exit(a[0])
    }
    exit(0)
}

func b_map(a) {
    let out = []
    for (let x in a[0]) {
        append(out, call_value(a[1], [x], null))
    }
    return out
}

func b_filter(a) {
    let out = []
    for (let x in a[0]) {
        if (loose_truth(call_value(a[1], [x], null))) {
            append(out, x)
        }
    }
    return out
}

func b_reduce(a) {
    let acc = a[2]
    for (let x in a[0]) {
        acc = call_value(a[1], [acc, x], null)
    }
    return acc
}

func b_slice(a) {
    let t = type(a[0])
    if (t != "list" and t != "string") {
        type_error("slice() argument 1 must be a string, got {tname(a[0])}", null)
    }
    return slice(a[0], a[1], a[2])
}

func b_join(a) {
    let parts = []
    for (let x in a[0]) {
        append(parts, tostr(x))
    }
    return join(parts, a[1])
}

func b_format(a) {
    let f = a[0]
    let out = []
    let next = 1
    let n = len(f)
    let i = 0
    while (i < n) {
        if (f[i] == '\{' and i + 1 < n and f[i + 1] == '}' and next < len(a)) {
            append(out, tostr(a[next]))
            next += 1
            i += 2
        } else {
            append(out, "{f[i]}")
            i += 1
        }
    }
    return join(out, "")
}

func b_write(a) {
    return write(a[0], tostr(a[1]))
}

func b_open(a) {
    let mode = a[1]
    if (mode != "r" and mode != "w" and mode != "a") {
        arg_error("open() mode '{mode}' is not supported", "Use \"r\", \"w\" or \"a\"")
    }
    return open(a[0], mode)
}

func b_shape(a) {
    return shape_of(a[0])
}

func b_defer(a) {
    return defer_pointer(a[0])
}

func init_impl() {
    IMPL["len"] = b_len
    IMPL["str_len"] = b_len
    IMPL["append"] = b_append
    IMPL["list_append"] = b_append
    IMPL["type"] = b_type
    IMPL["int"] = b_int
    IMPL["float"] = b_float
    IMPL["to_string"] = b_to_string
    IMPL["to_int"] = b_to_int
    IMPL["to_float"] = b_to_float
    IMPL["assert"] = b_assert
    IMPL["input"] = b_input
    IMPL["debug"] = b_debug
    IMPL["range"] = b_range
    IMPL["args"] = b_args
    IMPL["exit"] = b_exit
    IMPL["map"] = b_map
    IMPL["filter"] = b_filter
    IMPL["reduce"] = b_reduce
    IMPL["slice"] = b_slice
    IMPL["join"] = b_join
    IMPL["format"] = b_format
    IMPL["write"] = b_write
    IMPL["open"] = b_open
    IMPL["shape"] = b_shape
    IMPL["defer"] = b_defer
    IMPL["alloc"] = b_alloc
    IMPL["free"] = b_free
    IMPL["load"] = b_load
    IMPL["deref"] = b_load
    IMPL["store"] = b_store
    IMPL["ptr_offset"] = b_ptr_offset
    IMPL["ptr_add"] = b_ptr_offset
}

# ---------------------------------------------------------------------------
# data, template, bloc
# ---------------------------------------------------------------------------

let BLOCS = {}
let SCHEMAS = {}

let TYPE_HINT_BLOC = "A bloc holds at most 32 bytes of unique fields; each name keeps one field list"
let TYPE_HINT_DATA = "Each data or template name must keep one field list"
let BLOC_CONSTRUCT_HINT = "Bloc values must stay inline and only use int, float, bool, char, or nested blocs"

# Defines a data, template or bloc type. Done for every top-level definition
# before the program starts, and an error stops the run.
func define_type(n) {
    CUR_LINE = n.line
    if (n.word == "bloc") {
        return define_bloc(n)
    }
    return define_dtype(n)
}

func define_bloc(n) {
    let seen = {}
    let size = 0
    for (let f in n.fields) {
        if (seen[f] != null) {
            fail("Type Error", "bloc has duplicate field names", TYPE_HINT_BLOC)
        }
        seen[f] = true
        size += 8
        if (size > 32) {
            fail("Type Error", "bloc exceeds the cache-line size limit (32 bytes)", TYPE_HINT_BLOC)
        }
    }
    let existing = BLOCS[n.name]
    if (existing != null) {
        if (not same_fields(existing.fields, n.fields)) {
            fail("Type Error", "bloc '{n.name}' is already defined with different fields", TYPE_HINT_BLOC)
        }
        return {"@k": "bloctype", "desc": existing}
    }
    let count = len(n.fields)
    let d = {"name": n.name, "fields": n.fields, "kinds": repeat_list(0, count),
             "nested": repeat_list(null, count), "total": 0, "locked": false}
    BLOCS[n.name] = d
    return {"@k": "bloctype", "desc": d}
}

func same_fields(a, b) {
    if (len(a) != len(b)) {
        return false
    }
    for (let i = 0; i < len(a); i++) {
        if (a[i] != b[i]) {
            return false
        }
    }
    return true
}

func repeat_list(v, count) {
    let out = []
    for (let i = 0; i < count; i++) {
        append(out, v)
    }
    return out
}

func define_dtype(n) {
    let is_template = n.word == "template"
    if (is_template) {
        let seen = {}
        for (let f in n.fields) {
            if (seen[f] != null) {
                fail("Type Error", "template has duplicate field names", TYPE_HINT_DATA)
            }
            seen[f] = true
        }
    }
    let existing = SCHEMAS[n.name]
    if (existing != null) {
        if (not same_fields(existing.fields, n.fields) or existing.tmpl != is_template) {
            let what = "data type"
            if (is_template) {
                what = "template"
            }
            fail("Type Error", "{what} '{n.name}' is already defined with different fields", TYPE_HINT_DATA)
        }
    } else {
        SCHEMAS[n.name] = {"fields": n.fields, "tmpl": is_template}
    }
    return {"@k": "dtype", "name": n.name, "fields": n.fields, "tmpl": is_template}
}

# Bloc slot kinds: 5 = nested bloc, 6 = a primitive (int, float, bool or char).
func bloc_slot_class(v) {
    let t = type(v)
    if (t == "int" or t == "long" or t == "float" or t == "boolean" or t == "char") {
        return 6
    }
    if (vkind(v) == "bloc") {
        return 5
    }
    return 0
}

func bloc_construct(bt, args) {
    if (UNSAFE_DEPTH > 0) {
        type_error("box and bloc values are not allowed inside unsafe blocks", BLOC_CONSTRUCT_HINT)
    }
    let d = bt.desc
    let argc = len(args)
    if (argc != len(d.fields)) {
        type_error("Bloc '{d.name}' expects {len(d.fields)} field value(s), but got {argc}", BLOC_CONSTRUCT_HINT)
    }
    let offset = 0
    for (let i = 0; i < argc; i++) {
        let v = args[i]
        let cls = bloc_slot_class(v)
        if (cls == 0) {
            type_error("Bloc field '{d.fields[i]}' only accepts int, float, bool, char, or another bloc", BLOC_CONSTRUCT_HINT)
        }
        let size = 8
        let nested = null
        if (cls == 5) {
            nested = v.desc
            size = nested.total
        }
        if (size <= 0) {
            type_error("Bloc field '{d.fields[i]}' has an invalid inline size", BLOC_CONSTRUCT_HINT)
        }
        if (d.locked) {
            if (d.kinds[i] != cls) {
                if (d.kinds[i] == 5) {
                    type_error("Bloc '{d.name}' field '{d.fields[i]}' must hold a nested bloc", BLOC_CONSTRUCT_HINT)
                }
                type_error("Bloc '{d.name}' field '{d.fields[i]}' must hold an int, float, bool or char", BLOC_CONSTRUCT_HINT)
            }
            if (cls == 5 and d.nested[i] != nested) {
                type_error("Bloc '{d.name}' field '{d.fields[i]}' must use the same nested bloc type", BLOC_CONSTRUCT_HINT)
            }
        } else {
            d.kinds[i] = cls
            d.nested[i] = nested
            offset += size
        }
    }
    if (not d.locked) {
        if (offset > 32) {
            type_error("Bloc '{d.name}' exceeds the 32-byte cache-line cap", BLOC_CONSTRUCT_HINT)
        }
        d.total = offset
        d.locked = true
    }
    return {"@k": "bloc", "desc": d, "vals": slice(args, 0, argc)}
}

func bloc_equal(a, b) {
    if (a.desc != b.desc) {
        return false
    }
    let n = len(a.vals)
    for (let i = 0; i < n; i++) {
        let x = a.vals[i]
        let y = b.vals[i]
        if (vkind(x) == "bloc") {
            if (vkind(y) != "bloc" or not bloc_equal(x, y)) {
                return false
            }
        } else if (is_int(x) and is_int(y)) {
            if (x != y) {
                return false
            }
        } else if (type(x) != type(y) or x != y) {
            return false
        }
    }
    return true
}

func construct(t, args) {
    if (t["@k"] == "bloctype") {
        return bloc_construct(t, args)
    }
    let argc = len(args)
    if (argc != len(t.fields)) {
        fail("Argument Error", "Data constructor '{t.name}' expects {len(t.fields)} field value(s), but got {argc}", "Pass one value for each declared data field")
    }
    if (t.tmpl) {
        let vals = slice(args, 0, argc)
        for (let v in vals) {
            box_promote(v)
        }
        return {"@k": "tpl", "dt": t, "vals": vals}
    }
    let m = {"__tag": t.name}
    for (let i = 0; i < argc; i++) {
        m[t.fields[i]] = args[i]
    }
    return m
}

func find_field(fields, name) {
    for (let i = 0; i < len(fields); i++) {
        if (fields[i] == name) {
            return i
        }
    }
    return -1
}

func shape_of(v) {
    let k = vkind(v)
    if (k == "bloc") {
        return v.desc.name
    }
    if (k == "box") {
        return "box"
    }
    if (k == "tpl") {
        return v.dt.name
    }
    if (k == "map") {
        let tag = v["__tag"]
        if (type(tag) == "string") {
            return tag
        }
    }
    return null
}

# Reading and writing members of the special kinds ---------------------------------

func no_field(t, name) {
    if (t["@k"] == "tpl") {
        name_error("Template field '{name}' does not exist", "Access only declared fields for this template")
    }
    name_error("Field '{name}' does not exist on this bloc value", "Use dot access with a declared bloc field such as point.x")
}

func special_field(k, t, name) {
    if (k == "tpl") {
        let i = find_field(t.dt.fields, name)
        if (i < 0) {
            no_field(t, name)
        }
        return t.vals[i]
    }
    if (k == "bloc") {
        let i = find_field(t.desc.fields, name)
        if (i < 0) {
            no_field(t, name)
        }
        return t.vals[i]
    }
    if (k == "box") {
        box_check_live(t)
        if (name == "len" or name == "cap") {
            return box_slot(t).len
        }
        name_error("Field '{name}' does not exist on this box value", "Use box.len or box.cap for phase-1 box values")
    }
    type_error("cannot read field '{name}' of {tname(t)}", "Dot access works on maps")
}

func special_index(k, t, i) {
    if ((k == "tpl" or k == "bloc") and type(i) == "string") {
        return special_field(k, t, i)
    }
    if (k == "box") {
        return box_get_byte(t, i)
    }
    type_error("cannot index {tname(t)}", "Index lists and strings with ints, maps with strings")
}

func special_index_set(k, t, i, v) {
    if (k == "box") {
        return box_set_byte(t, i, v)
    }
    if (k == "tpl") {
        if (type(i) != "string") {
            type_error("Template assignment index must be a string", "Use template[\"field\"] = value or template.field = value")
        }
        ptr_store_check(v)
        let j = find_field(t.dt.fields, i)
        if (j < 0) {
            name_error("Template field '{i}' does not exist", "Assign only to declared template fields")
        }
        t.vals[j] = v
        box_promote(v)
        return null
    }
    if (k == "bloc") {
        type_error("bloc values are immutable", "Build a new bloc, or use a template for data that changes")
    }
    type_error("Cannot assign through this target", "Use integer indices for lists, or string keys for maps and templates")
}

# ---------------------------------------------------------------------------
# box
# ---------------------------------------------------------------------------

let BOX_MAX = 4096
let BOX_SLOTS = []         # slot maps, created on demand
let BOX_FREE = []          # indexes of free slots
let BOX_LIVE = {}          # handle -> true (live) or false (freed)
let BOX_HINT = "Use box[n] with n between 1 and 4096; at most 4096 boxes can be live at once"

func box_handle(index, gen) {
    return gen * 4294967296 + index + 1
}

func box_slot(b) {
    let h = b.h
    let index = h % 4294967296
    if (index == 0 or index > BOX_MAX or index > len(BOX_SLOTS)) {
        return null
    }
    let s = BOX_SLOTS[index - 1]
    if (not s.live or s.gen != h / 4294967296) {
        return null
    }
    return s
}

func box_new(size, sc) {
    if (not is_int(size)) {
        type_error("box[...] expects an integer byte size", "Use box[128] or another positive integer size")
    }
    if (UNSAFE_DEPTH > 0) {
        arg_error("box and bloc values are not allowed inside unsafe blocks", BOX_HINT)
    }
    if (size < 1 or size > 4096) {
        arg_error("box size must be between 1 and 4096 bytes", BOX_HINT)
    }
    let index = -1
    if (len(BOX_FREE) > 0) {
        index = remove(BOX_FREE, len(BOX_FREE) - 1)
    } else if (len(BOX_SLOTS) < BOX_MAX) {
        append(BOX_SLOTS, {"live": false, "gen": 0, "owned": false, "len": 0, "bytes": null, "scope": null})
        index = len(BOX_SLOTS) - 1
    } else {
        arg_error("box allocation failed: more than 4096 boxes are live at once", BOX_HINT)
    }
    let s = BOX_SLOTS[index]
    s.live = true
    s.owned = false
    s.len = size
    s.bytes = repeat_list(0, size)
    let h = box_handle(index, s.gen)
    let live_key = to_string(h)
    BOX_LIVE[live_key] = true
    if (sc["@g"] == null) {
        let list = sc["@b"]
        if (list == null) {
            list = []
            sc["@b"] = list
        }
        append(list, h)
    }
    return {"@k": "box", "h": h}
}

func box_free_slot(h) {
    let index = h % 4294967296 - 1
    let s = BOX_SLOTS[index]
    let dead_key = to_string(h)
    BOX_LIVE[dead_key] = false
    s.live = false
    s.bytes = null
    s.len = 0
    s.gen += 1
    s.owned = false
    append(BOX_FREE, index)
}

# Called when the scope a box was made in ends.
func box_release(h) {
    let index = h % 4294967296 - 1
    let s = BOX_SLOTS[index]
    if (s.live and s.gen == h / 4294967296 and not s.owned) {
        box_free_slot(h)
    }
}

func box_promote(v) {
    if (type(v) == "map" and v["@k"] == "box") {
        let s = box_slot(v)
        if (s != null) {
            s.owned = true
        }
    }
}

# A box is freed when its scope ends, so it may not outlive that scope.
func box_escape_check(v, where) {
    if (type(v) != "map" or v["@k"] != "box") {
        return null
    }
    let s = box_slot(v)
    if (s != null and s.owned) {
        return null
    }
    rt_error("a box cannot be {where}; it is freed when its scope ends", "Keep the box in a local variable, or store it in a template field.")
}

func box_was_freed(h) {
    let k = to_string(h)
    return BOX_LIVE[k] == false
}

func box_dead_message(b, action) {
    if (box_was_freed(b.h)) {
        return "box was already freed ({action})"
    }
    return "expected a live box value"
}

func box_check_live(b) {
    if (box_slot(b) == null) {
        let msg = "expected a live box value"
        if (box_was_freed(b.h)) {
            msg = "box was already freed (use-after-free)"
        }
        rt_error(msg, "Do not use a box after it is freed.")
    }
}

func box_length(b) {
    box_check_live(b)
    return box_slot(b).len
}

func box_text(b) {
    let s = box_slot(b)
    if (s == null) {
        if (box_was_freed(b.h)) {
            return "<box freed>"
        }
        return "<box invalid>"
    }
    return "<box len={s.len} cap={s.len}>"
}

func box_byte_slot(b, i, type_hint, hint) {
    if (not is_int(i)) {
        type_error("box index must be an integer", type_hint)
    }
    let s = box_slot(b)
    if (s == null) {
        let msg = "expected a live box value"
        if (box_was_freed(b.h)) {
            msg = "box was already freed (use-after-free)"
        }
        rt_error(msg, hint)
    }
    let idx = i
    if (idx < 0) {
        idx += s.len
    }
    if (idx < 0 or idx >= s.len) {
        rt_error("box index {idx} is out of bounds for a box of {s.len} bytes", hint)
    }
    return [s, idx]
}

func box_get_byte(b, i) {
    let hint = "Use b[i] with 0 <= i < b.len"
    let r = box_byte_slot(b, i, hint, hint)
    return r[0].bytes[r[1]]
}

func box_set_byte(b, i, v) {
    let r = box_byte_slot(b, i, "Use b[i] = byte with 0 <= i < b.len", "Use b[i] = byte with 0 <= i < b.len and 0 <= byte <= 255")
    if (not is_int(v) or v < 0 or v > 255) {
        rt_error("box bytes must be integers from 0 to 255", "Use b[i] = byte with 0 <= i < b.len and 0 <= byte <= 255")
    }
    r[0].bytes[r[1]] = v
    return null
}

func b_free(a) {
    let v = a[0]
    if (vkind(v) == "box") {
        let s = box_slot(v)
        if (s == null) {
            let msg = "free() expects a live box value"
            if (box_was_freed(v.h)) {
                msg = "box was already freed (double free)"
            }
            rt_error(msg, "A box must be freed exactly once")
        }
        if (s.owned) {
            rt_error("this box belongs to a template and is freed with it", "A box must be freed exactly once")
        }
        box_free_slot(v.h)
        return null
    }
    need_unsafe("free")
    if (vkind(v) != "ptr" or v.bad) {
        type_error("free() expects a pointer value", "Pass a pointer returned by alloc(), address_of(), or ptr_add().")
    }
    if (v.kind != "alloc" or v.off != 0) {
        unsafe_error(13)
    }
    if (v.a.poisoned) {
        unsafe_error(4)
    }
    v.a.poisoned = true
    return null
}

# Container stores: no raw pointers (R7) and no scoped boxes.
func container_check(v) {
    if (type(v) != "map") {
        return null
    }
    let k = v["@k"]
    if (k == "ptr") {
        ptr_store_check(v)
    } else if (k == "box") {
        box_escape_check(v, "stored in a list or map")
    }
}

# Assignment to a global variable: pointers may not leave an unsafe block (R2)
# and boxes may not leave the function that made them.
func global_store_check(v) {
    if (type(v) != "map") {
        return null
    }
    let k = v["@k"]
    if (k == "ptr" and UNSAFE_DEPTH > 0 and not v.bad) {
        unsafe_error(2)
    }
    if (k == "box" and FUNC_DEPTH > 0) {
        box_escape_check(v, "assigned to a global from inside a function")
    }
}

# ---------------------------------------------------------------------------
# unsafe blocks and pointers
#
# A pointer is {"@k": "ptr", "kind": "alloc" or "addr", "a": the allocation or
# the variable's box, "off": cell offset, "base": numeric base, "bad": true for
# an address that points into nothing}.
# ---------------------------------------------------------------------------

let UNSAFE_DEPTH = 0
let UNSAFE_DEFERS = []
let NEXT_BASE = 1

func unsafe_message(code) {
    if (code == 1) { return "cannot take address_of() of a pointer value" }
    if (code == 2) { return "pointer cannot escape the current unsafe block" }
    if (code == 3) { return "ptr_add() moved outside the allocation bounds" }
    if (code == 4) { return "pointer was freed or freed twice" }
    if (code == 5) { return "address_of() only works on named values" }
    if (code == 6) { return "nested unsafe blocks are not allowed" }
    if (code == 7) { return "pointers cannot be stored inside GC-managed values" }
    if (code == 8) { return "alloc() size must be a positive integer" }
    if (code == 9) { return "ordered pointer comparisons need the same base allocation" }
    if (code == 10) { return "pointers may only be cast to int" }
    if (code == 11) { return "only builtin calls are allowed inside unsafe blocks" }
    if (code == 12) { return "free() may not appear inside conditional control flow" }
    return "unsafe error: pointer is not registered in the runtime"
}

func unsafe_hint(code) {
    if (code == 1) { return "address_of() only works on normal values. If you already have a pointer, use it directly." }
    if (code == 2) { return "Pointers must stay inside the current unsafe block. Copy the pointed-to value out instead." }
    if (code == 3) { return "That pointer step moved past the allocated buffer. Keep ptr_add() within the allocated slot range." }
    if (code == 4) { return "That pointer is no longer valid. Prefer defer(ptr) so cleanup happens once at block exit." }
    if (code == 5) { return "address_of() needs a variable name such as address_of(x), not a temporary expression." }
    if (code == 6) { return "Nested unsafe blocks are not supported. Merge the inner block into the outer one." }
    if (code == 7) { return "Pointers cannot go into lists or maps because those values are GC-managed." }
    if (code == 8) { return "alloc() needs a positive whole-number slot count, for example alloc(4)." }
    if (code == 9) { return "Only compare pointers with <, >, <=, or >= when they come from the same allocation." }
    if (code == 10) { return "Only int(ptr) is allowed for pointer casts." }
    if (code == 11) { return "Inside unsafe, call builtins only. Move user-defined function calls outside the block." }
    if (code == 12) { return "Do not put free(ptr) inside if/while/for/switch branches. Use defer(ptr) or free it unconditionally." }
    return "Use a pointer returned by alloc(), address_of(), or ptr_add()."
}

func unsafe_error(code) {
    rt_error(unsafe_message(code), unsafe_hint(code))
}

func unsafe_begin() {
    if (UNSAFE_DEPTH > 0) {
        unsafe_error(6)
    }
    UNSAFE_DEPTH = 1
}

func unsafe_end() {
    UNSAFE_DEPTH = 0
    for (let p in UNSAFE_DEFERS) {
        p.a.poisoned = true
    }
    UNSAFE_DEFERS = []
}

func need_unsafe(fn_name) {
    if (UNSAFE_DEPTH == 0) {
        rt_error("{fn_name}() may only be used inside unsafe blocks", "Wrap pointer operations in unsafe \{ ... }")
    }
}

func is_registered_pointer(v) {
    return type(v) == "map" and v["@k"] == "ptr" and not v.bad
}

func ptr_address(p) {
    return p.base * 1048576 + p.off * 16
}

# R7: a pointer may not be stored in a GC-managed value.
func ptr_store_check(v) {
    if (UNSAFE_DEPTH > 0 and is_registered_pointer(v)) {
        unsafe_error(7)
    }
}

# R9: ordered comparison of pointers needs a single allocation.
func ptr_compare_check(a, b, op) {
    if (not is_registered_pointer(a) or not is_registered_pointer(b)) {
        return null
    }
    if (op == 0 or op == 1) {
        return null
    }
    if (a.base != b.base) {
        unsafe_error(9)
    }
}

# R10: only int(ptr) may cast a pointer.
func ptr_cast_check(v, target) {
    if (is_registered_pointer(v)) {
        unsafe_error(10)
    }
}

func new_pointer(kind, a, off, base, bad) {
    return {"@k": "ptr", "kind": kind, "a": a, "off": off, "base": base, "bad": bad}
}

func b_alloc(a) {
    need_unsafe("alloc")
    let n = a[0]
    if (not is_int(n) or n <= 0) {
        unsafe_error(8)
    }
    let alloc = {"cells": repeat_list(null, n), "init": repeat_list(false, n), "size": n, "poisoned": false}
    let base = NEXT_BASE
    NEXT_BASE += 1
    return new_pointer("alloc", alloc, 0, base, false)
}

func pointer_arg(v) {
    if (not is_registered_pointer(v)) {
        unsafe_error(13)
    }
    return v
}

func b_load(a) {
    need_unsafe("load")
    let p = pointer_arg(a[0])
    if (p.kind == "alloc") {
        if (p.a.poisoned) {
            unsafe_error(4)
        }
        if (p.a.init[p.off]) {
            return p.a.cells[p.off]
        }
        return null
    }
    return p.a[0]
}

func b_store(a) {
    need_unsafe("store")
    let p = pointer_arg(a[0])
    if (p.kind == "alloc" and p.a.poisoned) {
        unsafe_error(4)
    }
    ptr_store_check(a[1])
    if (p.kind == "alloc") {
        p.a.cells[p.off] = a[1]
        p.a.init[p.off] = true
    } else {
        p.a[0] = a[1]
    }
    return null
}

func b_ptr_offset(a) {
    need_unsafe("ptr_offset")
    let p = a[0]
    let n = a[1]
    if (not is_registered_pointer(p) or not is_int(n)) {
        type_error("ptr_add() expects a pointer and an integer offset", "Use ptr_add(buf, 1).")
    }
    if (p.kind == "alloc") {
        if (p.off != 0) {
            unsafe_error(13)
        }
        if (p.a.poisoned) {
            unsafe_error(4)
        }
        if (n < 0 or n >= p.a.size) {
            unsafe_error(3)
        }
        return new_pointer("alloc", p.a, n, p.base, false)
    }
    if (n == 0) {
        return p
    }
    return new_pointer("addr", p.a, n, p.base, true)
}

func variable_base(b) {
    if (len(b) == 1) {
        append(b, NEXT_BASE)
        NEXT_BASE += 1
    }
    return b[1]
}

func address_of_var(b) {
    if (is_registered_pointer(b[0])) {
        unsafe_error(1)
    }
    return new_pointer("addr", b, 0, variable_base(b), false)
}

func address_of_invalid(given) {
    if (UNSAFE_DEPTH == 0) {
        rt_error("address_of() may only be used inside unsafe blocks", "Wrap pointer operations in unsafe \{ ... }")
    }
    if (given != 1) {
        arg_error("address_of() expects exactly 1 argument", "Use address_of(variableName)")
    }
    rt_error("address_of() only works on named values", "address_of() needs a variable name such as address_of(x), not a temporary expression.")
}

func defer_pointer(v) {
    if (UNSAFE_DEPTH > 0 and is_registered_pointer(v)) {
        if (v.kind == "alloc") {
            append(UNSAFE_DEFERS, v)
        }
        return null
    }
    arg_error("defer() expects a call expression", "Use defer(close(file)) or another function call to schedule cleanup")
}

# ---------------------------------------------------------------------------
# Modules
# ---------------------------------------------------------------------------

let MODULES = {}
let MODULE_COUNT = 0

func path_dir(p) {
    let i = last_index_of(p, "/")
    if (i < 0) {
        return ""
    }
    if (i == 0) {
        return "/"
    }
    return slice(p, 0, i)
}

func path_join(dir, rel) {
    if (starts_with(rel, "/") or dir == "") {
        return rel
    }
    if (dir == "/") {
        return "/{rel}"
    }
    return "{dir}/{rel}"
}

# Resolves "." and ".." segments.
func path_norm(p) {
    let absolute = starts_with(p, "/")
    let out = []
    for (let seg in split(p, "/")) {
        if (seg == "." or seg == "") {
            continue
        }
        if (seg == ".." and len(out) > 0 and out[len(out) - 1] != "..") {
            remove(out, len(out) - 1)
        } else if (seg == ".." and absolute) {
            continue
        } else {
            append(out, seg)
        }
    }
    let joined = join(out, "/")
    if (absolute) {
        return "/{joined}"
    }
    return joined
}

func collect_exports(stmts, out) {
    for (let s in stmts) {
        if (s.k == "group") {
            collect_exports(s.items, out)
        } else if ((s.k == "let" or s.k == "func") and s.exported and s.name != null) {
            append(out, s.name)
        }
    }
}

func read_source(path) {
    let f = open(path, "r")
    if (f == null) {
        return null
    }
    let text = read(f)
    close(f)
    return text
}

# Runs a module's statements in its own global scope.
func run_module(m, stmts) {
    let saved_cur = CUR
    let saved_line = CUR_LINE
    let saved_func = FUNC_DEPTH
    CUR = m
    FUNC_DEPTH = 0
    let g = {"@p": null, "@g": true}
    m.globals = g
    if (m.id == 0) {
        for (let s in stmts) {
            if (s.k == "typedef") {
                CUR_LINE = s.line
                let t = define_type(s)
                g[s.name] = [t]
            }
        }
    }
    let st = exec_list(stmts, g)
    leave_scope(g)
    CUR = saved_cur
    CUR_LINE = saved_line
    FUNC_DEPTH = saved_func
}

func ex_use(n, sc) {
    CUR_LINE = n.line
    let canon = path_norm(path_join(path_dir(CUR.canon), n.path))
    let m = MODULES[canon]
    if (m != null and m.state == 1) {
        name_error("Circular import detected: '{n.path}' is already loading", "Modules must not import each other in a cycle; move shared code to a third module")
    }
    if (m == null) {
        let text = read_source(canon)
        if (text == null) {
            name_error("Could not import file '{n.path}'", "Check that the import path exists and ends with .lu")
        }
        MODULE_COUNT += 1
        m = new_module_record(canon, canon, text)
        m.id = MODULE_COUNT
        MODULES[canon] = m
        let saved = CUR
        CUR = m
        let stmts = parse_program(lex(text, 1))
        CUR = saved
        collect_exports(stmts, m.exports)
        m.state = 1
        run_module(m, stmts)
        m.state = 2
    }
    let names = n.names
    if (len(names) == 0) {
        names = m.exports
    }
    let target = global_scope(sc)
    for (let name in names) {
        if (find(m.exports, name) < 0) {
            name_error("Module '{n.path}' does not export '{name}'", "Export names explicitly in the module before using them")
        }
        let b = m.globals[name]
        if (b == null) {
            name_error("Export '{name}' is missing from module '{n.path}'", "Make sure the exported value is defined at module top level")
        }
        target[name] = [b[0]]
    }
    return 0
}

# ---------------------------------------------------------------------------
# Static lint (rule R12): free() may not sit inside conditional control flow in
# an unsafe block. Reported before the program runs, like a parse error.
# ---------------------------------------------------------------------------

let LINT_ERROR = null

func lint_children(x, in_unsafe, in_cond) {
    if (type(x) == "list") {
        for (let y in x) {
            lint(y, in_unsafe, in_cond)
        }
    } else if (type(x) == "map") {
        for (let y in map_values(x)) {
            if (type(y) == "list" or type(y) == "map") {
                lint(y, in_unsafe, in_cond)
            }
        }
    }
}

func lint(x, in_unsafe, in_cond) {
    if (type(x) == "list") {
        lint_children(x, in_unsafe, in_cond)
        return null
    }
    if (type(x) != "map") {
        return null
    }
    let k = x.k
    let inner = in_cond
    if (in_unsafe) {
        inner = true
    }
    if (k == "call" and x.callee.k == "id" and x.callee.name == "free" and in_unsafe and in_cond) {
        if (LINT_ERROR == null) {
            LINT_ERROR = x.line
        }
    } else if (k == "unsafe") {
        lint(x.body, true, in_cond)
    } else if (k == "if") {
        lint(x.cond, in_unsafe, inner)
        lint(x.then, in_unsafe, inner)
        lint(x.els, in_unsafe, inner)
    } else if (k == "while") {
        lint(x.cond, in_unsafe, inner)
        lint(x.body, in_unsafe, inner)
    } else if (k == "for") {
        lint(x.init, in_unsafe, in_cond)
        lint(x.cond, in_unsafe, inner)
        lint(x.incr, in_unsafe, inner)
        lint(x.body, in_unsafe, inner)
    } else if (k == "forin") {
        lint(x.iter, in_unsafe, in_cond)
        lint(x.body, in_unsafe, inner)
    } else if (k == "switch") {
        lint(x.e, in_unsafe, in_cond)
        for (let c in x.cases) {
            lint(c.value, in_unsafe, in_cond)
            lint(c.body, in_unsafe, inner)
        }
        lint(x.dflt, in_unsafe, inner)
    } else {
        lint_children(x, in_unsafe, in_cond)
    }
    return null
}

# ---------------------------------------------------------------------------
# Tables and entry point
# ---------------------------------------------------------------------------

func ex_noop(n, sc) {
    return 0
}

func ex_func_stmt(n, sc) {
    if (n.name == null) {
        return 0
    }
    return ex_func(n, sc)
}

func init_tables() {
    EV["num"] = ev_const
    EV["float"] = ev_const
    EV["str"] = ev_const
    EV["char"] = ev_const
    EV["bool"] = ev_const
    EV["tmpl"] = ev_tmpl
    EV["id"] = ev_id
    EV["list"] = ev_list
    EV["map"] = ev_map
    EV["func"] = ev_func
    EV["bin"] = ev_bin
    EV["not"] = ev_not
    EV["incdec"] = ev_incdec
    EV["input"] = ev_input
    EV["index"] = ev_index
    EV["field"] = ev_field
    EV["box"] = ev_box
    EV["call"] = ev_call

    EX["let"] = ex_let
    EX["group"] = ex_group
    EX["func"] = ex_func_stmt
    EX["assign"] = ex_assign
    EX["setidx"] = ex_setidx
    EX["print"] = ex_print
    EX["return"] = ex_return
    EX["break"] = ex_break
    EX["continue"] = ex_continue
    EX["if"] = ex_if
    EX["while"] = ex_while
    EX["for"] = ex_for
    EX["forin"] = ex_forin
    EX["switch"] = ex_switch
    EX["unsafe"] = ex_unsafe
    EX["use"] = ex_use
    EX["typedef"] = ex_noop

    init_spec()
    init_host()
    init_impl()
    for (let name in map_keys(SPEC)) {
        NATIVES[name] = {"@k": "native", "name": name}
    }
}

func has_zero_arg_main(g) {
    let b = g["main"]
    if (b == null) {
        return false
    }
    let f = b[0]
    return vkind(f) == "fn" and len(f.node.params) == 0 and f.env == g
}

func main() {
    let a = args()
    if (len(a) < 1) {
        err_text("usage: luna luna_in_luna.lu program.lu [arguments...]\n")
        exit(1)
    }
    let path = a[0]
    if (not ends_with(path, ".lu")) {
        err_text("Error: expected a .lu file\n")
        exit(1)
    }
    io_init()
    init_tables()
    SCRIPT_ARGS = slice(a, 1, len(a))
    let text = read_source(path)
    if (text == null) {
        err_text("Could not read file: {path}\n")
        exit(1)
    }
    let m = new_module_record(path, path_norm(path), text)
    MODULES[m.canon] = m
    CUR = m
    let stmts = parse_program(lex(text, 1))
    lint(stmts, false, false)
    if (LINT_ERROR != null) {
        err_text(format_error("Static Error", LINT_ERROR, 0, "free() may not appear inside conditional control flow", "Move free(ptr) out of the branch/loop, or use defer(ptr) instead"))
        err_text("Parsing failed.\n")
        exit(1)
    }
    collect_exports(stmts, m.exports)
    m.state = 1
    run_module(m, stmts)
    m.state = 2
    if (has_zero_arg_main(m.globals)) {
        CUR = m
        call_fn(m.globals["main"][0], [])
    }
}
