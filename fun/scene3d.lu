// Smoke test for Phase 2 script API:
// _pro rotated primitives, transform stack, orbit camera, particles,
// fog, spot cones, material, mouse ray picking.
// Runs ~360 frames then exits cleanly.

let cam = create_camera_3d([0.0, 0.0, 0.0], [0.0, 0.8, 0.0], [0.0, 1.0, 0.0], 60)

init_window(960, 600, "Luna 3D — phase 2 api smoke test")
set_fps(60)

let sun = create_light(LIGHT_DIRECTIONAL, [0.0, 10.0, 0.0], [0.0, -1.0, 0.0], rgb(255, 244, 214))
set_light_intensity(sun, 0.9)

let lamp = create_light(LIGHT_SPOT, [3.0, 3.5, 3.0], [-1.0, -1.0, -1.0], rgb(150, 210, 255))
set_light_intensity(lamp, 3.5)
set_light_cone(lamp, 14.0, 26.0)
set_ambient_light(rgb(40, 40, 55))

let t = 0.0
let frames = 0

while (window_open() && frames < 360) {
    t = t + get_delta_time()
    frames = frames + 1

    update_camera_orbit(cam, [0.0, 1.0, 0.0], 7.0, t * 30.0, 18.0 + sin(t * 0.7) * 8.0)

    begin_drawing()
    clear_background(rgb(16, 16, 24))
    set_fog(rgb(16, 16, 24), 0.02)
    set_material(48.0, 0.45)

    begin_mode_3d(cam)
    draw_grid(12, 1.0)
    draw_plane([0.0, -0.01, 0.0], [24.0, 24.0], rgb(28, 32, 42))

    draw_cube_pro([cos(t * 0.8) * 2.0, 0.5, sin(t * 0.8) * 2.0], [1.0, 1.0, 1.0], [0.0, t * 60.0, t * 25.0], rgb(220, 90, 70), true)
    draw_sphere_pro([-2.2, 1.0 + sin(t * 1.5) * 0.25, -1.5], 0.7, [t * 40.0, 0.0, 0.0], rgb(90, 160, 240), true)
    draw_cylinder_pro([2.4, 0.75, -1.8], 0.35, 0.35, 1.5, [sin(t) * 20.0, 0.0, cos(t) * 20.0], rgb(120, 210, 150), true)
    draw_plane_pro([0.0, 2.2, -3.0], [1.6, 1.6], [90.0, t * 45.0, 0.0], rgb(230, 190, 90), true)

    // transform-stack scene graph: parent spin, child offset
    push_matrix()
    translate_3d([0.0, 2.6, 0.0])
    rotate_3d([0.0, 1.0, 0.0], t * 80.0)
    draw_cube([0.6, 0.0, 0.0], [0.35, 0.35, 0.35], rgb(240, 240, 240))
    push_matrix()
    translate_3d([0.9, 0.0, 0.0])
    rotate_3d([1.0, 0.0, 0.0], t * 130.0)
    draw_cube_pro([0.0, 0.0, 0.0], [0.2, 0.2, 0.2], [45.0, 45.0, 0.0], rgb(255, 200, 60), false)
    pop_matrix()
    pop_matrix()

    // particle billboards (unlit, translucent → deferred pass)
    let i = 0
    while (i < 12) {
        let a = t * 1.2 + i * 0.52
        draw_particle_3d([cos(a) * 3.2, 0.6 + sin(a * 2.0) * 0.5 + i * 0.08, sin(a) * 3.2], 0.22, [140, 220, 255, 160])
        i = i + 1
    }

    // picking: cast from screen center-ish via stored ray each frame
    let ray = get_mouse_ray(cam)
    if (ray_hits_box(ray, [-2.9, 0.3, -2.2, -1.5, 1.7, -0.8])) {
        draw_cube_wires([-2.2, 1.0, -1.5], [1.5, 1.5, 1.5], rgb(120, 255, 120))
    }
    let dist = ray_plane_distance(ray, [0.0, 0.02, 0.0], [0.0, 1.0, 0.0])
    if (dist > 0.0) {
        let hx = ray[0] + ray[3] * dist
        let hz = ray[2] + ray[5] * dist
        draw_particle_3d([hx, 0.06, hz], 0.3, [255, 90, 90, 230])
    }

    end_mode_3d()

    draw_text_default("phase 2: _pro rotations | stack | orbit | fog | spot | picking", 12, 12, rgb(235, 235, 235))
    end_drawing()
}

close_window()
